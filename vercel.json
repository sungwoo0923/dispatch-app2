{
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "functions": {
    "api/fuel.js": {
      "maxDuration": 10,
      "regions": [
        "icn1"
      ]
    },
    "api/upload-page.js": {
      "maxDuration": 10,
      "regions": [
        "icn1"
      ]
    },
    "api/ap-file.js": {
      "maxDuration": 30,
      "regions": [
        "icn1"
      ]
    },
    "api/send-email.js": {
      "maxDuration": 30,
      "regions": [
        "icn1"
      ]
    },
    "api/send24.js": {
      "maxDuration": 30,
      "regions": [
        "icn1"
      ]
    },
    "api/call24-meta.js": {
      "maxDuration": 15,
      "regions": [
        "icn1"
      ]
    },
    "api/call24-diag.js": {
      "maxDuration": 30,
      "regions": [
        "icn1"
      ]
    },
    "api/shell.js": {
      "maxDuration": 15,
      "regions": [
        "icn1"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/manifest-driver.json",
      "dest": "/manifest-driver.json"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/upload",
      "dest": "/api/upload-page"
    },
    {
      "src": "/driver-upload",
      "dest": "/api/upload-page"
    },
    {
      "src": "/",
      "headers": {
        "cache-control": "no-store, must-revalidate"
      },
      "dest": "/api/shell?f=index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/api/shell?asset=$1"
    },
    {
      "src": "/driver-(login|register|home|signup)(.*)",
      "headers": {
        "cache-control": "no-store, must-revalidate"
      },
      "dest": "/api/shell?f=driver"
    },
    {
      "src": "/(.*)",
      "headers": {
        "cache-control": "no-store, must-revalidate"
      },
      "dest": "/api/shell?f=index"
    }
  ]
}
