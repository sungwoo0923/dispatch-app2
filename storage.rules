rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // KP-Planner 영수증 사진 — 로그인한 사용자만 자신의 kp-planner/ 경로에
    // 읽고 쓸 수 있다(배차프로그램 파일 경로와는 분리).
    // ⭐ 2026-11-07 보안 점검 — 올리기는 20MB 미만 이미지·PDF만(예전엔 크기·종류 제한 없이 아무 파일).
    //  ⚠ 경로에 사용자 칸이 없어 로그인한 누구나 서로의 파일을 읽을 수 있다 — KP-Planner 앱이 kp-planner/{uid}/… 로 올리게 바꾼 뒤
    //    "request.auth.uid == 경로의 uid" 로 좁혀야 한다(그 앱 코드가 이 저장소에 없어 지금은 경로를 바꾸지 않음).
    match /kp-planner/{allPaths=**} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // ⭐ 2026-11-06 로지스웹 허브 콜 — 회원 서류 · 프로필 사진 · 인수증 사진
    //  관리자 = 최고관리자 이메일 또는 users/{uid}.role == "totalMaster"(Firestore 규칙 isTotalMasterUser와 같은 기준)
    // 🎫 2026-11-08 로그인 토큰 권한(custom claims, v == 1 — functions/authClaims.js가 서버에서만 넣는다 · firestore.rules ck()와 같다)
    //  토큰이 있으면 Firestore 문서를 읽지 않는다(서비스 간 읽기 비용 절약). 최고관리자는 토큰 + 문서로 한 번 더 확인
    function ck() {
      return request.auth != null && request.auth.token.get('v', 0) == 1;
    }
    function hubAdmin() {
      return request.auth != null && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        ((!ck() || request.auth.token.get('tm', false) == true) && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'totalMaster'));
    }
    function hubFileOk(maxMb) {
      return request.resource != null && request.resource.size < maxMb * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
    // 가입 서류(사업자등록증·자격증·통장사본 등) — 본인과 관리자만. 다른 회원은 볼 수 없다
    match /hub/members/{uid}/{file} {
      allow read: if (request.auth != null && request.auth.uid == uid) || hubAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && hubFileOk(10);
      allow delete: if (request.auth != null && request.auth.uid == uid) || hubAdmin();
    }
    // 프로필 사진 — 로그인 회원이 볼 수 있다(배차된 상대에게 보이는 사진)
    match /hub/photos/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && hubFileOk(5) && request.resource.contentType.matches('image/.*');
      allow delete: if (request.auth != null && request.auth.uid == uid) || hubAdmin();
    }
    // 인수증 사진 — 그 오더의 등록자 · 배차된 회원 · 관리자. 올리기는 배차된 회원만
    match /hub/pod/{orderId}/{file} {
      allow read: if request.auth != null && (hubAdmin() ||
        firestore.get(/databases/(default)/documents/hubOrders/$(orderId)).data.get('posterUid', '') == request.auth.uid ||
        firestore.get(/databases/(default)/documents/hubOrders/$(orderId)).data.get('takerUid', '') == request.auth.uid);
      allow create: if request.auth != null && hubFileOk(10)
        && firestore.get(/databases/(default)/documents/hubOrders/$(orderId)).data.get('takerUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    // ⭐ 2026-11-07 화면 편집 모드 — 바꾼 로고·배너·안내 이미지(src/uiConfig.js uploadImage)
    //  읽기: 누구나(로그인 전 화면에도 보이는 로고) · 올리기·지우기: 최고관리자만 · PNG/JPG/WEBP/GIF 3MB 미만(SVG는 받지 않음)
    match /uiAssets/{file} {
      allow read: if true;
      allow create: if hubAdmin() && request.resource != null && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow update: if false;
      allow delete: if hubAdmin();
    }

    // ⭐ 2026-11-07 직원 근로계약서 등 급여 서류 — payrollDocs/{회사 키}/{직원 uid}/{파일}
    //  급여 담당(firestore.rules payrollStaff와 같은 기준) + 급여 비밀번호 잠금 해제(payrollUnlocks/{uid}, 30분) 동안만
    //  회사 키 = 회사명에서 / 공백 # ? [ ] 를 _로 바꾼 값(src/Payroll.jsx safeId) · PDF·이미지 15MB 미만
    function payUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    // 토큰 기준(문서 기준과 같은 계산 — ap 승인 · st 재직 · r 역할 · pay 부서 재무·경리·회계·총무)
    function payStaffClaims() {
      return ck() && request.auth.token.get('ap', false) == true && request.auth.token.get('st', false) == true
        && (request.auth.token.get('r', '') in ['test', 'acctStaff', 'hrAcct', 'allMgr']
          || (!(request.auth.token.get('r', '') in ['driver', 'shipper', 'cafeUser']) && request.auth.token.get('pay', false) == true));
    }
    function payCoSt() {
      return ck() ? request.auth.token.get('co', '') : payUser().get('companyName', '');
    }
    function payStaffSt() {
      return request.auth != null && (hubAdmin() || payStaffClaims() || (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && payUser().get('approved', true) != false
        && payUser().get('employmentStatus', '') != '퇴사'
        && (payUser().get('role', '') in ['test', 'acctStaff', 'hrAcct', 'allMgr']
          || (!(payUser().get('role', '') in ['driver', 'shipper', 'cafeUser']) && payUser().get('team', '').matches('.*(재무|경리|회계|총무).*')))));
    }
    function payUnlockedSt(coKey) {
      let p = /databases/(default)/documents/payrollUnlocks/$(request.auth.uid);
      return request.auth != null && firestore.exists(p)
        && firestore.get(p).data.get('companyName', '').replace('[/\\s#?\\[\\]]', '_') == coKey
        && firestore.get(p).data.expiresAt > request.time
        && (hubAdmin() || payCoSt().replace('[/\\s#?\\[\\]]', '_') == coKey);
    }
    match /payrollDocs/{coKey}/{uid}/{file} {
      allow read, delete: if payStaffSt() && payUnlockedSt(coKey);
      allow create: if payStaffSt() && payUnlockedSt(coKey) && request.resource != null && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|webp)') || request.resource.contentType == 'application/pdf');
      allow update: if false;
    }

    // 📎 2026-11-08 전자결재 첨부 파일 — approvals/{회사 키}/{문서 id}/{시각_파일명} (src/approvalFiles.js · src/ApprovalFiles.jsx)
    //  회사 키 = 회사명에서 / 공백 # ? [ ] 를 _로 바꾼 값 · Firestore 문서는 users/{나} · approvals/{문서 id} 두 개만 읽는다
    //  · 올리기: 같은 회사 승인된 사무 직원 + customMetadata.uploadedBy == 나
    //            결재 문서가 아직 없으면(상신 전 작성 중) 누구 폴더든 새로 만들 수 있고, 있으면 그 문서의 기안자가 결재 진행 중(pending)일 때만
    //            20MB 미만 · 사진(PNG·JPG·GIF·WEBP·HEIC·BMP, SVG 제외) · PDF · PPT/PPTX · XLS/XLSX · DOC/DOCX · HWP/HWPX · ZIP
    //  · 읽기: 같은 회사 사무 직원 중 — 결재 참여자 · 회사 관리자 · 경리 · 임원(직책·임원 부서) · (승인된 사업계획서는 같은 회사 직원 누구나)
    //          상신 전(문서 없음)에는 올린 사람만
    //  · 지우기: 올린 사람만, 상신 전이거나 첫 결재자가 아직 승인하지 않은 진행 중·회수 문서의 기안자일 때만 · 덮어쓰기 없음
    function apStUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function apStaff(coKey) {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && apStUser().get('approved', true) != false
        && apStUser().get('employmentStatus', '') != '퇴사'
        && !(apStUser().get('role', '') in ['driver', 'shipper', 'cafeUser', 'viewer'])
        && apStUser().get('companyName', '').trim().replace('[/\\s#?\\[\\]]', '_') == coKey; // ⭐ 2026-11-09 회사명 앞뒤 공백이 있어도 같은 회사로
    }
    function apDoc(docId) {
      return /databases/(default)/documents/approvals/$(docId);
    }
    function apFileTypeOk() {
      return request.resource.contentType.matches('image/(png|jpeg|gif|webp|heic|heif|bmp)')
        || request.resource.contentType in ['application/pdf',
          'application/vnd.ms-powerpoint', 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
          'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/x-hwp', 'application/haansofthwp', 'application/vnd.hancom.hwp', 'application/vnd.hancom.hwpx',
          'application/zip', 'application/x-zip-compressed'];
    }
    function apReaderOk(docId) {
      let d = firestore.get(apDoc(docId)).data;
      return request.auth.uid in d.get('participants', [])
        || apStUser().get('role', '') in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'totalMaster', 'test', 'acctStaff']
        || apStUser().get('position', '') in ['이사', '상무', '전무', '부사장', '사장', '대표', '대표이사', '본부장', '임원']
        || apStUser().get('team', '') == '임원'
        || (d.get('form', '') == 'bizplan' && d.get('status', '') == 'approved');
    }
    match /approvals/{coKey}/{docId}/{file} {
      allow read: if hubAdmin() || (apStaff(coKey) && (firestore.exists(apDoc(docId))
        ? apReaderOk(docId)
        : resource.metadata.get('uploadedBy', '') == request.auth.uid));
      allow create: if resource == null && apStaff(coKey) && request.resource != null && request.resource.size < 20 * 1024 * 1024 && apFileTypeOk()
        && request.resource.metadata.get('uploadedBy', '') == request.auth.uid
        && (!firestore.exists(apDoc(docId))
          || (firestore.get(apDoc(docId)).data.get('drafterUid', '') == request.auth.uid
              && firestore.get(apDoc(docId)).data.get('status', '') in ['pending', 'withdrawn', 'rejected'])); // ⭐ 2026-11-09 회수·반려 문서를 고쳐 다시 올릴 때도
      allow update: if false;
      allow delete: if apStaff(coKey) && resource.metadata.get('uploadedBy', '') == request.auth.uid
        && (!firestore.exists(apDoc(docId))
          || (firestore.get(apDoc(docId)).data.get('drafterUid', '') == request.auth.uid
              && firestore.get(apDoc(docId)).data.get('status', '') in ['pending', 'withdrawn']
              && firestore.get(apDoc(docId)).data.line[0].get('status', '') != 'approved'));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
