<?xml version="1.0" encoding="utf-8"?>
<!-- 🟦 2026-11-26 홈 화면 위젯(출근) — KpWidgetProvider 가 글자를 채운다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kp_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kp_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="LogisWeb" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="LOGISWEB 기사"
            android:textColor="#FF8391B4"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/kp_w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="출근 전"
        android:textColor="#FFF3F6FD"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/kp_w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="앱을 열어 로그인해 주세요"
        android:textColor="#FF8391B4"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/kp_w_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/kp_widget_btn"
        android:gravity="center"
        android:text="›  출근하기"
        android:textColor="#FF0E1838"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
