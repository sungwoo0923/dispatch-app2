rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 비로그인 상태(기사)가 업로드 페이지에서 건드릴 수 있는 필드는 이 3개뿐이다.
    // 업로드토큰은 절대 포함하지 않는다 — 그건 로그인한 운송사 앱만 발급할 수 있어야
    // 링크 잠금/재발급 로직이 실제로 의미가 있다.
    function isPublicOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['attachCount', '위치공유중', '업로드잠금']);
    }

    // ────────────────────────────────────────────────────────────
    // 로그인 없이 접근하는 공개 배차/기사 관련 문서
    // (기사에게 문자/카톡으로 전달되는 인수증 업로드 링크, 통합 업로드 검색 링크)
    // ────────────────────────────────────────────────────────────
    match /orders/{id} {
      allow get: if true;
      // ⚠️ /driver-upload(DriverSearchPage)가 로그인 없이 상차일로 목록 조회를 하기 때문에
      // list는 열려 있어야 한다. 이 경로를 서버(Vercel 함수)로 옮기기 전까지는
      // "그 날짜의 전체 오더 목록이 링크 소지자에게 노출될 수 있다"는 제한된 리스크가 남는다.
      allow list: if true;
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }
    match /dispatch/{id} {
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }
    match /dispatch_test/{id} {
      allow get: if true;
      allow list, create, update, delete: if isSignedIn();
    }
    match /fixedClients/{id} {
      allow get: if true;
      allow list: if true; // /driver-upload?source=fixed 검색용
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }

    // 인수증/서류 첨부 — 오더 문서 id만 알면 사진을 올리고 확인·삭제(되돌리기)할 수 있어야 한다.
    // 첨부 문서 id는 추측 불가능한 Firestore 자동 id라 list를 막아도 기능에 지장이 없다.
    match /{col}/{orderId}/attachments/{attId} {
      allow get, create, delete: if true;
      allow list, update: if isSignedIn();
    }

    // 수동 업로드(오더 id 없이 들어온 기사) — 새 메타 문서 생성만 허용, 조회는 로그인 사용자만.
    match /driver_uploads/{id} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }

    // 실시간 위치공유 — 업로드 페이지에서 오더 id로만 쓰고 읽는다. 전체 목록 열람은 로그인 사용자만.
    match /liveLocations/{id} {
      allow get, create, update: if true;
      allow list, delete: if isSignedIn();
    }

    // ────────────────────────────────────────────────────────────
    // 그 외 모든 컬렉션 — 로그인한 사용자만 접근 가능
    // (운송사/화주사/기사 전용 화면은 전부 Firebase Auth 로그인 후에만 진입하므로
    // 기존 기능에는 영향이 없고, 로그인 없는 제3자의 접근만 차단한다)
    // ────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
