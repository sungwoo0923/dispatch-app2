rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ⭐ 보안 1단계 — "가입만 하고 승인 안 된 계정"이 DB 전체를 읽고 쓰는 것을 막는다.
    // 앱(App.jsx)과 같은 기준: users/{uid} 문서가 있고, approved가 false가 아니며(예전 계정처럼
    // 값이 없으면 승인으로 봄), 퇴사 처리되지 않은 계정. 최고관리자 이메일은 항상 허용.
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         myUser().get('approved', true) != false &&
         myUser().get('employmentStatus', '') != '퇴사' &&
         // 배차마당(cafe-site) 가입 계정은 가입과 동시에 approved:true로 저장되므로
         // 배차 프로그램 데이터에는 접근할 수 없게 따로 제외한다(배차마당 컬렉션만 사용).
         myUser().get('role', '') != 'cafeUser')
      );
    }
    // DriverLogin/DriverRegister의 차량번호 정규화와 동일(공백 제거 + 대문자)
    function plateId(carNo) {
      return carNo.trim().replace('\\s+', '').upper();
    }
    // 기사앱 로그인 — PC 기사관리에서 미리 등록한 차량(drivers/{차량번호})과 이름·회사명이 같으면
    // 승인 없이 approved:true로 가입시키는 기존 흐름을 서버에서도 똑같이 확인한다.
    function preRegisteredDriverOk(data) {
      return data.get('role', '') == 'driver' &&
        data.get('carNo', '') is string && data.get('carNo', '') != '' &&
        exists(/databases/$(database)/documents/drivers/$(plateId(data.carNo))) &&
        get(/databases/$(database)/documents/drivers/$(plateId(data.carNo))).data.get('이름',
          get(/databases/$(database)/documents/drivers/$(plateId(data.carNo))).data.get('name', '')).trim() == data.get('name', '').trim() &&
        get(/databases/$(database)/documents/drivers/$(plateId(data.carNo))).data.get('companyName', '').trim() == data.get('companyName', '').trim();
    }
    // 본인 users 문서 쓰기 — 승인 여부/권한(role)을 스스로 올리는 것만 막는다.
    function selfUserWriteOk(userId) {
      return request.auth.uid == userId && (
        request.resource.data.get('approved', false) == false ||
        request.resource.data.get('role', '') == 'cafeUser' ||
        preRegisteredDriverOk(request.resource.data) ||
        (resource != null &&
         request.resource.data.get('approved', null) == resource.data.get('approved', null) &&
         request.resource.data.get('role', null) == resource.data.get('role', null))
      );
    }

    // ⭐ 프로그램 전역 설정(랜딩페이지 편집, 알림 문구 설정 등)은 최고관리자만
    // 읽고 쓸 수 있어야 한다 — AdminMenu.jsx의 isTotalMaster 판정 로직과 동일하게
    // (1) 고정된 총마스터 이메일이거나 (2) 본인 users 문서의 role이 "totalMaster"인
    // 경우만 인정한다. 클라이언트 쪽 isTotalMaster는 신뢰할 수 없으니(누구나 조작
    // 가능) 서버(규칙)에서 독립적으로 다시 검증한다.
    function isTotalMasterUser() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "totalMaster"
      );
    }

    // 비로그인 상태(기사)가 업로드 페이지에서 건드릴 수 있는 필드는 이 3개뿐이다.
    // 업로드토큰은 절대 포함하지 않는다 — 그건 로그인한 운송사 앱만 발급할 수 있어야
    // 링크 잠금/재발급 로직이 실제로 의미가 있다.
    function isPublicOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['attachCount', '위치공유중', '업로드잠금']);
    }

    // ────────────────────────────────────────────────────────────
    // 로그인 없이 접근하는 공개 배차/기사 관련 문서
    // (기사에게 문자/카톡으로 전달되는 인수증 업로드 링크, 통합 업로드 검색 링크)
    // ────────────────────────────────────────────────────────────
    match /orders/{id} {
      allow get: if true;
      // ⚠️ /driver-upload(DriverSearchPage)가 로그인 없이 상차일로 목록 조회를 하기 때문에
      // list는 열려 있어야 한다. 이 경로를 서버(Vercel 함수)로 옮기기 전까지는
      // "그 날짜의 전체 오더 목록이 링크 소지자에게 노출될 수 있다"는 제한된 리스크가 남는다.
      allow list: if true;
      allow update: if isApproved() || isPublicOrderUpdate();
      allow create, delete: if isApproved();
    }
    match /dispatch/{id} {
      allow get: if true;
      allow list: if true;
      allow update: if isApproved() || isPublicOrderUpdate();
      allow create, delete: if isApproved();
    }
    match /dispatch_test/{id} {
      allow get: if true;
      allow list, create, update, delete: if isApproved();
    }
    match /fixedClients/{id} {
      allow get: if true;
      allow list: if true; // /driver-upload?source=fixed 검색용
      allow update: if isApproved() || isPublicOrderUpdate();
      allow create, delete: if isApproved();
    }

    // 기사전달용 업로드 링크 단축 — /u/{code}가 로그인 없이 code로 원본
    // (오더id+토큰)을 조회해 /upload로 넘겨줘야 한다. list는 막아서 전체
    // 코드 목록이 노출되지 않게 하고, 발급(create/update)은 로그인한
    // 운송사 앱에서만 가능하게 한다.
    match /shortLinks/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isApproved();
      allow delete: if isApproved();
    }

    // 인수증/서류 첨부 — 오더 문서 id만 알면 사진을 올리고 확인·삭제(되돌리기)할 수 있어야 한다.
    // 첨부 문서 id는 추측 불가능한 Firestore 자동 id라 list를 막아도 기능에 지장이 없다.
    match /{col}/{orderId}/attachments/{attId} {
      allow get, create, delete: if true;
      allow list, update: if isApproved();
    }

    // 수동 업로드(오더 id 없이 들어온 기사) — 새 메타 문서 생성만 허용, 조회는 로그인 사용자만.
    match /driver_uploads/{id} {
      allow create: if true;
      allow get, list, update, delete: if isApproved();
    }

    // 홈페이지(랜딩페이지) 도입 문의 — 로그인 없는 방문자가 폼으로 제출만 할 수 있고,
    // 목록 조회/상태 변경은 관리자메뉴(로그인 사용자)만 가능하다.
    match /landingInquiries/{id} {
      allow create: if true;
      allow get, list, update, delete: if isApproved();
    }

    // 실시간 위치공유 — 업로드 페이지에서 오더 id로만 쓰고 읽는다. 전체 목록 열람은 로그인 사용자만.
    match /liveLocations/{id} {
      allow get, create, update: if true;
      allow list, delete: if isApproved();
    }

    // ────────────────────────────────────────────────────────────
    // 배차마당(카페형 오더 공유 사이트) — 게시글 본문은 로그인 사용자 전체 공개,
    // 연락처(전화번호)는 별도 서브문서에 두고 "배차완료" 상태에서 당사자(등록자/신청자)만
    // 읽을 수 있게 제한한다.
    // ────────────────────────────────────────────────────────────
    match /cafeOrders/{orderId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      match /contact/{docId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.status == "confirmed" &&
          (request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.posterUid ||
           request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.applicantUid);
        allow write: if isSignedIn();
      }
    }

    // ────────────────────────────────────────────────────────────
    // 프로그램 전역 설정 — 최고관리자만 설정/열람 가능(요청사항).
    // 단 siteConfig/landing(로그인 전 랜딩페이지 커스터마이징)은 그 페이지 자체가
    // 로그인 없이 열리므로 읽기만은 누구나 가능해야 한다 — 그래야 방문자 화면에
    // 실제로 반영된다. 쓰기는 여기도 최고관리자만.
    // ────────────────────────────────────────────────────────────
    match /siteConfig/landing {
      allow get: if true;
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    // siteConfig/labels(프로그램 전체 편집모드의 글자 오버라이드)는 전체 사용자
    // 화면에 반영돼야 하니 읽기는 로그인한 사용자 전체 허용, 쓰기(=편집)만
    // 최고관리자로 제한한다 — landing과 같은 이유의 예외.
    match /siteConfig/labels {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    match /siteConfig/{docId} {
      allow get, list: if isTotalMasterUser();
      allow write: if isTotalMasterUser();
    }

    // ────────────────────────────────────────────────────────────
    // 가입 진행 중(승인 전) 계정에 필요한 최소 권한 — 승인된 계정은 기존과 동일
    // ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isApproved() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isApproved();
      allow create, update: if isSignedIn() && (
        (isApproved() && request.auth.uid != userId) ||
        isTotalMasterUser() ||
        selfUserWriteOk(userId)
      );
      allow delete: if isApproved();
    }
    match /userProfiles/{userId} {
      allow read, write: if isApproved() || (isSignedIn() && request.auth.uid == userId);
    }
    match /drivers/{driverId} {
      // 기사앱 가입/로그인 때 차량번호 문서(PC 선등록) 확인용 단건 조회
      allow get: if isSignedIn();
      allow list: if isApproved();
      allow create, update: if isApproved() || (isSignedIn() && request.auth.uid == driverId);
      // 가입 후 선등록 문서(drivers/{차량번호}) 정리 — 승인 전에는 본인 차량번호 문서만
      allow delete: if isApproved() || (isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myUser().get('carNo', '') is string && myUser().get('carNo', '') != '' &&
        plateId(myUser().carNo) == driverId);
    }
    match /transportApplications/{id} {
      allow create: if isSignedIn();
      allow get, list, delete: if isApproved();
      allow update: if isApproved() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address']));
    }
    match /companyApplications/{id} {
      allow create: if isSignedIn();
      allow get, list: if isApproved() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isApproved();
      allow update: if isApproved() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address']));
    }
    // ⭐ 로그인 관리 — 기기별 로그인 기록. 본인 기록은 승인 전 계정(화주 승인대기 등)도 읽고 쓸 수 있어야
    // 중복 로그인 확인·연결 끊기가 된다. 관리자는 전체(강제 로그아웃).
    match /loginSessions/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isApproved());
      // ⭐ 최고관리자의 로그인은 본인 또는 최고관리자만 끊을 수 있다(관리자도 불가)
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isTotalMasterUser() ||
        (isApproved() && resource.data.get('role', '') != 'totalMaster' && resource.data.get('email', '') != 'tjddnqkf@naver.com')
      );
      allow delete: if isTotalMasterUser();
    }
    // 운송사 초기화 비밀번호(해시) — 서버(Cloud Functions)만 읽고 쓴다
    match /adminSecrets/{id} {
      allow read, write: if false;
    }
    // 초기화 보관함(7일) — 서버만 읽고 쓴다(화면은 서버 함수를 통해 목록·복원)
    match /resetBackups/{document=**} {
      allow read, write: if false;
    }
    // 초기화·복원 진행률 — 최고관리자 화면이 실시간으로 읽는다(쓰기는 서버만)
    match /resetJobs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    match /resetLogs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 📧 사내메일함 — 보낸 사람·받는 사람만 읽고, 받은 사람은 읽음/삭제 표시만 고칠 수 있다.
    match /internalMails/{id} {
      allow read: if isApproved() && (request.auth.uid in resource.data.get('to', []) || resource.data.get('fromUid', '') == request.auth.uid);
      allow create: if isApproved() && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('to', []) is list && request.resource.data.get('to', []).size() <= 500;
      allow update: if isApproved() && request.auth.uid in resource.data.get('to', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy']);
      allow delete: if false;
    }
    match /sessionLogs/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isApproved();
    }

    // ────────────────────────────────────────────────────────────
    // 그 외 모든 컬렉션 — 승인된 계정만 접근 가능
    // (운송사/화주사/기사 전용 화면은 전부 Firebase Auth 로그인 후에만 진입하므로
    // 기존 기능에는 영향이 없고, 로그인 없는 제3자의 접근만 차단한다)
    // ────────────────────────────────────────────────────────────
    // ⭐ 규칙은 "하나라도 허용하면 허용"이라, 서버 전용 컬렉션(초기화 비밀번호·보관함·기록)은
    // 여기서 빼야 위의 "allow … if false"가 실제로 막힌다.
    match /{col}/{rest=**} {
      allow read, write: if isApproved() && !(col in ['adminSecrets', 'resetBackups', 'resetLogs', 'resetJobs', 'loginSessions', 'orderTrash', 'recurringRuns', 'internalMails']);
    }
  }
}
