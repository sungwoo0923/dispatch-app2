rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 비로그인 상태(기사)가 업로드 페이지에서 건드릴 수 있는 필드는 이 3개뿐이다.
    // 업로드토큰은 절대 포함하지 않는다 — 그건 로그인한 운송사 앱만 발급할 수 있어야
    // 링크 잠금/재발급 로직이 실제로 의미가 있다.
    function isPublicOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['attachCount', '위치공유중', '업로드잠금']);
    }

    // ────────────────────────────────────────────────────────────
    // 로그인 없이 접근하는 공개 배차/기사 관련 문서
    // (기사에게 문자/카톡으로 전달되는 인수증 업로드 링크, 통합 업로드 검색 링크)
    // ────────────────────────────────────────────────────────────
    match /orders/{id} {
      allow get: if true;
      // ⚠️ /driver-upload(DriverSearchPage)가 로그인 없이 상차일로 목록 조회를 하기 때문에
      // list는 열려 있어야 한다. 이 경로를 서버(Vercel 함수)로 옮기기 전까지는
      // "그 날짜의 전체 오더 목록이 링크 소지자에게 노출될 수 있다"는 제한된 리스크가 남는다.
      allow list: if true;
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }
    match /dispatch/{id} {
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }
    match /dispatch_test/{id} {
      allow get: if true;
      allow list, create, update, delete: if isSignedIn();
    }
    match /fixedClients/{id} {
      allow get: if true;
      allow list: if true; // /driver-upload?source=fixed 검색용
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }

    // 기사전달용 업로드 링크 단축 — /u/{code}가 로그인 없이 code로 원본
    // (오더id+토큰)을 조회해 /upload로 넘겨줘야 한다. list는 막아서 전체
    // 코드 목록이 노출되지 않게 하고, 발급(create/update)은 로그인한
    // 운송사 앱에서만 가능하게 한다.
    match /shortLinks/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 인수증/서류 첨부 — 오더 문서 id만 알면 사진을 올리고 확인·삭제(되돌리기)할 수 있어야 한다.
    // 첨부 문서 id는 추측 불가능한 Firestore 자동 id라 list를 막아도 기능에 지장이 없다.
    match /{col}/{orderId}/attachments/{attId} {
      allow get, create, delete: if true;
      allow list, update: if isSignedIn();
    }

    // 수동 업로드(오더 id 없이 들어온 기사) — 새 메타 문서 생성만 허용, 조회는 로그인 사용자만.
    match /driver_uploads/{id} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }

    // 홈페이지(랜딩페이지) 도입 문의 — 로그인 없는 방문자가 폼으로 제출만 할 수 있고,
    // 목록 조회/상태 변경은 관리자메뉴(로그인 사용자)만 가능하다.
    match /landingInquiries/{id} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }

    // 실시간 위치공유 — 업로드 페이지에서 오더 id로만 쓰고 읽는다. 전체 목록 열람은 로그인 사용자만.
    match /liveLocations/{id} {
      allow get, create, update: if true;
      allow list, delete: if isSignedIn();
    }

    // ────────────────────────────────────────────────────────────
    // 배차마당(카페형 오더 공유 사이트) — 게시글 본문은 로그인 사용자 전체 공개,
    // 연락처(전화번호)는 별도 서브문서에 두고 "배차완료" 상태에서 당사자(등록자/신청자)만
    // 읽을 수 있게 제한한다.
    // ────────────────────────────────────────────────────────────
    match /cafeOrders/{orderId} {
      function isPoster() { return request.auth.uid == resource.data.posterUid; }
      function isCurrentApplicant() { return resource.data.applicantUid != null && request.auth.uid == resource.data.applicantUid; }
      // 배차신청: open -> applying, 신청자 본인 정보만 채워 넣는 전환.
      function isApplyTransition() {
        return resource.data.status == "open" && request.resource.data.status == "applying" &&
          request.resource.data.applicantUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status','applicantUid','applicantName','applicantNickname','applicantPhone','applicantVehicleNumber','applyRequestedAt','posterUnread','updatedAt']);
      }
      // 10초 이내 신청취소: applying -> open, 신청자 본인만.
      function isCancelApplyTransition() {
        return resource.data.status == "applying" && request.resource.data.status == "open" &&
          request.auth.uid == resource.data.applicantUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status','applicantUid','applicantName','applicantNickname','applicantPhone','applicantVehicleNumber','applyRequestedAt','updatedAt']);
      }
      // 10초 경과 자동확정: applying -> confirmed. 신청 당사자가 탭을 닫아버린 경우까지
      // 대비해, 이 오더를 보고 있는 아무 로그인 사용자나(당사자가 아니어도) 지나가면서
      // 확정을 시도할 수 있게 열어둔다 — cafeApi.js의 기존 설계와 동일.
      function isFinalizeTransition() {
        return resource.data.status == "applying" && request.resource.data.status == "confirmed" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','confirmedAt','updatedAt']);
      }
      // 배차취소(배정 해제): confirmed -> open, 게시자만.
      function isAssignmentCancelTransition() {
        return resource.data.status == "confirmed" && request.resource.data.status == "open" && isPoster() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status','applicantUid','applicantName','applicantNickname','applicantPhone','applicantVehicleNumber','applyRequestedAt','confirmedAt','updatedAt']);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.posterUid == request.auth.uid;
      allow delete: if isSignedIn() && isPoster();
      allow update: if isSignedIn() && (
        isPoster() || isApplyTransition() || isCancelApplyTransition() || isFinalizeTransition() || isAssignmentCancelTransition()
      );

      match /contact/{docId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.status == "confirmed" &&
          (request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.posterUid ||
           request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.applicantUid);
        allow write: if isSignedIn();
      }

      // 1:1 대화 — 게시자/신청자 당사자만 읽고 쓸 수 있다. 3개월 지난 메시지 실제 삭제는
      // functions/cafeCleanup.js의 예약 작업(Admin SDK, 규칙 영향 없음)이 처리한다.
      match /chat/{msgId} {
        allow read, create: if isSignedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.posterUid ||
           request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.applicantUid);
        allow update, delete: if false;
      }

      // 정산(인수증/명세서 업로드 기록, 정산완료 처리) — 당사자만.
      match /settlement/{docId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.posterUid ||
           request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.applicantUid);
      }
    }

    // 알림 — 본인 알림만 읽고, 본인 것만 읽음처리(update) 가능. 생성은 신청/취소 등
    // 이벤트를 발생시킨 로그인 사용자 누구나(상대방에게 알림을 남겨야 하므로) 가능하다.
    match /cafeNotifications/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // 사업자등록번호 → 회사명 조회용 공개 디렉터리 — 가입폼(로그인 전)에서도 조회할 수
    // 있어야 하므로 단건 조회(get)만 공개하고, 목록 열람(list)과 쓰기는 막는다(가입 시
    // 로그인된 계정으로만 생성/갱신).
    match /bizDirectory/{bizNo} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn();
    }

    // ────────────────────────────────────────────────────────────
    // 그 외 모든 컬렉션 — 로그인한 사용자만 접근 가능
    // (운송사/화주사/기사 전용 화면은 전부 Firebase Auth 로그인 후에만 진입하므로
    // 기존 기능에는 영향이 없고, 로그인 없는 제3자의 접근만 차단한다)
    // ────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
