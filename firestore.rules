rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ⭐ 보안 1단계 — "가입만 하고 승인 안 된 계정"이 DB 전체를 읽고 쓰는 것을 막는다.
    // 앱(App.jsx)과 같은 기준: users/{uid} 문서가 있고, approved가 false가 아니며(예전 계정처럼
    // 값이 없으면 승인으로 봄), 퇴사 처리되지 않은 계정. 최고관리자 이메일은 항상 허용.
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // 🎫 2026-11-08 로그인 토큰 권한(custom claims) — functions/authClaims.js(서버)만 넣는다 · 사용자·화면은 못 바꾼다
    //  토큰에 v == 1 이 있으면 users 문서를 읽지 않고 토큰 값으로 판단한다(요청마다 문서 읽기 1~3회 · 규칙 계산량 절약).
    //  없으면(배포 직후 · 채우기 전 · 특이한 문서) 예전처럼 문서를 읽는다 → 규칙을 먼저 배포해도 아무도 잠기지 않는다.
    //  · 최고관리자 권한(tm)은 토큰 + 문서로 한 번 더 확인(권한을 뺀 뒤 예전 토큰이 남아 있어도 열리지 않게)
    //  · 토큰이 "미승인"이면 문서를 다시 본다(관리자가 승인하면 바로 열림 — 미승인 계정은 적어 비용이 거의 없다)
    //  · 그 밖의 값(회사·역할·부서 등)은 바뀌면 화면이 바로 토큰을 새로 받는다(users/{uid}.claimsAt) — 최대 1시간(토큰 수명) 예전 값이 남을 수 있다
    function ck() {
      return request.auth != null && request.auth.token.get('v', 0) == 1;
    }
    function tk(k, d) {
      return request.auth.token.get(k, d);
    }
    function myRole() {
      return ck() ? tk('r', '') : myUser().get('role', '');
    }
    // 회사명 그대로(없으면 '') — myCo()는 없으면 기본 회사 '돌캐'(토큰은 회사명이 있는 문서에만 생긴다)
    function myCoRaw() {
      return ck() ? tk('co', '') : myUser().get('companyName', '');
    }
    function myIsMaster() {
      return ck() ? tk('ms', false) == true : myUser().get('isMaster', false) == true;
    }
    function myLinkedCo() {
      return ck() ? tk('sh', '') : linkedCoOf(myUser());
    }
    // 부서·직책 — 규칙의 이름 조건을 서버가 미리 계산해 둔 값
    function myTeamFin() {
      return ck() ? tk('fin', false) == true : string(myUser().get('team', '')).matches('.*(경리|회계|재무).*');
    }
    function myTeamPay() {
      return ck() ? tk('pay', false) == true : myUser().get('team', '').matches('.*(재무|경리|회계|총무).*');
    }
    function myTeamHr() {
      return ck() ? tk('hr', false) == true : string(myUser().get('team', '')).matches('.*인사.*');
    }
    function myTeamExec() {
      return ck() ? tk('tx', false) == true : myUser().get('team', '') == '임원';
    }
    function myPosExec() {
      return ck() ? tk('xp', false) == true : myUser().get('position', '') in ['이사', '상무', '전무', '부사장', '사장', '대표', '대표이사', '본부장', '임원'];
    }
    function myPosCeo() {
      return ck() ? tk('ceo', false) == true : myUser().get('position', '') in ['대표', '대표이사', '사장'];
    }
    // 토큰 기준 승인(isApproved의 문서 기준과 같은 계산 — 계약종료 ce는 서버가 companyPlans를 보고 넣는다)
    function claimApproved() {
      return ck() && tk('ap', false) == true && tk('st', false) == true && tk('r', '') != 'cafeUser'
        && (tk('r', '') == 'totalMaster' || tk('ce', false) != true);
    }
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        claimApproved() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         myUser().get('approved', true) != false &&
         myUser().get('employmentStatus', '') != '퇴사' &&
         // 배차마당(cafe-site) 가입 계정은 가입과 동시에 approved:true로 저장되므로
         // 배차 프로그램 데이터에는 접근할 수 없게 따로 제외한다(배차마당 컬렉션만 사용).
         myUser().get('role', '') != 'cafeUser' &&
         // ⭐ 2026-11-06 계약종료 — companyPlans/{회사}.status == "ended"인 운송사 사람(직원·기사, 화주는 연동 운송사)은
         //  데이터가 남아 있어도 아무것도 못 읽고 쓴다. 최고관리자·부관리자(role totalMaster)만 예외.
         //  문서 1개(get/exists 같은 문서 = 읽기 1회)만 더 본다.
         (myUser().get('role', '') == 'totalMaster' || !contractEnded(myUser())))
      );
    }
    function contractCoOf(u) {
      return u.get('role', '') == 'shipper'
        ? (u.get('linkedTransportCompany', null) is map ? u.linkedTransportCompany.get('companyName', '') : '')
        : u.get('companyName', '돌캐');
    }
    function contractEnded(u) {
      let co = contractCoOf(u);
      return co is string && co != '' &&
        exists(/databases/$(database)/documents/companyPlans/$(co)) &&
        get(/databases/$(database)/documents/companyPlans/$(co)).data.get('status', '') == 'ended';
    }
    // DriverLogin/DriverRegister의 차량번호 정규화와 동일(공백 제거 + 대문자)
    function plateId(carNo) {
      return carNo.trim().replace('\\s+', '').upper();
    }
    // 기사앱 로그인 — PC 기사관리에서 미리 등록한 차량(drivers/{차량번호})과 이름·회사명이 같으면
    // 승인 없이 approved:true로 가입시키는 기존 흐름을 서버에서도 똑같이 확인한다.
    // ⭐ 2026-11-02 점검 — 기본 회사가 아닌 운송사는 PC 선등록 문서 이름이 "회사__차량번호"(coDocKey)라
    //  예전 이름(차량번호)만 보던 확인이 실패해 기사 첫 로그인이 막히던 문제 — 두 이름 모두 확인
    function preKeyDoc(data) {
      return /databases/$(database)/documents/drivers/$(data.get('companyName', '').trim() + '__' + plateId(data.carNo));
    }
    function preDocMatches(p, data) {
      return exists(p) &&
        get(p).data.get('이름', get(p).data.get('name', '')).trim() == data.get('name', '').trim() &&
        get(p).data.get('companyName', '').trim() == data.get('companyName', '').trim();
    }
    function preRegisteredDriverOk(data) {
      return data.get('role', '') == 'driver' &&
        data.get('carNo', '') is string && data.get('carNo', '') != '' &&
        (preDocMatches(preKeyDoc(data), data) ||
         preDocMatches(/databases/$(database)/documents/drivers/$(plateId(data.carNo)), data));
    }
    // 본인 users 문서 쓰기 — 승인 여부/권한(role)을 스스로 올리는 것만 막는다.
    function selfUserWriteOk(userId) {
      return request.auth.uid == userId && (
        request.resource.data.get('approved', false) == false ||
        request.resource.data.get('role', '') == 'cafeUser' ||
        preRegisteredDriverOk(request.resource.data) ||
        (resource != null &&
         request.resource.data.get('approved', null) == resource.data.get('approved', null) &&
         request.resource.data.get('role', null) == resource.data.get('role', null))
      );
    }

    // ⭐ 프로그램 전역 설정(랜딩페이지 편집, 알림 문구 설정 등)은 최고관리자만
    // 읽고 쓸 수 있어야 한다 — AdminMenu.jsx의 isTotalMaster 판정 로직과 동일하게
    // (1) 고정된 총마스터 이메일이거나 (2) 본인 users 문서의 role이 "totalMaster"인
    // 경우만 인정한다. 클라이언트 쪽 isTotalMaster는 신뢰할 수 없으니(누구나 조작
    // 가능) 서버(규칙)에서 독립적으로 다시 검증한다.
    function isTotalMasterUser() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        // 🎫 토큰이 "최고관리자 아님"이면 문서를 읽지 않고 거절, "최고관리자"면 문서로 한 번 더 확인
        ((!ck() || tk('tm', false) == true) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "totalMaster")
      );
    }

    // ────────────────────────────────────────────────────────────
    // 🏢 운송사(회사)별 데이터 잠금 — 2026-10-30
    // 회사 데이터는 문서의 companyName이 내 계정의 회사와 같을 때만 읽고 쓴다(최고관리자는 전체).
    // 앱은 조회할 때 "companyName == 우리 회사" 조건을 붙여서 보낸다(규칙은 조회 조건을 보고 판단).
    // ────────────────────────────────────────────────────────────
    function myCo() {
      return ck() ? tk('co', '') : myUser().get('companyName', '돌캐');
    }
    // 잠금 스위치 — 관리센터 › 운송사 분리에서 "예전 데이터 정리 → 서버 분리 켜기"를 한 뒤에만 회사 검사를 한다.
    // (켜기 전에는 예전 규칙과 똑같이 동작하므로, 이 규칙을 먼저 배포해도 기존 화면이 깨지지 않는다)
    function locked() {
      return exists(/databases/$(database)/documents/systemConfig/tenancy) &&
        get(/databases/$(database)/documents/systemConfig/tenancy).data.get('serverFilter', false) == true;
    }
    function isShipperUser() {
      return myRole() == 'shipper';
    }
    // 같은 운송사 직원·기사
    function coMatch(d) {
      return isTotalMasterUser() || (isApproved() && (!locked() || (!isShipperUser() && d.companyName == myCo())));
    }
    // 새 문서는 반드시 우리 회사 이름으로
    function coCreate() {
      return isTotalMasterUser() || (isApproved() && (!locked() || (!isShipperUser() && request.resource.data.get('companyName', '') == myCo())));
    }
    // 수정해도 회사는 못 바꾼다
    function coKeep() {
      return isTotalMasterUser() || !locked() || request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
    }
    // 화주사 — 자기 회사가 등록/전송받은 오더만
    function shipperOwns(d) {
      return isApproved() && isShipperUser() && (d.get('shipperCompany', '') == myCo() || d.get('shipperUid', '') == request.auth.uid);
    }
    function shipperCreate() {
      return isApproved() && isShipperUser() && request.resource.data.get('shipperUid', '') == request.auth.uid;
    }

    // (예전 isPublicOrderUpdate — 로그인 없는 업로드 페이지의 오더 칸 수정 — 은 2026-11-08 서버 함수 uploadAccess로 옮겨 없앴다)

    // ────────────────────────────────────────────────────────────
    // 로그인 없이 접근하는 공개 배차/기사 관련 문서
    // (기사에게 문자/카톡으로 전달되는 인수증 업로드 링크, 통합 업로드 검색 링크)
    // ────────────────────────────────────────────────────────────
    // 🔒 오더 — 읽기(한 건·목록)는 같은 운송사(또는 그 오더의 화주사)만.
    //  ⭐ 2026-11-08 보안 — 예전엔 업로드 링크(로그인 없음)를 위해 한 건 조회(get)와 일부 칸 수정(isPublicOrderUpdate)을
    //   "오더 id만 알면 누구나"로 열어 두었다. 이제 업로드 페이지는 서버 함수(uploadAccess)가 링크 토큰을 확인한 뒤 대신 읽고 쓴다.
    //   목록의 "!locked()(잠금 전 누구나 — 로그인 안 한 사람 포함)"도 뺐다(잠금 전에도 승인된 계정만 — coMatch가 잠금 전엔 승인된 누구나).
    //   기사 통합 업로드 검색은 서버 함수(driverSearch).
    match /orders/{id} {
      allow get, list: if coMatch(resource.data) || shipperOwns(resource.data);
      allow create: if coCreate() || shipperCreate();
      allow update: if (coMatch(resource.data) && coKeep()) || shipperOwns(resource.data);
      allow delete: if coMatch(resource.data) || shipperOwns(resource.data);
    }
    match /dispatch/{id} {
      allow get, list: if coMatch(resource.data) || shipperOwns(resource.data);
      allow create: if coCreate() || shipperCreate();
      allow update: if (coMatch(resource.data) && coKeep()) || shipperOwns(resource.data);
      allow delete: if coMatch(resource.data) || shipperOwns(resource.data);
    }
    match /dispatch_test/{id} {
      allow read, delete: if coMatch(resource.data);
      allow create: if coCreate();
      allow update: if coMatch(resource.data) && coKeep();
    }
    // 🏗 2026-11-09 지게차 기사(계좌 포함) · 거래처+상차지별 지게차 기본값 — 같은 회사 사무 직원만(기사·화주 제외)
    match /forkliftDrivers/{id} {
      allow get, list: if coMatch(resource.data) && !(myRole() in ['driver', 'shipper', 'cafeUser']);
      allow update: if coMatch(resource.data) && coKeep() && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer']);
      allow create: if coCreate() && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer']);
      allow delete: if coMatch(resource.data) && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer']);
    }
    match /forkliftPresets/{id} {
      allow get: if resource == null && isApproved() && !(myRole() in ['driver', 'shipper', 'cafeUser']);
      allow get, list: if coMatch(resource.data) && !(myRole() in ['driver', 'shipper', 'cafeUser']);
      allow update: if coMatch(resource.data) && coKeep() && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer']);
      allow create: if coCreate() && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer']);
      allow delete: if coMatch(resource.data) && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer']);
    }
    match /fixedClients/{id} {
      allow get, list: if coMatch(resource.data);
      allow update: if coMatch(resource.data) && coKeep();
      allow create: if coCreate();
      allow delete: if coMatch(resource.data);
    }
    // 🧾 기사에게 보내는 서류 — 지급명세서(driverStatements) · 과태료·사고 서류(fleetPenalties)
    //  직원(기사·화주 제외)은 같은 회사 전체, 기사는 본인 것만 읽고 "확인" 표시만 바꿀 수 있다.
    function isOfficeStaff() {
      return isTotalMasterUser() || (isApproved() && !(myRole() in ['driver', 'shipper']));
    }
    match /{dcol}/{id} {
      allow read: if dcol in ['driverStatements', 'fleetPenalties'] && (
        (isOfficeStaff() && coMatch(resource.data)) || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid));
      allow create: if dcol in ['driverStatements', 'fleetPenalties'] && isOfficeStaff() && coCreate();
      allow update: if dcol in ['driverStatements', 'fleetPenalties'] && (
        (isOfficeStaff() && coMatch(resource.data) && coKeep()) ||
        (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'confirmedAt', 'status', 'driverMemo', 'paidAt', 'objectedAt', 'driverAction'])));
      allow delete: if dcol in ['driverStatements', 'fleetPenalties'] && isOfficeStaff() && coMatch(resource.data);
    }
    // 🧾 2026-11-10 차량 비용 영수증(vehicleExpenses) — 기사는 본인 영수증만 올리고(내 회사 이름 · 상태 접수) 읽는다.
    //  기사가 고칠 수 있는 건 "반려 → 다시 찍어 올리기"(사진 · 상태 접수)와 지출결의로 넘어가기 전(접수 · 확인 · 반려) 영수증 지우기뿐. 직원은 같은 회사 전체.
    match /vehicleExpenses/{id} {
      allow create: if isSignedIn() && request.resource.data.get('driverId', '') == request.auth.uid
        && request.resource.data.get('companyName', '') == myCo() && request.resource.data.get('status', '') == '접수';
      allow read: if (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid) || (isOfficeStaff() && coMatch(resource.data));
      allow update: if (isOfficeStaff() && coMatch(resource.data) && coKeep())
        || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid && resource.data.get('status', '') == '반려'
          && request.resource.data.get('status', '') == '접수'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['image', 'imgHash', 'takenAt', 'captured', 'status', 'rejectReason', 'updatedAt']));
      allow delete: if (isOfficeStaff() && coMatch(resource.data))
        || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid && resource.data.get('status', '') in ['접수', '확인', '반려']
          && resource.data.get('approvalId', '') == '');
    }
    // 📷 정기 차량 사진 — 설정(vehiclePhotoSettings/{회사})은 같은 회사 누구나 읽고 사무 직원만 바꾼다.
    //  사진(vehiclePhotos/{uid_기간_부위})은 기사가 본인 것만 올리고 다시 찍기(덮어쓰기)할 수 있다. 직원은 같은 회사 전체.
    match /vehiclePhotoSettings/{co} {
      allow read: if isTotalMasterUser() || (isSignedIn() && myCo() == co);
      allow write: if isOfficeStaff() && (isTotalMasterUser() || myCo() == co) && request.resource.data.get('companyName', '') == co;
    }
    match /vehiclePhotos/{id} {
      allow create: if isSignedIn() && request.resource.data.get('driverId', '') == request.auth.uid
        && request.resource.data.get('companyName', '') == myCo() && id.matches(request.auth.uid + '_.*');
      allow update: if (isOfficeStaff() && coMatch(resource.data) && coKeep())
        || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid && request.resource.data.get('driverId', '') == request.auth.uid
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', ''));
      allow read: if (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid) || (isOfficeStaff() && coMatch(resource.data));
      allow delete: if isOfficeStaff() && coMatch(resource.data);
    }
    // ✍ 2026-11-10 기사앱으로 보낸 운송계약서(driverContracts) — 직원은 같은 회사 전체(발송·삭제), 기사는 본인 것만 읽고
    //  열람(read)·서명(signed)만 할 수 있다. 서명한 뒤에는 기사가 다시 고칠 수 없다.
    match /driverContracts/{id} {
      allow read: if (isOfficeStaff() && coMatch(resource.data)) || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid);
      allow create: if isOfficeStaff() && coCreate() && request.resource.data.get('status', '') == 'sent';
      allow update: if (isOfficeStaff() && coMatch(resource.data) && coKeep())
        || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid && resource.data.get('status', '') != 'signed'
          && request.resource.data.get('status', '') in ['read', 'signed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'status', 'signedAt', 'signImage', 'signMethod', 'signName']));
      allow delete: if isOfficeStaff() && coMatch(resource.data);
    }
    // 📜 계약서 보관함(전자결재 › 계약서) — 직원만
    match /companyContracts/{id} {
      allow read, update, delete: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // 🛣 고정노선(지입차관리 › 고정노선) — 직원만
    match /fixedRoutes/{id} {
      allow read, update, delete: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // ⭐ 2026-11-03 개인 일정 — 본인만 읽고 쓴다(uid = 로그인한 사람)
    match /personalSchedules/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // ⭐ 2026-11-02 배차표 양식(고정노선 › 배차표) — 회사 직원(기사·화주 제외)만
    match /routeBoards/{id} {
      allow read, update, delete: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // 🔗 2026-11-07 구글시트 연동 시트 프로필(sheetProfiles/{id} = { companyName, sheetUrl, columns, … }) — 회사별로 잠금 스위치와 상관없이 분리
    //  읽기: 그 회사 사무 직원(기사·화주 제외) · 만들기/고치기/지우기: 그 회사 관리자급(isCompanyAdmin) · 회사는 못 바꾼다
    //  동기화 상태(lastExport·lastError)는 서버(관리자 SDK)가 쓴다
    match /sheetProfiles/{id} {
      allow read: if isOfficeStaff() && (isTotalMasterUser() || resource.data.get('companyName', '') == myCo());
      allow create: if isTotalMasterUser() || (isOfficeStaff() && isCompanyAdmin(myCo()) && request.resource.data.get('companyName', '') == myCo());
      allow update: if isTotalMasterUser() || (isOfficeStaff() && isCompanyAdmin(myCo()) && resource.data.get('companyName', '') == myCo() && request.resource.data.get('companyName', '') == myCo());
      allow delete: if isTotalMasterUser() || (isOfficeStaff() && isCompanyAdmin(myCo()) && resource.data.get('companyName', '') == myCo());
    }
    // ⭐ 2026-11-05 고정노선현황 › 운송업체 설정(routeCarrierSettings/{회사} = { companyName, carriers:[{name,on}], removed:[이름] })
    //  끈·삭제한 운송업체의 고정노선 오더는 정산·매출에서 빠진다 — 그 회사 직원(기사·화주 제외)은 읽고, 관리자급(isCompanyAdmin·test)만 바꾼다.
    //  문서 이름 = 회사명이라 잠금 스위치와 상관없이 다른 회사는 못 본다.
    match /routeCarrierSettings/{co} {
      allow read: if fareRulesStaff(co);
      allow create, update: if (isTotalMasterUser() || (isOfficeStaff() && myCo() == co && (isCompanyAdmin(co) || myRole() == 'test')))
        && request.resource.data.get('companyName', '') == co;
      allow delete: if isTotalMasterUser() || isCompanyAdmin(co);
    }
    // ⭐ 2026-11-02 운임규칙 — 회사별 운임 규칙(fareRules/{회사}) — 그 회사 직원(기사·화주 제외)만 읽고,
    //  조회전용(viewer)이 아닌 직원은 누구나 수정. 문서 이름 = 회사명이라 잠금 스위치와 상관없이 다른 회사는 못 본다.
    function fareRulesStaff(co) {
      return isTotalMasterUser() || (isOfficeStaff() && myCo() == co);
    }
    // 회사별 맞춤 기능(companyFeatures/{회사} = { fareRules: true, … }) — 최고관리자(관리자센터)만 켜고 끈다.
    //  그 회사 승인 직원은 읽기만(켜진 회사에만 메뉴가 보이게)
    // ⭐ 2026-11-03 회사 설정(공지 작성 권한 등) — 같은 회사는 읽고, 그 회사 마스터·최고관리자만 바꾼다
    match /companySettings/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser() || (isApproved() && myCo() == co && myIsMaster());
      // 사업자 목록(bizList)은 관리자·경리·인사도(공지 작성 권한은 못 바꿈)
      // ⭐ 2026-11-04 통합관리자(allMgr = 운송+경리+인사)·경리사무원(acctStaff)도
      allow create: if isApproved() && myCo() == co && myRole() in ['admin', 'allMgr', 'hrAcct', 'hrManager', 'test', 'acctStaff']
        && request.resource.data.keys().hasOnly(['companyName', 'bizList', 'bizListAt', 'bizMemory']);
      allow update: if isApproved() && myCo() == co && myRole() in ['admin', 'allMgr', 'hrAcct', 'hrManager', 'test', 'acctStaff']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'bizList', 'bizListAt', 'bizMemory']);
      // ⭐ 2026-11-03 청구 사업자 기억(bizMemory: 거래처+상차지+하차지 → 사업자 이름) — 실무자(user)도 오더를 저장할 때 함께 기록한다(이 칸만)
      allow update: if isApproved() && myCo() == co && myRole() in ['admin', 'allMgr', 'hrAcct', 'hrManager', 'test', 'acctStaff', 'hrStaff', 'user']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bizMemory']);
    }
    // 🎨 2026-11-03 표 컬럼 색(회사 공용) — 그 회사 직원은 읽고, 둘러보기(viewer) 말고는 바꿀 수 있다
    match /colStyles/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser() || (isApproved() && myCo() == co && myRole() != 'viewer'
        && request.resource.data.get('companyName', '') == co);
    }
    // 🧩 2026-11-10 컬럼 수정 — 계정마다 내 배치(본인만) · 회사 전체 적용 배치(같은 회사 직원 읽기 · 조회전용 빼고 쓰기)
    match /colLayouts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isApproved()
        && request.resource.data.get('uid', '') == uid
        && (isTotalMasterUser() || request.resource.data.get('companyName', '') == myCo());
    }
    match /colLayoutsCompany/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser() || (isApproved() && myCo() == co && myRole() != 'viewer'
        && myRole() != 'driver' && myRole() != 'shipper'
        && request.resource.data.get('companyName', '') == co);
    }
    match /companyFeatures/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser();
    }
    function fareFeatureOn(co) {
      // ⭐ 2026-11-09 운임 규칙은 모든 운송사 기본 켜짐 — 최고관리자가 끈(false) 회사만 막는다
      return !exists(/databases/$(database)/documents/companyFeatures/$(co))
        || get(/databases/$(database)/documents/companyFeatures/$(co)).data.get('fareRules', true) != false;
    }
    // ⭐ 2026-11-04 운임구분 바로 추가 — 오더 화면 운임구분 드롭다운에서 새 규칙을 바로 추가(rules·history arrayUnion, merge)해도
    //  아래 update 조건(조회전용 아닌 그 회사 직원 + 기능 켜짐 + companyName 유지) 그대로 통과 → 규칙 변경 없음
    match /fareRules/{co} {
      allow read: if fareRulesStaff(co);
      allow create: if fareRulesStaff(co) && myRole() != 'viewer' && (isTotalMasterUser() || fareFeatureOn(co))
        && request.resource.data.get('companyName', '') == co;
      allow update: if fareRulesStaff(co) && myRole() != 'viewer' && (isTotalMasterUser() || fareFeatureOn(co))
        && request.resource.data.get('companyName', '') == co;
      allow delete: if fareRulesStaff(co) && isCompanyAdmin(co);
    }
    // 💼 2026-11-10 영업팀 — 영업 기회(salesLeads)·영업 활동(salesActivities)은 아래 회사 데이터 공용 규칙.
    //  거래처 담당·인센티브 규정·인센티브 확정은 영업 관리 권한(영업관리자·운송관리자·통합관리자·회사 마스터·임원 화면 역할)만 고친다
    //  (화면의 salesCore.js canManageSales와 같은 기준)
    function salesAdmin() {
      return isTotalMasterUser() || (isApproved() && !isShipperUser()
        && (myRole() in ['salesMgr', 'admin', 'allMgr'] || myIsMaster() || isExecRoleUser()));
    }
    // 거래처 담당 — 수주 처리한 본인 거래처는 본인이 등록할 수 있고, 바꾸기·해제는 영업 관리 권한만
    match /salesAccounts/{id} {
      allow read: if (resource == null && isApproved()) || coMatch(resource.data);
      allow create: if coCreate() && myRole() != 'viewer'
        && (request.resource.data.get('uid', '') == request.auth.uid || salesAdmin());
      allow update: if coMatch(resource.data) && coKeep() && salesAdmin();
      allow delete: if coMatch(resource.data) && salesAdmin();
    }
    // 인센티브 규정 · 사람별 목표(회사당 한 문서)
    match /salesPlans/{co} {
      allow read: if (resource == null && isApproved()) || coMatch(resource.data);
      allow create: if coCreate() && salesAdmin() && (isTotalMasterUser() || co == myCo());
      allow update: if coMatch(resource.data) && coKeep() && salesAdmin();
      allow delete: if isTotalMasterUser();
    }
    // 인센티브 확정 기록 — 본인 것과 영업 관리 권한 · 경리(지급 확인)만 읽는다
    match /salesIncentives/{id} {
      allow read: if (resource == null && isApproved())
        || (coMatch(resource.data) && (resource.data.get('uid', '') == request.auth.uid
          || myRole() in ['test', 'acctStaff', 'hrAcct'] || salesAdmin()));
      allow create: if coCreate() && salesAdmin();
      allow update: if coMatch(resource.data) && coKeep() && salesAdmin();
      allow delete: if coMatch(resource.data) && salesAdmin();
    }
    // 🔒 회사 데이터(거래처·하차지·정기오더·삭제기록·알림·일정·메일·인사·근태신청·회계·결재선 · 2026-11-07 arDesk 거래명세서 단계·미수금 메모)
    // ⭐ 2026-11-02 점검 — approvalSettings(결재 설정)는 아래 전자결재 쪽 전용 규칙으로 옮김(누구나 임원 자동 승인을 켜던 문제)
    match /{tcol}/{id} {
      allow read: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes', 'arDesk', 'vehicleCardTx', 'vehicleCareSettings', 'vehicleCostReports', 'salesLeads', 'salesActivities']
        // ⭐ 2026-11-02 점검 — 없는 문서를 getDoc하면 resource가 null이라 coMatch(resource.data)가 오류 → 거부되던 문제
        //  (ledgerAuto.js 자동 장부의 "새 줄인지" 확인). 없는 문서는 승인된 계정이면 "없음"만 알 수 있게 허용
        && ((resource == null && isApproved()) || coMatch(resource.data));
      allow create: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes', 'arDesk', 'vehicleCardTx', 'vehicleCareSettings', 'vehicleCostReports', 'salesLeads', 'salesActivities']
        && coCreate();
      allow update: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes', 'arDesk', 'vehicleCardTx', 'vehicleCareSettings', 'vehicleCostReports', 'salesLeads', 'salesActivities']
        && coMatch(resource.data) && coKeep();
      allow delete: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes', 'arDesk', 'vehicleCardTx', 'vehicleCareSettings', 'vehicleCostReports', 'salesLeads', 'salesActivities']
        && coMatch(resource.data);
    }
    // 💰 자금(통장·현금 잔액) — 경리(test)·관리자(대표 등)만. 화면에서는 경리 + 대표 직책만 보이게 한다
    // ⭐ 2026-11-02 점검 — 권한 관리에서 직접 만든 역할에 '자금관리' 메뉴를 켜면(읽기 → 조회, 쓰기 → 등록·수정·삭제) 자금 데이터도 허용
    //  (화면의 mergeCompanyRoles + getMenuAccess와 같은 순서: 운송사별 설정의 menus가 있으면 공통 역할 menus 대신 쓴다. 내장 역할은 제외)
    function fundsMenuLevel() {
      return ck() ? tk('fm', 'hidden') : fundsMenuLevelDoc();
    }
    function fundsMenuLevelDoc() {
      let r = myUser().get('role', '');
      let p = /databases/$(database)/documents/customRoles/$(r);
      let ov = /databases/$(database)/documents/companyRoleOverrides/$(myUser().get('companyName', ''));
      let g = exists(p) ? get(p).data : {};
      let o = exists(ov) ? get(ov).data.get('roles', {}).get(r, {}) : {};
      let menus = ('menus' in o) ? o.get('menus', {}) : g.get('menus', {});
      // (사무원·법무·개발 역할은 직접 만든 역할처럼 메뉴 설정을 따른다 — 통합관리자는 아래 역할 목록으로)
      return (r != '' && !(r in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'user', 'test', 'viewer', 'totalMaster', 'driver', 'shipper'])
        && (exists(p) || o.size() > 0)) ? menus.get('자금관리', 'hidden') : 'hidden';
    }
    match /acctFunds/{id} {
      allow read: if coMatch(resource.data) && (isTotalMasterUser() || myRole() in ['test', 'admin', 'hrAcct', 'allMgr'] || isExecRoleUser() || fundsMenuLevel() in ['read', 'write']);
      allow create: if coCreate() && (isTotalMasterUser() || myRole() in ['test', 'admin', 'hrAcct', 'allMgr'] || fundsMenuLevel() == 'write');
      allow update: if coMatch(resource.data) && coKeep() && (isTotalMasterUser() || myRole() in ['test', 'admin', 'hrAcct', 'allMgr'] || fundsMenuLevel() == 'write');
      allow delete: if coMatch(resource.data) && (isTotalMasterUser() || myRole() in ['test', 'admin', 'hrAcct', 'allMgr'] || fundsMenuLevel() == 'write');
    }
    // 화주사 주소록(places) — 화주 본인이 등록한 주소만
    match /places/{id} {
      allow read, update, delete: if isApproved() && isShipperUser() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isApproved() && isShipperUser() && request.resource.data.get('userId', '') == request.auth.uid;
    }
    // 알림 — 받는 사람 본인은 읽고 "읽음" 표시
    match /notifications/{id} {
      allow read: if isApproved() && resource.data.get('toUid', '') == request.auth.uid;
      allow update: if isApproved() && resource.data.get('toUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // 기사전달용 업로드 링크 단축 — /u/{code}가 로그인 없이 code로 원본
    // (오더id+토큰)을 조회해 /upload로 넘겨줘야 한다. list는 막아서 전체
    // 코드 목록이 노출되지 않게 하고, 발급(create/update)은 로그인한
    // 운송사 앱에서만 가능하게 한다.
    // ⭐ 2026-11-07 보안 — 이미 있는 짧은 링크는 같은 오더(id)로만 다시 쓸 수 있다(다른 회사가 남의 링크를 다른 곳으로 돌리지 못하게) · 삭제는 최고관리자
    match /shortLinks/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isApproved();
      allow update: if isApproved() && request.resource.data.get('id', '') == resource.data.get('id', '');
      allow delete: if isTotalMasterUser();
    }

    // 인수증/서류 첨부 — 그 오더의 운송사(잠금 후) · 화주사만 읽고 쓴다.
    //  ⭐ 2026-11-07 보안 — 목록·수정은 그 오더의 운송사(잠금 후) · 화주사만(예전엔 승인된 누구나 다른 회사 오더 첨부 목록을 읽었다)
    //  ⭐ 2026-11-08 보안 — 한 건 읽기·올리기·지우기도 같은 기준(예전엔 "오더 id만 알면 누구나" — 업로드 링크용).
    //   업로드 링크(로그인 없음)는 서버 함수 uploadAccess가 토큰을 확인한 뒤 대신 올리고 지운다.
    //   회사명 없는 예전 부모 문서(수동 업로드 driver_uploads 등)의 첨부는 승인된 사무 직원만 한 건 읽기(예전엔 누구나).
    function attParentOk(col, orderId) {
      let p = /databases/$(database)/documents/$(col)/$(orderId);
      return isTotalMasterUser() || (isApproved() && (!locked()
        || (exists(p) && ((!isShipperUser() && get(p).data.get('companyName', '') == myCo()) || shipperOwns(get(p).data)))));
    }
    function attLegacyParentGet(col, orderId) {
      let p = /databases/$(database)/documents/$(col)/$(orderId);
      return isOfficeStaff() && exists(p) && !('companyName' in get(p).data);
    }
    match /{col}/{orderId}/attachments/{attId} {
      allow get: if attParentOk(col, orderId) || attLegacyParentGet(col, orderId);
      allow list, create, update, delete: if attParentOk(col, orderId);
    }

    // 수동 업로드(오더 id 없이 들어온 기사) — 새 메타 문서 생성만 허용, 조회는 로그인 사용자만.
    //  읽기·수정은 아래 기사 기록 공용 규칙(looseRead — 잠금 후 같은 회사)
    match /driver_uploads/{id} {
      allow create: if true;
    }

    // 홈페이지(랜딩페이지) 도입 문의 — 로그인 없는 방문자가 폼으로 제출만 할 수 있고,
    // 목록 조회/상태 변경은 관리자메뉴(로그인 사용자)만 가능하다.
    //  ⭐ 2026-11-07 보안 — 도입 문의(방문자 이름·연락처)는 플랫폼 영업 자료라 최고관리자만(예전엔 승인된 모든 운송사 직원이 읽었다)
    match /landingInquiries/{id} {
      allow create: if true;
      allow get, list, update, delete: if isTotalMasterUser();
    }

    // 실시간 위치공유 — 업로드 페이지에서 오더 id로만 쓰고 읽는다. 전체 목록 열람은 로그인 사용자만.
    //  ⭐ 2026-11-07 보안 — 목록·삭제는 최고관리자 또는 (잠금 후) 같은 회사 문서만
    match /liveLocations/{id} {
      allow get, create, update: if true;
      allow list, delete: if looseRead(resource.data);
    }

    // ────────────────────────────────────────────────────────────
    // ⭐ 2026-11-06 오더마켓(예전 배차마당) — 운송사끼리 오더를 주고받는 거래소
    //  · 게시글 본문(cafeOrders)은 로그인 회원 전체 열람. 새 글(v 2)은 시/구까지만 담고, 상·하차지명·정확한 주소·연락처는
    //    private/detail 에 따로 둔다 → 올린 운송사 + 매칭된 운송사만 열람. private/settle(청구 운임·수수료)은 올린 운송사만.
    //  · 새 글 등록·잡기 요청·수락은 승인된 운송사 직원 계정만(배차마당 가입 계정·기사·화주·조회전용 제외).
    //  · 예전 글(v 없음)은 예전 규칙(10초 배차신청 · contact/info 연락처)을 그대로 따른다.
    // ────────────────────────────────────────────────────────────
    function isMarketCompany() {
      return isApproved() && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer'])
        && myCoRaw() != '';
    }
    function mkDoc(orderId) {
      return get(/databases/$(database)/documents/cafeOrders/$(orderId)).data;
    }
    function mkPoster(d) {
      return isSignedIn() && d.get('posterUid', '') == request.auth.uid;
    }
    function mkTaker(d) {
      return isSignedIn() && d.get('takerUid', '') == request.auth.uid && d.get('status', '') in ['matched', 'dispatched', 'delivered'];
    }
    function mkV2(d) {
      return d.get('v', 0) >= 2;
    }
    // 요청자 목록은 "내 uid 하나"만 넣고 뺄 수 있다
    function mkOnlyMyUid() {
      let before = resource.data.get('requesterUids', []).toSet();
      let after = request.resource.data.get('requesterUids', []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).hasOnly([request.auth.uid]);
    }
    match /cafeOrders/{orderId} {
      allow read: if isSignedIn();
      // 새 글 — 우리 회사 이름으로, 모집중 상태로, 정확한 주소·지명·연락처 없이
      allow create: if isMarketCompany()
        && request.resource.data.get('v', 0) == 2
        && request.resource.data.get('posterUid', '') == request.auth.uid
        && request.resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('takerUid', null) == null
        && !request.resource.data.keys().hasAny(['상차지명', '상차지주소', '하차지명', '하차지주소', 'posterPhone', '상차지담당자번호', '하차지담당자번호']);
      allow update: if
        // ① 올린 운송사 — 회사·작성자는 못 바꾸고, 매칭 상대는 실제로 요청한 운송사만
        (mkPoster(resource.data)
          && request.resource.data.get('posterUid', '') == resource.data.get('posterUid', '')
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
          && request.resource.data.get('v', 0) == resource.data.get('v', 0)
          && (!mkV2(resource.data) || !request.resource.data.keys().hasAny(['상차지주소', '하차지주소', 'posterPhone']))
          && (request.resource.data.get('takerUid', null) == null
              || request.resource.data.get('takerUid', null) == resource.data.get('takerUid', null)
              || (resource.data.get('status', '') == 'open'
                  && exists(/databases/$(database)/documents/cafeOrders/$(orderId)/requests/$(request.resource.data.takerUid))
                  && get(/databases/$(database)/documents/cafeOrders/$(orderId)/requests/$(request.resource.data.takerUid)).data.get('status', '') == 'pending'))) ||
        // ② 잡기 요청/철회 — 다른 운송사가 요청자 목록에 자기 uid만 넣고 뺀다
        (mkV2(resource.data) && isMarketCompany() && !mkPoster(resource.data)
          && resource.data.get('status', '') == 'open' && resource.data.get('companyName', '') != myCo()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requesterUids', 'updatedAt'])
          && mkOnlyMyUid()) ||
        // ③ 매칭된 운송사 — 진행 단계(앞으로만)·내 프로그램 오더 번호·평가만
        (mkV2(resource.data) && mkTaker(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takerOrderId', 'dispatchedAt', 'deliveredAt', 'driverMasked', 'ratingByTaker', 'updatedAt'])
          && request.resource.data.get('status', '') in ['matched', 'dispatched', 'delivered']
          && (request.resource.data.get('takerOrderId', null) == resource.data.get('takerOrderId', null)
              || request.resource.data.get('takerOrderId', '') == 'mkt_' + orderId)) ||
        // ④ 예전 글 — 10초 배차신청 흐름(신청·취소·확정)
        (!mkV2(resource.data) && isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'applicantUid', 'applicantName', 'applicantNickname', 'applyRequestedAt', 'confirmedAt', 'updatedAt'])
          && request.resource.data.get('status', '') in ['open', 'applying', 'confirmed']);
      allow delete: if mkPoster(resource.data);

      // 비공개 상세(detail: 올린 운송사 + 매칭된 운송사) · 정산 메모(settle: 올린 운송사만)
      match /private/{docId} {
        allow read: if mkPoster(mkDoc(orderId)) || (docId == 'detail' && mkTaker(mkDoc(orderId)));
        allow create, update: if docId in ['detail', 'settle'] && isSignedIn()
          && getAfter(/databases/$(database)/documents/cafeOrders/$(orderId)).data.get('posterUid', '') == request.auth.uid;
        allow delete: if mkPoster(mkDoc(orderId));
      }

      // 잡기 요청 — 문서 이름 = 요청한 운송사 계정 uid
      match /requests/{rid} {
        allow get: if isSignedIn() && (request.auth.uid == rid || mkPoster(mkDoc(orderId)));
        allow list: if mkPoster(mkDoc(orderId));
        allow create: if isMarketCompany() && request.auth.uid == rid
          && mkV2(mkDoc(orderId)) && mkDoc(orderId).get('status', '') == 'open'
          && mkDoc(orderId).get('posterUid', '') != rid && mkDoc(orderId).get('companyName', '') != myCo()
          && request.resource.data.get('takerUid', '') == rid
          && request.resource.data.get('takerCompany', '') == myCo()
          && request.resource.data.get('status', '') == 'pending';
        allow update: if
          // 요청한 운송사 — 다시 요청(pending) / 철회(withdrawn)
          (isMarketCompany() && request.auth.uid == rid
            && request.resource.data.get('takerUid', '') == rid
            && request.resource.data.get('takerCompany', '') == myCo()
            && request.resource.data.get('status', '') in ['pending', 'withdrawn']
            && (request.resource.data.get('status', '') == 'withdrawn' || mkDoc(orderId).get('status', '') == 'open')) ||
          // 올린 운송사 — 수락/거절/마감/매칭취소 표시만
          (mkPoster(mkDoc(orderId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'updatedAt'])
            && request.resource.data.get('status', '') in ['accepted', 'rejected', 'closed', 'cancelled']);
        allow delete: if false;
      }

      // (예전 글) 연락처 — "배차완료" 상태에서 당사자(등록자/신청자)만
      match /contact/{docId} {
        allow read: if isSignedIn() &&
          mkDoc(orderId).status == "confirmed" &&
          (request.auth.uid == mkDoc(orderId).posterUid || request.auth.uid == mkDoc(orderId).applicantUid);
        allow write: if isSignedIn() && !mkV2(getAfter(/databases/$(database)/documents/cafeOrders/$(orderId)).data);
      }
    }
    // ⭐ 2026-11-06 오더마켓 알림 — 받는 사람 본인만 읽고 "읽음" 표시. 보내기는 운송사 계정이 자기 이름으로만.
    match /marketNotices/{id} {
      allow read: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if isMarketCompany()
        && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('toUid', '') is string && request.resource.data.get('toUid', '') != request.auth.uid
        && request.resource.data.get('read', true) == false
        && exists(/databases/$(database)/documents/cafeOrders/$(request.resource.data.get('orderId', '_')));
      allow delete: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid;
    }

    // ────────────────────────────────────────────────────────────
    // ⭐ 2026-11-06 로지스웹 허브 콜(차주 · 화주 · 운송사) — 데이터 설명은 cafe-site/src/hub/hubApi.js 맨 위
    //  · 회원(hubMembers)은 본인 + 관리자만 본다. 허브 가입 회원은 users 문서가 없어 배차 프로그램 데이터에 접근할 수 없다.
    //  · 기존 로지스웹 계정(운송사 직원 · 소속 기사 · 화주사)은 users 문서와 같은 회사·차량일 때만 바로 "승인" 회원이 된다.
    //  · 배차신청은 모집중일 때 먼저 쓴 1명만 성공, 취소는 서버 시각으로 10초 안에만(그 뒤엔 전화로).
    //  ⭐ 2026-11-07 (3차)
    //  · 회사 사이 데이터 완전 분리 — 회사 키(hubKeyOf: 로지스웹 계정 "lw:회사명" · 허브 가입 "biz:사업자번호" · 관리자가 정한 companyKey)
    //    가 같은 회원끼리만 오더 기록 · 오더복사 · 고객관리를 나눈다. 다른 회사는 모집중 오더(공개 칸)만 보드에서 본다.
    //  · 단계: 모집중 → 배차신청(10초) → 확정 = 운송중(위치 공유) → 차주 [운송완료] → 인수증 · 계산서 → 등록자 계산서 확인(지급예정일)
    //  · 회차: 등록자가 금액을 정해 요청 → 차주가 수락해야 확정 · 배차신청은 실계좌(은행 · 계좌번호 · 예금주)가 있어야
    // ────────────────────────────────────────────────────────────
    function hubPath(uid) {
      return /databases/$(database)/documents/hubMembers/$(uid);
    }
    function hubMe() {
      return get(hubPath(request.auth.uid)).data;
    }
    // 회사 키(functions/hubSync.js companyKeyOf와 같은 계산)
    function hubKeyOf(m, uid) {
      return m.get('companyKey', '') != '' ? m.get('companyKey', '')
        : (m.get('source', 'signup') != 'signup' ? 'lw:' + m.get('companyName', '')
          : (m.get('bizNo', '').replace('[^0-9]', '') != '' ? 'biz:' + m.get('bizNo', '').replace('[^0-9]', '') : 'uid:' + uid));
    }
    // 🎫 허브 토큰 권한(hv == 1 — functions/authClaims.js) · 회사 키는 토큰(hk), 없으면 회원 문서로 계산
    function hck() {
      return request.auth != null && request.auth.token.get('hv', 0) == 1;
    }
    function hubMyKey() {
      return hck() ? tk('hk', '') : hubKeyOf(hubMe(), request.auth.uid);
    }
    // 승인된 허브 회원 — 로지스웹 계정으로 들어온 회원은 로지스웹 계정도 지금 유효해야 한다(퇴사·정지·계약종료 반영)
    function hubActive() {
      return isSignedIn() && (
        (hck() && tk('hs', false) == true && (tk('hsg', false) == true || isApproved())) ||
        (exists(hubPath(request.auth.uid)) && hubMe().get('status', '') == 'approved'
          && (hubMe().get('source', '') == 'signup' || isApproved())));
    }
    function hubCanPost() {
      return hubActive() && hubMe().get('role', '') in ['shipper', 'carrier'];
    }
    // ⭐ 2026-11-07 배차신청은 본인 실계좌(은행 · 계좌번호 · 예금주)를 등록해야
    function hubHasBank() {
      let b = hubMe().get('bank', null);
      return b is map && b.get('bank', '') != '' && b.get('number', '').size() >= 6 && b.get('holder', '') != '';
    }
    // ⭐ 2026-11-07 허브 가입 차주는 등록된 휴대폰(기기)에서만 — hubDevices/{uid}는 서버(functions/hubDriverAuth.js hubBindDevice)만 쓴다.
    //  규칙은 기기 번호를 볼 수 없어서 "등록된 기기가 있는 계정"까지만 확인한다(기기 비교는 로그인 · 앱 시작 때 서버 함수와 화면이 한다).
    //  로지스웹 소속 기사(source logisweb-driver)는 로지스웹 기사앱 계정이라 여기서 제외.
    function hubDeviceOk() {
      return !(hubMe().get('role', '') == 'driver' && hubMe().get('source', '') == 'signup')
        || (exists(/databases/$(database)/documents/hubDevices/$(request.auth.uid))
            && get(/databases/$(database)/documents/hubDevices/$(request.auth.uid)).data.get('id', null) != null);
    }
    // 허브 차주 로그인 계정(차량번호@hubdriver.run25.kr) — 차량번호 · 휴대폰번호가 로그인 정보라 본인이 못 바꾼다(관리자 함수 hubAdminSetDriverLogin)
    function hubPlateLogin() {
      return request.auth.token.get('email', '').matches('.*@hubdriver[.]run25[.]kr$');
    }
    function hubPlateOf(d) {
      return d.get('vehicle', null) is map ? d.get('vehicle', null).get('plate', '') : '';
    }
    function hubCanTake() {
      return hubActive() && hubMe().get('role', '') in ['driver', 'carrier'] && hubDeviceOk()
        && hubMe().get('penalty', {}).get('blocked', false) != true && hubHasBank();
    }
    // 허브 가입 회원은 users 문서가 없다 — 없는 문서를 get()하면 오류가 나서 "A || 관리자" 전체가 거절되므로 exists()로 먼저 확인
    function hubAdmin() {
      return isSignedIn() && (request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        ((!ck() || tk('tm', false) == true) && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'totalMaster'));
    }
    // 기존 로지스웹 계정 연결 — users 문서와 회사(기사는 차량번호까지)가 같아야
    function hubLinkOk(d) {
      let u = myUser();
      return isApproved() && d.get('companyName', '') == u.get('companyName', '') && (
        (d.get('source', '') == 'logisweb-staff' && d.get('role', '') == 'carrier'
          && !(u.get('role', '') in ['driver', 'shipper', 'cafeUser', 'viewer']) && u.get('companyName', '') != '') ||
        (d.get('source', '') == 'logisweb-driver' && d.get('role', '') == 'driver'
          && u.get('role', '') == 'driver' && u.get('approved', false) == true
          && d.get('vehicle', {}).get('plate', '') == u.get('carNo', u.get('차량번호', ''))) ||
        (d.get('source', '') == 'logisweb-shipper' && d.get('role', '') == 'shipper' && u.get('role', '') == 'shipper'));
    }
    match /hubMembers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || hubAdmin());
      allow list: if hubAdmin();
      // 회사 키(companyKey) · 가상계좌(va)는 관리자만 정한다
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid
        && !request.resource.data.keys().hasAny(['verified', 'bizStatus', 'adminNote', 'penalty', 'reviewedAt', 'reviewedBy', 'approvedAt', 'rejectReason', 'isAdmin', 'companyKey', 'va'])
        && hubBankOk(request.resource.data.get('bank', null))
        && !request.resource.data.keys().hasAny(['boundDevice', 'deviceOk'])
        && (!hubPlateLogin() || (request.resource.data.get('role', '') == 'driver' && request.resource.data.get('source', '') == 'signup'
             && hubPlateOf(request.resource.data) + '@hubdriver.run25.kr' == request.auth.token.get('email', '')))
        && ((request.resource.data.get('source', '') == 'signup' && request.resource.data.get('status', '') == 'pending'
             && request.resource.data.get('role', '') in ['driver', 'shipper', 'carrier']
             && !request.resource.data.keys().hasAny(['docsVerified']))
          || (request.resource.data.get('status', '') == 'approved' && hubLinkOk(request.resource.data)));
      allow update: if hubAdmin() || (isSignedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'source', 'verified', 'docsVerified', 'bizStatus', 'adminNote', 'penalty', 'reviewedAt', 'reviewedBy', 'approvedAt', 'rejectReason', 'isAdmin', 'companyKey', 'va', 'boundDevice', 'deviceOk', 'login'])
        && (!hubPlateLogin() || (request.resource.data.get('phone', '') == resource.data.get('phone', '')
             && hubPlateOf(request.resource.data) == hubPlateOf(resource.data)
             && request.resource.data.get('email', '') == resource.data.get('email', '')))
        && (
          // 승인 후에는 알림 · 오더 설정 · 즐겨찾기 · 기기 번호 · 프로필 사진 · 실계좌만(차량·서류를 바꾸려면 다시 심사)
          (resource.data.get('status', '') == 'approved' && request.resource.data.get('status', '') == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs', 'activeSession', 'lastLoginAt', 'updatedAt', 'photoPath', 'fcmTokens', 'fcmTokenAt', 'fcmTokensOut', 'bank'])
            && hubBankOk(request.resource.data.get('bank', null))) ||
          // 승인 대기 중 신청서 고치기 · 거절 뒤 다시 제출
          (resource.data.get('source', '') == 'signup' && resource.data.get('status', '') in ['pending', 'rejected']
            && request.resource.data.get('status', '') == 'pending' && hubBankOk(request.resource.data.get('bank', null))) ||
          // 어떤 상태든 기기 번호(한 계정 한 기기)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSession', 'lastLoginAt'])));
      allow delete: if hubAdmin();
    }
    // ⭐ 2026-11-06 정산 계좌(운임 받을 실계좌) — 은행(목록에서 고름) · 계좌번호 · 예금주만
    function hubBankOk(b) {
      return b == null || (b is map && b.keys().hasOnly(['bank', 'number', 'holder', 'updatedAt'])
        && b.get('bank', '') is string && b.get('bank', '').size() <= 30
        && b.get('number', '') is string && b.get('number', '').size() <= 30
        && b.get('holder', '') is string && b.get('holder', '').size() <= 40);
    }
    // 완료 건수 · 평점 — 서버 함수만 쓴다
    match /hubStats/{uid} {
      allow read: if hubActive();
      allow read: if hubAdmin();
      allow write: if false;
    }
    // 오더 등록 횟수 제한 — 20초 간격 · 하루(UTC) 30건, 시각·날짜는 서버 시각으로 확인
    match /hubQuota/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'count', 'day', 'lastPostAt'])
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('count', 0) == 1
        && request.resource.data.get('day', null) == request.time.date()
        && request.resource.data.get('lastPostAt', null) == request.time;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'count', 'day', 'lastPostAt'])
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('lastPostAt', null) == request.time
        && request.time > resource.data.lastPostAt + duration.value(20, 's')
        && request.resource.data.get('day', null) == request.time.date()
        && (resource.data.get('day', null) == request.time.date()
              ? (request.resource.data.get('count', 0) == resource.data.get('count', 0) + 1 && request.resource.data.get('count', 0) <= 30)
              : request.resource.data.get('count', 0) == 1);
      allow delete: if hubAdmin();
    }
    function hubEditKeys() {
      return ['상차시도', '상차시군구', '하차시도', '하차시군구', '상차일', '상차시간', '하차일', '하차시간', '화물내용', '중량', '파레트',
        '차량종류', '차량톤수', '톤수값', '상차방법', '하차방법', '운임', '수수료', '지급방식', '긴급', '운행유형', '적재', '공개메모', '거리km',
        '상차지역', '대수', '예약', 'showAt', 'updatedAt'];
    }
    function hubOrd(id) {
      return get(/databases/$(database)/documents/hubOrders/$(id)).data;
    }
    // ⭐ 2026-11-06 예치금 결제(인수증 · 예치금) 오더는 등록자 예치금이 운임 이상일 때만 등록 · 배차신청 · 확정
    //  (잔액은 서버 함수만 쓴다 — functions/hubWallet.js. 실제 보류는 확정 순간 서버가 트랜잭션으로 한 번 더 확인)
    function hubWalletAvail(uid) {
      return exists(/databases/$(database)/documents/hubWallets/$(uid))
        ? get(/databases/$(database)/documents/hubWallets/$(uid)).data.get('available', 0) : 0;
    }
    function hubDepositOk(d, uid) {
      return !(d.get('지급방식', '') in ['인수증', '예치금']) || hubWalletAvail(uid) >= d.get('운임', 0);
    }
    // 인수증 · 서류(여러 장) — [{ path, name, type, size, kind, at }]
    function hubPodOk(list) {
      return list is list && list.size() <= 30;
    }
    function hubInvoiceOk(v) {
      return v is map && v.keys().hasOnly(['no', 'date', 'amount', 'path', 'name', 'bizNo', 'at'])
        && v.get('no', '') is string && v.get('no', '').size() >= 4 && v.get('no', '').size() <= 40
        && v.get('date', '') is string && v.get('amount', 0) is number;
    }
    function hubOrdAfter(id) {
      return getAfter(/databases/$(database)/documents/hubOrders/$(id)).data;
    }
    // 같은 회사(등록자와 같은 회사 키) — 오더 기록 · 오더복사 · 상세(주소) 보기
    function hubSameCo(o) {
      return o.get('posterCompanyKey', '') != '' && o.get('posterCompanyKey', '') == hubMyKey();
    }
    // 비공개 문서 읽기 — 등록자 · 같은 회사(정산 메모 제외) · 배차된 회원(상세는 10초 확정 후) · 각자 정산 메모
    function hubPrivReadOk(o, docId) {
      let me = request.auth.uid;
      let poster = o.get('posterUid', '') == me;
      let taker = o.get('takerUid', '') == me;
      let st = o.get('status', '');
      return (poster && !docId.matches('settle_.*'))
        || (docId == 'detail' && hubActive() && hubSameCo(o))
        || (taker && docId == 'match')
        || (taker && docId == 'detail' && (st in ['loaded', 'delivered'] || (st == 'assigned' && o.get('confirmed', false) == true)))
        || ((poster || taker) && docId == 'settle_' + me);
    }
    function hubWindowOver(d) {
      return d.get('assignedAt', null) != null && request.time >= d.assignedAt + duration.value(10, 's');
    }
    function hubRatingOk(r) {
      return r is map && r.keys().hasOnly(['score', 'comment']) && r.score is int && r.score >= 1 && r.score <= 5
        && r.get('comment', '') is string && r.get('comment', '').size() <= 200;
    }
    // 배차된 회원 정보(등록자에게 보이는 차주 카드)는 본인 회원 문서와 똑같아야 — 인증·차량을 꾸며 넣을 수 없게
    function hubMatchOk(d) {
      let me = hubMe();
      return d.get('takerUid', '') == request.auth.uid
        && d.get('role', '') == me.get('role', '') && d.get('source', '') == me.get('source', '')
        && d.get('name', '') == me.get('name', '') && d.get('phone', '') == me.get('phone', '')
        && d.get('companyName', '') == me.get('companyName', '')
        && d.get('vehicle', null) == me.get('vehicle', null)
        && d.get('docsVerified', false) == me.get('docsVerified', false)
        && d.get('bizStatus', '') == me.get('bizStatus', '')
        && d.get('photoPath', '') == me.get('photoPath', '');
    }
    // 운송중 = 확정된 배차(예전 상차완료 단계 문서도 같이)
    function hubMoving(d) {
      return (d.get('status', '') == 'assigned' && d.get('confirmed', false) == true) || d.get('status', '') == 'loaded';
    }
    // 회차 요청(등록자) — 금액은 0원 ~ 운임
    function hubReturnOk(r, fare) {
      return r is map && r.keys().hasOnly(['amount', 'reason', 'status', 'at', 'by'])
        && r.amount is int && r.amount >= 0 && r.amount <= fare
        && r.get('reason', '') is string && r.get('reason', '').size() <= 100
        && r.status == 'proposed' && r.at == request.time && r.by == request.auth.uid;
    }
    match /hubOrders/{id} {
      // 다른 회사는 모집중 오더(공개 칸)만. 지난 오더 · 진행 중 오더는 등록자 · 배차된 회원 · 같은 회사만
      allow read: if hubActive() && (resource.data.get('status', '') == 'open'
        || resource.data.get('posterUid', '') == request.auth.uid
        || resource.data.get('takerUid', '') == request.auth.uid
        || hubSameCo(resource.data));
      allow read: if hubAdmin();
      allow create: if hubCanPost()
        && request.resource.data.keys().hasOnly(hubEditKeys().concat(['v', 'posterUid', 'posterRole', 'posterSource', 'posterCompany', 'posterName', 'posterVerified', 'posterCompanyKey', 'status', 'takerUid', 'takerRole', 'assignedAt', 'cancelCount', 'createdAt']))
        && request.resource.data.get('v', 0) == 3
        && request.resource.data.get('posterUid', '') == request.auth.uid
        && request.resource.data.get('posterRole', '') == hubMe().get('role', '')
        && request.resource.data.get('posterSource', '') == hubMe().get('source', '')
        && request.resource.data.get('posterCompany', '') == hubMe().get('companyName', '')
        && request.resource.data.get('posterName', '') == hubMe().get('name', '')
        && request.resource.data.get('posterVerified', false) == hubMe().get('docsVerified', false)
        && request.resource.data.get('posterCompanyKey', '') == hubMyKey()
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('takerUid', null) == null
        && request.resource.data.get('cancelCount', 0) == 0
        && request.resource.data.get('운임', 0) is number && request.resource.data.get('운임', 0) >= 0 && request.resource.data.get('운임', 0) <= 50000000
        && hubDepositOk(request.resource.data, request.auth.uid)
        && getAfter(/databases/$(database)/documents/hubQuota/$(request.auth.uid)).data.get('lastPostAt', null) == request.time;
      allow update: if
        // ① 등록자 — 모집중 수정 · 오더 취소(확정 뒤 포함 → 전액 환불) · 배차 취소 후 재모집 · 회차 요청 · 계산서 확인 · 평가
        (isSignedIn() && resource.data.get('posterUid', '') == request.auth.uid && (
          (resource.data.status == 'open' && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(hubEditKeys())
            && hubDepositOk(request.resource.data, request.auth.uid)) ||
          (resource.data.status in ['open', 'assigned'] && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])) ||
          (resource.data.status == 'assigned' && request.resource.data.status == 'open'
            && request.resource.data.takerUid == null && request.resource.data.takerRole == null && request.resource.data.assignedAt == null
            && request.resource.data.get('confirmed', false) == false
            && request.resource.data.get('releaseCount', 0) == resource.data.get('releaseCount', 0) + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takerUid', 'takerRole', 'assignedAt', 'confirmed', 'confirmedAt', 'releaseCount', 'lastReleaseReason', 'updatedAt'])) ||
          // 회차 요청(운송중일 때 · 차주가 수락해야 확정)
          (hubMoving(resource.data) && request.resource.data.status == resource.data.status
            && resource.data.get('회차', {}).get('status', '') != 'proposed'
            && hubReturnOk(request.resource.data.get('회차', null), resource.data.get('운임', 0))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['회차', 'updatedAt'])) ||
          // 계산서 확인 + 지급예정일(한 번)
          (resource.data.status == 'delivered' && request.resource.data.status == 'delivered'
            && ('invoice' in resource.data) && !('invoiceOk' in resource.data)
            && request.resource.data.invoiceOk is map && request.resource.data.invoiceOk.keys().hasOnly(['payDate', 'at', 'by'])
            && request.resource.data.invoiceOk.payDate is string && request.resource.data.invoiceOk.payDate.size() == 10
            && request.resource.data.invoiceOk.at == request.time && request.resource.data.invoiceOk.by == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoiceOk', 'updatedAt'])) ||
          (resource.data.status == 'delivered' && request.resource.data.status == 'delivered'
            && !('ratingByPoster' in resource.data) && hubRatingOk(request.resource.data.ratingByPoster)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingByPoster', 'updatedAt'])))) ||
        // ② 배차신청 — 모집중일 때 먼저 쓴 1명만(두 번째 신청은 이미 assigned라 거절된다 = 중복 배차 방지)
        (hubCanTake() && resource.data.get('posterUid', '') != request.auth.uid
          && resource.data.status == 'open' && request.resource.data.status == 'assigned'
          && request.resource.data.takerUid == request.auth.uid
          && request.resource.data.takerRole == hubMe().get('role', '')
          && request.resource.data.assignedAt == request.time
          && resource.data.get('cancelCount', 0) < 5
          && hubDepositOk(resource.data, resource.data.get('posterUid', ''))
          && request.resource.data.get('confirmed', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takerUid', 'takerRole', 'assignedAt', 'updatedAt'])
          && getAfter(/databases/$(database)/documents/hubOrders/$(id)/private/match).data.get('takerUid', '') == request.auth.uid) ||
        // ③ 신청한 회원의 10초 안 취소 — 서버 시각(request.time) 기준, 그 뒤엔 등록자에게 전화로
        (isSignedIn() && resource.data.status == 'assigned' && resource.data.get('takerUid', '') == request.auth.uid
          && request.time < resource.data.assignedAt + duration.value(10, 's')
          && resource.data.get('confirmed', false) != true
          && request.resource.data.status == 'open' && request.resource.data.takerUid == null
          && request.resource.data.takerRole == null && request.resource.data.assignedAt == null
          && request.resource.data.get('cancelCount', 0) == resource.data.get('cancelCount', 0) + 1
          && request.resource.data.get('lastCancelUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takerUid', 'takerRole', 'assignedAt', 'cancelCount', 'lastCancelUid', 'lastCancelAt', 'updatedAt'])) ||
        // ⑥ 10초가 지나면 배차된 회원 또는 등록자 화면이 "확정" 표시(서버 시각으로 10초 경과 확인) — 확정 = 운송중
        (isSignedIn() && (resource.data.get('takerUid', '') == request.auth.uid || resource.data.get('posterUid', '') == request.auth.uid)
          && resource.data.status == 'assigned' && request.resource.data.status == 'assigned'
          && resource.data.get('confirmed', false) != true && hubWindowOver(resource.data)
          && hubDepositOk(resource.data, resource.data.get('posterUid', ''))
          && request.resource.data.get('confirmed', false) == true && request.resource.data.get('confirmedAt', null) == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'confirmedAt', 'updatedAt'])) ||
        // ④ 배차된 회원 — 운송중 → [운송완료](인수증은 지금 또는 나중에)
        (isSignedIn() && resource.data.get('takerUid', '') == request.auth.uid && hubWindowOver(resource.data) && hubDeviceOk()
          && hubMoving(resource.data) && request.resource.data.status == 'delivered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'podPath', 'pod', 'podAt', 'updatedAt'])
          && hubPodOk(request.resource.data.get('pod', []))) ||
        // ④-2 배차된 회원 — 회차 수락(금액 그대로 · 운송 끝) / 거절
        (isSignedIn() && resource.data.get('takerUid', '') == request.auth.uid && hubMoving(resource.data)
          && resource.data.get('회차', {}).get('status', '') == 'proposed'
          && request.resource.data.get('회차', {}).get('amount', -1) == resource.data.get('회차', {}).get('amount', -2)
          && request.resource.data.get('회차', {}).keys().hasOnly(['amount', 'reason', 'status', 'at', 'by', 'answeredAt'])
          && request.resource.data.get('회차', {}).get('answeredAt', null) == request.time
          && ((request.resource.data.get('회차', {}).get('status', '') == 'accepted' && request.resource.data.status == 'delivered'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['회차', 'status', 'deliveredAt', 'updatedAt'])) ||
              (request.resource.data.get('회차', {}).get('status', '') == 'rejected' && request.resource.data.status == resource.data.status
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['회차', 'updatedAt'])))) ||
        // ⑦ 배차된 회원 — 운송완료 뒤 인수증 · 전표 올리기(늘리기만)
        (isSignedIn() && resource.data.get('takerUid', '') == request.auth.uid && resource.data.status == 'delivered'
          && request.resource.data.status == 'delivered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pod', 'podPath', 'podAt', 'updatedAt'])
          && hubPodOk(request.resource.data.get('pod', []))
          && request.resource.data.get('pod', []).size() > resource.data.get('pod', []).size()) ||
        // ⑧ 배차된 회원 — 계산서(세금계산서) 등록(1번) → 등록자가 확인하고 지급예정일을 정한다
        (isSignedIn() && resource.data.get('takerUid', '') == request.auth.uid && resource.data.status == 'delivered'
          && request.resource.data.status == 'delivered' && !('invoice' in resource.data)
          && hubInvoiceOk(request.resource.data.invoice)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoice', 'updatedAt'])) ||
        // ⑤ 배차된 회원의 평가(1번)
        (isSignedIn() && resource.data.get('takerUid', '') == request.auth.uid
          && resource.data.status == 'delivered' && request.resource.data.status == 'delivered'
          && !('ratingByTaker' in resource.data) && hubRatingOk(request.resource.data.ratingByTaker)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingByTaker', 'updatedAt'])) ||
        hubAdmin();
      allow delete: if (isSignedIn() && resource.data.get('posterUid', '') == request.auth.uid && resource.data.status in ['open', 'cancelled']) || hubAdmin();

      // detail(상세주소·연락처) · match(배차된 회원 정보) · settle_{uid}(각자 정산 메모)
      match /private/{docId} {
        allow read: if isSignedIn() && hubPrivReadOk(hubOrd(id), docId);
        allow read: if hubAdmin();
        allow create, update: if isSignedIn() && (
          (docId == 'detail' && hubOrdAfter(id).get('posterUid', '') == request.auth.uid) ||
          (docId == 'match' && hubOrdAfter(id).get('takerUid', '') == request.auth.uid
            && hubOrdAfter(id).get('status', '') == 'assigned' && hubMatchOk(request.resource.data)) ||
          (docId == 'settle_' + request.auth.uid && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
            && (hubOrdAfter(id).get('posterUid', '') == request.auth.uid || hubOrdAfter(id).get('takerUid', '') == request.auth.uid)));
        // ⭐ 2026-11-06 최고관리자 — 상세주소 · 연락처까지 고칠 수 있다(관리자 콘솔 오더 편집, 정산 메모는 제외)
        allow create, update: if hubAdmin() && docId in ['detail', 'match'];
        allow delete: if hubAdmin() || (isSignedIn() && (
          hubOrd(id).get('posterUid', '') == request.auth.uid ||
          (docId == 'match' && resource.data.get('takerUid', '') == request.auth.uid)));
      }
    }
    // ⭐ 2026-11-07 고객관리(허브 전용 회원의 상·하차지) — 같은 회사 키끼리만 읽고 고친다(다른 회사는 절대 못 본다)
    function hubPlaceOk(d) {
      return d.keys().hasOnly(['companyKey', 'uid', '이름', '주소', '담당자', '연락처', '시도', '시군구', 'count', 'lastUsedAt', 'updatedAt', 'createdAt'])
        && d.get('주소', '') is string && d.get('주소', '').size() >= 2 && d.get('주소', '').size() <= 200
        && d.get('이름', '') is string && d.get('이름', '').size() <= 60;
    }
    match /hubPlaces/{id} {
      allow read, delete: if hubActive() && resource.data.get('companyKey', '') == hubMyKey();
      allow create: if hubActive() && request.resource.data.get('companyKey', '') == hubMyKey()
        && request.resource.data.get('uid', '') == request.auth.uid && hubPlaceOk(request.resource.data);
      allow update: if hubActive() && resource.data.get('companyKey', '') == hubMyKey()
        && request.resource.data.get('companyKey', '') == resource.data.get('companyKey', '') && hubPlaceOk(request.resource.data);
      allow read, write: if hubAdmin();
    }
    // 허브 알림 — 받는 사람만. 보내기는 승인 회원이 자기 이름으로, 그 오더의 등록자에게 또는 등록자가 보낼 때만(스팸 방지)
    match /hubNotices/{id} {
      allow read, delete: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if hubActive()
        && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('toUid', '') is string && request.resource.data.get('toUid', '') != request.auth.uid
        && request.resource.data.get('read', true) == false
        && (hubOrd(request.resource.data.get('orderId', '_')).get('posterUid', '') == request.resource.data.get('toUid', '')
            || hubOrd(request.resource.data.get('orderId', '_')).get('posterUid', '') == request.auth.uid);
    }
    // ⭐ 위치관제 — 확정(= 운송중) ~ 운송완료 전까지만 배차된 회원이 쓰고, 등록자(+관리자)만 그동안 본다.
    //  운송완료 · 회차 · 취소되면 아무도 못 읽는다(서버가 문서도 지운다). 이동 경로는 track 하위 문서.
    function hubLiveRead(id) {
      let o = hubOrd(id);
      return isSignedIn() && hubMoving(o)
        && (o.get('posterUid', '') == request.auth.uid || o.get('takerUid', '') == request.auth.uid || hubAdmin());
    }
    function hubLiveWrite(id) {
      let o = hubOrd(id);
      return isSignedIn() && o.get('takerUid', '') == request.auth.uid && hubMoving(o) && hubDeviceOk();
    }
    // ⭐ 2026-11-07 허브 차주 등록 기기 — 서버 함수만 쓴다. 본인 · 관리자만 읽는다(앱 시작 때 이 기기가 맞는지 화면이 비교)
    match /hubDevices/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || hubAdmin());
      allow list: if hubAdmin();
      allow write: if false;
    }
    match /hubLive/{orderId} {
      allow read: if hubLiveRead(orderId);
      allow create, update: if hubLiveWrite(orderId)
        && request.resource.data.keys().hasOnly(['orderId', 'takerUid', 'posterUid', 'lat', 'lng', 'speed', 'accuracy', 'heading', 'updatedAt', 'plate', 'name', 'phone', 'status', 'source', 'lastTrack', 'lastTrackAt'])
        && request.resource.data.get('takerUid', '') == request.auth.uid
        && request.resource.data.get('orderId', '') == orderId
        && request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.get('updatedAt', null) == request.time;
      allow delete: if hubAdmin();
      match /track/{pid} {
        allow read: if hubLiveRead(orderId);
        allow create: if hubLiveWrite(orderId)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'speed', 'accuracy', 'timestamp', 'source'])
          && request.resource.data.lat is number && request.resource.data.lng is number
          && request.resource.data.get('timestamp', null) == request.time;
        allow delete: if hubAdmin();
      }
    }
    // ⭐ 2026-11-06 예치금 · 정산 원장 — 잔액 · 원장 · 미정산 · 지급 대기열은 서버 함수만 쓴다(functions/hubWallet.js). 회원 본인만 읽는다
    match /hubWallets/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || hubAdmin());
      allow list: if hubAdmin();
      allow write: if false;
    }
    match /hubLedger/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || hubAdmin());
      allow write: if false;
    }
    match /hubDebts/{id} {
      allow read: if isSignedIn() && (resource.data.get('fromUid', '') == request.auth.uid || resource.data.get('toUid', '') == request.auth.uid || hubAdmin());
      allow write: if false;
    }
    // 충전 [입금 확인 요청] — 가상계좌 자동 반영 전까지. 관리자가 [입금 확인] → 서버가 예치금에 넣는다
    match /hubCharges/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || hubAdmin());
      allow create: if hubActive() && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'companyName', 'amount', 'depositor', 'status', 'memo', 'createdAt'])
        && request.resource.data.get('status', '') == 'requested'
        && request.resource.data.amount is int && request.resource.data.amount >= 10000 && request.resource.data.amount <= 100000000
        && request.resource.data.get('depositor', '') is string && request.resource.data.get('depositor', '').size() <= 40
        && request.resource.data.get('createdAt', null) == request.time;
      allow update: if (hubAdmin() && resource.data.get('status', '') == 'requested'
          && request.resource.data.get('status', '') in ['confirmed', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'confirmedBy', 'rejectReason', 'updatedAt'])) ||
        (isSignedIn() && resource.data.get('uid', '') == request.auth.uid && resource.data.get('status', '') == 'requested'
          && request.resource.data.get('status', '') == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if false;
    }
    // 운송료 지급 — 서버가 만들고(계산서 확인), 지급예정일에 지급 요청. 수동 모드: 관리자 또는 등록자가 이체 후 [지급완료]
    match /hubPayouts/{id} {
      allow read: if isSignedIn() && (resource.data.get('toUid', '') == request.auth.uid || resource.data.get('fromUid', '') == request.auth.uid || hubAdmin());
      allow update: if hubAdmin() && resource.data.get('status', '') != 'paid'
        && request.resource.data.get('status', '') in ['scheduled', 'queued', 'requested', 'paid', 'failed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'memo', 'requestedAt', 'requestedBy', 'dueDate', 'updatedAt']);
      allow update: if isSignedIn() && resource.data.get('fromUid', '') == request.auth.uid
        && resource.data.get('status', '') in ['scheduled', 'requested']
        && request.resource.data.get('status', '') == 'paid' && request.resource.data.get('paidAt', null) == request.time
        && request.resource.data.get('paidBy', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'memo', 'updatedAt']);
      allow create, delete: if false;
    }
    // ⭐ 2026-11-07 출금(사용 가능 예치금 → 본인 실계좌) — 계좌는 회원 문서에 등록한 그 계좌만
    match /hubWithdrawals/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || hubAdmin());
      allow create: if hubActive() && hubHasBank() && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'amount', 'bank', 'status', 'createdAt'])
        && request.resource.data.status == 'requested'
        && request.resource.data.amount is int && request.resource.data.amount >= 10000
        && request.resource.data.amount <= hubWalletAvail(request.auth.uid)
        && request.resource.data.bank == hubMe().bank
        && request.resource.data.createdAt == request.time;
      allow update: if hubAdmin() && resource.data.get('status', '') in ['requested', 'processing']
        && request.resource.data.get('status', '') in ['paid', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'rejectReason', 'updatedAt']);
      allow delete: if false;
    }
    // ⭐ 2026-11-07 배차 프로그램 [저장 + 허브 등록] — 같은 회사 직원이 자기 회사 오더만 요청(서버가 확인하고 허브 오더를 만든다)
    match /hubPostRequests/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', '') == request.auth.uid || hubAdmin());
      allow create: if isApproved() && request.resource.data.get('uid', '') == request.auth.uid
        && !(myRole() in ['driver', 'shipper', 'cafeUser', 'viewer'])
        && (request.resource.data.get('companyName', '') == myCoRaw() || isTotalMasterUser())
        && request.resource.data.get('status', '') == 'requested'
        && request.resource.data.get('lwOrderId', '') is string && request.resource.data.get('lwOrderId', '').size() > 0
        && request.resource.data.keys().hasOnly(['uid', 'companyName', 'lwOrderId', 'order', 'status', 'createdAt']);
      allow update, delete: if false;
    }
    // 관리자 예치금 조정(+/−) — 서버가 원장에 반영
    match /hubAdjustments/{id} {
      allow read: if hubAdmin();
      allow create: if hubAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'amount', 'bucket', 'memo', 'by', 'createdAt'])
        && request.resource.data.amount is int && request.resource.data.amount != 0
        && request.resource.data.get('bucket', 'available') in ['available', 'owed'];
      allow update, delete: if false;
    }
    // 허브 설정(기본 수수료 · 입금 계좌 · 차종/톤수/결제/상하차 방법 목록) · 공지 — 읽기는 로그인 회원, 쓰기는 관리자
    match /hubSettings/{id} {
      allow read: if isSignedIn();
      allow write: if hubAdmin();
    }
    match /hubAnnouncements/{id} {
      allow read: if hubActive() || hubAdmin();
      allow write: if hubAdmin();
    }
    // 노쇼 · 허위 등록 신고 — 신고자 + 관리자
    match /hubReports/{id} {
      allow create: if hubActive() && request.resource.data.get('reporterUid', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'open';
      allow read: if hubAdmin() || (isSignedIn() && resource.data.get('reporterUid', '') == request.auth.uid);
      allow update, delete: if hubAdmin();
    }

    // ────────────────────────────────────────────────────────────
    // 프로그램 전역 설정 — 최고관리자만 설정/열람 가능(요청사항).
    // 단 siteConfig/landing(로그인 전 랜딩페이지 커스터마이징)은 그 페이지 자체가
    // 로그인 없이 열리므로 읽기만은 누구나 가능해야 한다 — 그래야 방문자 화면에
    // 실제로 반영된다. 쓰기는 여기도 최고관리자만.
    // ────────────────────────────────────────────────────────────
    match /siteConfig/landing {
      allow get: if true;
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    // siteConfig/labels(프로그램 전체 편집모드의 글자 오버라이드)는 전체 사용자
    // 화면에 반영돼야 하니 읽기는 로그인한 사용자 전체 허용, 쓰기(=편집)만
    // 최고관리자로 제한한다 — landing과 같은 이유의 예외.
    match /siteConfig/labels {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    // ⭐ 2026-11-06 문구 편집 모드(src/textOverrides.js) — 화면 글자 덮어쓰기 사전.
    //  읽기: 로그인한 사용자 전체(기사·화주 포함 — 그들 화면에도 반영) · 쓰기: 최고관리자(부관리자 포함)만.
    //  textOverridesPublic은 로그인 전 화면(로그인·기사 로그인 등)용 사본이라 누구나 읽기만 가능.
    match /textOverrides/{id} {
      allow read: if isSignedIn();
      allow write: if isTotalMasterUser();
    }
    match /textOverridesPublic/{id} {
      allow read: if true;
      allow write: if isTotalMasterUser();
    }
    // ⭐ 2026-11-07 화면 편집 모드(src/uiConfig.js) — 숨기기·모양·이미지·안내 상자·메뉴·목록·입력칸·테마 한 묶음.
    //  읽기: 누구나(로그인 전 화면의 로고·안내도 바꿀 수 있게 · 비밀 정보 없음) · 쓰기: 최고관리자만 + 모양 검사(값 자체는 앱이 화이트리스트로 다시 검사)
    function uiConfigOk(d) {
      return d.keys().hasOnly(['v', 'els', 'blocks', 'menus', 'opts', 'fields', 'theme', 'rev', 'updatedAt', 'by', 'byUid'])
        && d.get('v', 1) is int
        && d.get('els', {}) is map && d.get('els', {}).size() <= 400
        && d.get('blocks', {}) is map && d.get('blocks', {}).size() <= 100
        && d.get('menus', {}) is map && d.get('menus', {}).size() <= 300
        && d.get('opts', {}) is map && d.get('opts', {}).size() <= 10
        && d.get('fields', {}) is map && d.get('fields', {}).size() <= 300
        && (d.get('theme', null) == null || d.get('theme', null) is map)
        && d.get('rev', 0) is int
        && d.get('by', '') is string && d.get('by', '').size() <= 120
        && d.get('byUid', '') == request.auth.uid;
    }
    match /uiConfig/{id} {
      allow read: if true;
      allow create, update: if isTotalMasterUser() && id == 'main' && uiConfigOk(request.resource.data);
      allow delete: if isTotalMasterUser();
    }
    //  저장할 때마다 남기는 사본(최근 20개 · 되살리기용) — 최고관리자만
    match /uiConfigHistory/{id} {
      allow read, delete: if isTotalMasterUser();
      allow create: if isTotalMasterUser() && request.resource.data.keys().hasOnly(['cfg', 'by', 'byUid', 'at', 'atMs', 'rev', 'note', 'n'])
        && request.resource.data.cfg is map && request.resource.data.byUid == request.auth.uid;
      allow update: if false;
    }
    // 💼 영업 견적(관리센터 › 영업) — 최고관리자만
    match /salesQuotes/{id} {
      allow read, write: if isTotalMasterUser();
    }
    // ✍ 전자계약 — 계약 ID(추측 불가 18자)를 아는 사람만 한 건씩 열람(get) 가능, 목록은 최고관리자만.
    //  고객(로그인 없음)은 "발송" 상태일 때 ① 처음 열람 시각(viewedAt) 또는 ② 서명 관련 칸만 채워 "서명완료"로 바꿀 수 있다.
    match /contracts/{id} {
      allow get: if true;
      allow list, create, delete: if isTotalMasterUser();
      allow update: if isTotalMasterUser()
        || (resource.data.status == '발송'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
            && !('viewedAt' in resource.data))
        || (resource.data.status == '발송'
            && request.resource.data.status == '서명완료'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt', 'signer', 'signatureImg', 'signerAgent', 'signedHash', 'consent'])
            && request.resource.data.signatureImg is string
            && request.resource.data.signatureImg.size() < 600000);
    }
    // 📢 플랫폼 공지(관리센터 → 고객사 배너 + 운송사 공지사항 목록) — 최고관리자 쓰기
    // ⭐ 2026-11-02 관리자센터2 — 대상별 읽기: 전체/전체 운송사/전체 화주사 공지는 로그인 사용자 누구나,
    //  "선택한 운송사" 공지(audience 'selected')는 targetCompanies에 내 회사가 있을 때만.
    //  앱 조회: where(audience in [...]) 와 where(targetCompanies array-contains 우리 회사) 두 가지 — 둘 다 이 규칙으로 증명된다.
    match /platformNotices/{id} {
      allow read: if isTotalMasterUser()
        || (isSignedIn() && (resource.data.audience in ['all', 'carrier', 'shipper']
            || myCo() in resource.data.targetCompanies));
      allow write: if isTotalMasterUser();
      // ⭐ 2026-11-03 조회수 — 승인된 사용자는 본 사람 목록(viewedBy)만 더할 수 있다(한 계정 1회)
      allow update: if isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
    }
    // 🧾 플랫폼 청구·입금 기록 — 최고관리자는 전부, 고객사는 자기 회사 청구서만 읽고 "입금 알림(payNotice)"만 남길 수 있다
    // ⭐ 2026-11-03 구독·결제 권한(src/billingAccess.js와 같은 기준) — 보기: 경리팀·재무·임원·대표 / 입금 알림: 경리팀·재무만
    function isBillingFinance() {
      return myRole() in ['test', 'hrAcct', 'allMgr', 'acctStaff'] || myTeamFin();
    }
    function isBillingViewer() {
      return isBillingFinance() || isExecProfileUser();
    }
    match /platformInvoices/{id} {
      allow read: if isTotalMasterUser()
        || (isApproved() && resource.data.company == myCoRaw() && isBillingViewer());
      allow write: if isTotalMasterUser();
      allow update: if isApproved()
        && resource.data.company == myCoRaw()
        && isBillingFinance()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payNotice']);
    }
    // 💳 회사별 요금제 — 로그인 사용자는 읽기(메뉴 잠금 판단), 지정은 최고관리자만
    // 🏢 가입 화면용 공개 운송사 목록(이름·주소) — 로그인 전에도 읽는다
    //  ⭐ 2026-11-07 보안 — 다른 회사 항목을 덮어쓰거나 지우지 못하게(고치기는 같은 회사 이름의 항목만)
    match /publicCompanies/{id} {
      allow read: if true;
      allow create: if isTotalMasterUser() || (isApproved() && !isShipperUser() && request.resource.data.get('companyName', '') == myCoRaw());
      allow update: if isTotalMasterUser() || (isApproved() && !isShipperUser() && request.resource.data.get('companyName', '') == myCoRaw()
        && resource.data.get('companyName', '') == myCoRaw());
      allow delete: if isTotalMasterUser();
    }
    //  ⭐ 2026-11-07 보안 — 한 건 조회는 우리 회사(화주는 연동 운송사) 것만 · 전체 목록은 최고관리자만(예전엔 로그인한 누구나 모든 회사 요금제·계약 상태)
    match /companyPlans/{company} {
      allow get: if isTotalMasterUser() || (isSignedIn() && (ck() || exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        && (myCo() == company || myLinkedCo() == company));
      allow list: if isTotalMasterUser();
      allow write: if isTotalMasterUser();
    }
    // 💳 공개 요금(가격·포함량·입금 계좌) — 고객사 화면의 요금 비교·결제 안내용
    match /publicPricing/{id} {
      allow read: if isSignedIn();
      allow write: if isTotalMasterUser();
    }
    // 💳 요금제 변경 요청 — 고객사는 자기 회사 이름으로만 만들 수 있고, 처리는 최고관리자
    match /planRequests/{id} {
      // ⭐ 2026-11-01 요금제 변경 요청은 경리팀(경리·경리+인사·경리/회계 부서)만 · 2026-11-03 재무 부서 · 최고관리자 추가(임원·대표는 보기만)
      allow create: if isTotalMasterUser() || (isApproved() && request.resource.data.company == myCoRaw() && isBillingFinance());
      allow read, update, delete: if isTotalMasterUser();
    }
    match /siteConfig/{docId} {
      allow get, list: if isTotalMasterUser();
      allow write: if isTotalMasterUser();
    }
    // 💰 2026-11-04 플랫폼 비용·손익 — 비용 기준(단가·무료량·고정비)은 최고관리자만. 고객사에는 절대 보이지 않게.
    match /platformConfig/{docId} {
      allow read, write: if isTotalMasterUser();
    }
    // 🤖 2026-11-06 AI 팀 사용 기록 — 쓰기는 서버(Cloud Functions)만, 읽기는 최고관리자·부관리자만
    match /aiTeamLogs/{docId} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 🛡 2026-11-09 보안 이벤트(이상 접속·대량 다운로드·퇴사자 차단) — 기록은 서버(securityPing·퇴사 트리거)만,
    //  최고관리자·부관리자는 보고 "확인 처리(ack·ackBy·ackAt)"만 할 수 있다 · 사람별 판정 기준(securityProfiles)은 서버만
    match /securityEvents/{docId} {
      allow read: if isTotalMasterUser();
      allow update: if isTotalMasterUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ack', 'ackBy', 'ackAt']);
      allow create, delete: if false;
    }
    match /securityProfiles/{uid} {
      allow read, write: if false;
    }
    // 🧯 2026-11-10 오류 신고(오류 화면의 [오류 보내기]) — 보내기는 로그인한 누구나(본인 uid로 · 크기 제한),
    //  보기·처리완료·삭제는 최고관리자(관리센터 › 보안·데이터 › 오류 신고)만 · 보낸 사람도 다시 못 읽는다
    match /errorReports/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'companyName', 'section', 'message', 'stack', 'url', 'ua', 'version', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.get('stack', '') is string && request.resource.data.get('stack', '').size() <= 4000
        && request.resource.data.get('url', '').size() <= 300 && request.resource.data.get('ua', '').size() <= 300
        && request.resource.data.get('section', '').size() <= 80 && request.resource.data.get('companyName', '').size() <= 80
        && request.resource.data.get('name', '').size() <= 60 && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.get('role', '').size() <= 30 && request.resource.data.get('version', '').size() <= 30;
      allow read, delete: if isTotalMasterUser();
      allow update: if isTotalMasterUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneBy', 'doneAt', 'memo'])
        && request.resource.data.status in ['new', 'done'];
    }
    // 서버 사용량(Cloud Monitoring 수집 결과) — 쓰기는 서버(Cloud Functions)만, 읽기는 최고관리자만
    match /platformUsage/{docId} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 회사별 사용량 표본(앱이 10분마다 increment) — 승인된 같은 회사 직원·기사는 자기 회사 문서의 숫자 칸만 늘릴 수 있다. 읽기는 최고관리자만
    match /usageCounters/{docId} {
      allow read, delete: if isTotalMasterUser();
      allow create: if isApproved() && !isShipperUser()
        && request.resource.data.get('company', '') == myCo()
        && request.resource.data.get('month', '') is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['company', 'month', 'reads', 'writes', 'sessions', 'updatedAt'])
        && request.resource.data.get('reads', 0) is number && request.resource.data.get('reads', 0) < 5000000
        && request.resource.data.get('writes', 0) is number && request.resource.data.get('writes', 0) < 1000000;
      allow update: if isApproved() && !isShipperUser()
        && resource.data.get('company', '') == myCo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads', 'writes', 'sessions', 'updatedAt'])
        && request.resource.data.get('reads', 0) >= resource.data.get('reads', 0)
        && request.resource.data.get('writes', 0) >= resource.data.get('writes', 0)
        && request.resource.data.get('sessions', 0) >= resource.data.get('sessions', 0)
        && request.resource.data.get('reads', 0) - resource.data.get('reads', 0) < 5000000
        && request.resource.data.get('writes', 0) - resource.data.get('writes', 0) < 1000000;
    }

    // ────────────────────────────────────────────────────────────
    // 가입 진행 중(승인 전) 계정에 필요한 최소 권한 — 승인된 계정은 기존과 동일
    // ────────────────────────────────────────────────────────────
    // ⭐ 2026-11-01 입사일은 인사팀만 바꾼다(인사관리부 › 직원 정보·퇴사). 가입 때 처음 넣는 것은 허용
    function isHrStaff() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        myRole() in ['hrManager', 'hrAcct', 'allMgr', 'hrStaff', 'totalMaster'] ||
        myTeamHr());
    }
    function hireDateSame() {
      return resource == null ||
        request.resource.data.get('hireDate', '') == resource.data.get('hireDate', '');
    }
    // ════════════════════════════════════════════════════════════
    // 👥 2026-11-07 보안 점검 — 직원 명부(users)·인사 프로필(userProfiles) 운송사별 완전 분리
    //  예전: ① 맨 아래 공용 규칙(/{col}/{rest=**})이 users·userProfiles를 빼지 않아 승인된 누구나 모든 회사 직원 문서를
    //        읽고 고칠 수 있었다(남의 회사 직원 승인·역할 변경·삭제, 내 문서에 다른 회사 이름 넣기까지).
    //       ② 승인된 계정이면 다른 회사 직원 문서도 읽기·수정·삭제 가능.
    //  지금: 읽기 — 본인 · 최고관리자 · 같은 운송사 사람(직원·기사) · 우리 회사에 연동된 화주 · (화주는) 같은 화주사 + 연동 운송사 직원
    //        쓰기 — 본인(회사·연동 운송사·마스터·권한·재직 상태·부서·직책은 못 바꿈) · 같은 회사 관리자급(역할·승인·권한) ·
    //               같은 회사 직원(일반 칸 — 결재 연동·알림 표시 등) · 최고관리자
    //  화면은 목록을 "companyName == 우리 회사"(연동 화주는 linkedTransportCompany.companyName == 우리 회사)로 조회한다(src/fsTenant.js · src/usersLive.js).
    // ════════════════════════════════════════════════════════════
    function linkedCoOf(d) {
      return d.get('linkedTransportCompany', null) is map ? d.get('linkedTransportCompany', {}).get('companyName', '') : '';
    }
    // 이 사람(d)의 users 문서를 볼 수 있는가
    function userVisible(d) {
      return isTotalMasterUser() || (isApproved() && (
        (!isShipperUser() && (d.get('companyName', '돌캐') == myCo() || linkedCoOf(d) == myCo())) ||
        (isShipperUser() && (d.get('companyName', '') == myCo()
          || (myLinkedCo() != '' && d.get('companyName', '') == myLinkedCo())))));
    }
    // 내가 관리할 수 있는 범위의 사람 — 같은 운송사 직원·기사 / 우리 회사에 연동된 화주 / (화주사 계정은) 같은 화주사 사람
    //  (규칙 계산 한도 1,000개 때문에 내 문서·역할·회사를 한 번만 읽어 넘긴다)
    function scopeOf(d, co, shipper) {
      return (!shipper && ((d.get('role', '') != 'shipper' && d.get('companyName', '돌캐') == co)
          || (d.get('role', '') == 'shipper' && linkedCoOf(d) == co)))
        || (shipper && d.get('role', '') == 'shipper' && d.get('companyName', '') == co);
    }
    function userInMyScope(d) {
      return isApproved() && !(myRole() in ['driver', 'cafeUser', 'viewer'])
        && scopeOf(d, myCo(), myRole() == 'shipper');
    }
    // 역할·승인·권한·회사를 바꿀 수 있는 사람(회사 관리자급 · 인사 · 회사 마스터 · 화주사 마스터 · 임원 역할) — isCompanyAdmin · isHrStaff와 같은 기준
    function mgrOf(me) {
      let r = me.get('role', '');
      return me.get('isMaster', false) == true || r in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'hrStaff', 'totalMaster']
        || (r == 'shipper' && me.get('permissions', {}).get('master', false) == true)
        || string(me.get('team', '')).matches('.*인사.*') || isExecRoleUser();
    }
    function userManager() {
      return ck()
        ? (tk('ms', false) == true || tk('r', '') in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'hrStaff', 'totalMaster']
          || (tk('r', '') == 'shipper' && tk('pm', false) == true) || tk('hr', false) == true || tk('exec', false) == true)
        : mgrOf(myUser());
    }
    function userSensitiveKeys() {
      return ['role', 'approved', 'isMaster', 'permissions', 'subAdmin', 'subAdminPrevRole', 'companyName', 'linkedTransportCompany', 'companyCode', 'businessNumber'];
    }
    function otherUserWriteOk() {
      let r = myRole();
      let co = myCo();
      let shipper = r == 'shipper';
      let after = request.resource.data;
      let aff = resource == null ? after.keys() : after.diff(resource.data).affectedKeys();
      return isApproved() && !(r in ['driver', 'cafeUser', 'viewer'])
        && (resource == null || scopeOf(resource.data, co, shipper)) && scopeOf(after, co, shipper)
        && (!aff.hasAny(userSensitiveKeys())
          // 기사 승인·승인 해제(기사관리 · 기사 계정) — 같은 회사 사무 직원, 역할은 기사 그대로
          || (!shipper && after.get('role', '') == 'driver' && (resource == null || resource.data.get('role', '') == 'driver')
              && !aff.hasAny(['role', 'isMaster', 'permissions', 'subAdmin', 'subAdminPrevRole', 'companyName', 'linkedTransportCompany', 'companyCode']))
          || userManager());
    }
    // 본인 문서 — 이미 승인된 계정은 회사·연동 운송사·마스터·권한·재직 상태를 스스로 못 바꾼다
    //  (예전엔 승인된 직원이 자기 companyName을 다른 회사로 바꾸면 그 회사 데이터가 바로 열렸다 · 퇴사 처리를 스스로 되돌릴 수 있었다)
    //  운송사 직원은 부서·직책도(경리·인사·임원 권한이 부서/직책 이름으로 정해진다) — 인사·관리자는 예외
    function selfKeepOk() {
      return resource == null || resource.data.get('approved', true) == false || isTotalMasterUser()
        || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyName', 'linkedTransportCompany', 'permissions', 'subAdmin', 'subAdminPrevRole', 'employmentStatus', 'companyCode', 'resignedAt'])
          // ⭐ 2026-11-09 마스터 위임 — 본인 마스터는 "내려놓기(true → false)"만 스스로 할 수 있다(예전엔 막혀 위임 후 마스터가 2명 남았다)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isMaster']) || request.resource.data.get('isMaster', false) == false)
          && (resource.data.get('role', '') in ['shipper', 'cafeUser'] || isHrStaff() || isCompanyAdmin(myCo())
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['team', 'position'])));
    }
    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || userVisible(resource.data);
      allow list: if userVisible(resource.data);
      allow create, update: if isSignedIn() && (
        isTotalMasterUser() ||
        (request.auth.uid != userId && otherUserWriteOk()) ||
        (selfUserWriteOk(userId) && selfKeepOk())
      ) && (hireDateSame() || isHrStaff()) && roleEscalationOk();
      allow delete: if isTotalMasterUser() || (resource != null && request.auth.uid != userId && userInMyScope(resource.data)
        && (resource.data.get('role', '') == 'driver' || userManager()));
    }
    // 인사 프로필(입사일·연차 조정·명함·증명서 발급 기록) — 문서에 회사명이 없어 users/{uid}의 회사로 확인한다.
    //  한 건 조회(get)만 같은 회사 사무 직원에게 열고, 목록(list)은 최고관리자(또는 companyName이 적힌 문서는 같은 회사)만.
    //  화면은 회사 직원 uid마다 문서를 따로 읽는다(src/userProfilesLive.js).
    function profileOwnerCo(userId) {
      let p = /databases/$(database)/documents/users/$(userId);
      return exists(p) ? get(p).data.get('companyName', '돌캐') : '';
    }
    function profileStaffOk(userId) {
      return isTotalMasterUser() || (isOfficeStaff() && profileOwnerCo(userId) == myCo());
    }
    match /userProfiles/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || profileStaffOk(userId);
      allow list: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '') == myCo());
      allow create, update: if ((isSignedIn() && request.auth.uid == userId) || profileStaffOk(userId)) &&
        (hireDateSame() || isHrStaff());
      allow delete: if profileStaffOk(userId);
    }
    // 기사 본인 서류(가입 때 사업자등록증 등) — 본인이 올리고 본인이 본다(직원은 아래 공용 규칙)
    match /driver_documents/{id} {
      allow create: if isSignedIn() && request.resource.data.get('driverId', '') == request.auth.uid;
      allow read: if isSignedIn() && resource.data.get('driverId', '') == request.auth.uid;
    }
    // 직원 쪽 읽기·쓰기는 아래 기사 기록 공용 규칙(looseRead)
    // ⭐ 2026-11-08 보안 — 한 건 읽기는 ① 기사 본인(문서 이름이 내 uid이거나 uid 칸이 나) ② 같은 회사 사무 직원(기사·화주 제외)
    //  ③ 최고관리자만. 예전엔 기사앱 로그인/가입이 선등록 문서(drivers/{차량번호})를 화면에서 읽느라 "로그인한 누구나"였다
    //  (허브 가입 계정 등 아무 계정으로 차량번호만 넣으면 다른 회사 기사 이름·전화번호·차량 정보가 보였다).
    //  이제 그 확인은 서버 함수(driverLoginLink · linkDriverSignup)가 한다. 회사명 없는 예전 문서는 기본 회사(돌캐) 것으로 본다.
    function driverDocSelf(driverId) {
      return isSignedIn() && (request.auth.uid == driverId || resource.data.get('uid', '') == request.auth.uid);
    }
    function driverDocStaff() {
      return isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '돌캐') == myCo());
    }
    function driverOdoNoDecrease() {
      let o = resource.data.get('care', {}).get('odometer', 0);
      let n = request.resource.data.get('care', {}).get('odometer', 0);
      return !(o is number) || !(n is number) || o == 0 || n >= o;
    }
    match /drivers/{driverId} {
      allow get: if driverDocSelf(driverId) || driverDocStaff();
      // 🔒 기사·지입차 목록은 같은 운송사만
      allow list: if coMatch(resource.data);
      allow create: if coCreate() || (isSignedIn() && request.auth.uid == driverId);
      // 🚚 2026-11-09 누적 키로수 — 기사 본인은 계기판 키로수(care.odometer)를 줄일 수 없다(처음 입력 · 퇴근 누적 · 퇴근 때 계기판 입력은 늘어나기만).
      //  고치기(줄이기)는 운송사 직원만(위 coMatch 경로)
      allow update: if (coMatch(resource.data) && coKeep() && (myRole() != 'driver' || driverOdoNoDecrease())) || (isSignedIn() && request.auth.uid == driverId && driverOdoNoDecrease());
      // 가입 후 선등록 문서(drivers/{차량번호}) 정리 — 승인 전에는 본인 차량번호 문서만
      // ⭐ 2026-11-02 점검 — 기본 회사가 아닌 운송사의 선등록 문서(회사__차량번호)도 본인이 정리할 수 있게(중복 기사 문서 방지)
      allow delete: if coMatch(resource.data) || (isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myUser().get('carNo', '') is string && myUser().get('carNo', '') != '' &&
        (plateId(myUser().carNo) == driverId ||
         myUser().get('companyName', '').trim() + '__' + plateId(myUser().carNo) == driverId));
    }
    // ⭐ 2026-11-05 기사 가입 승인·거절 처리 기록(거절 사유 등) — 같은 운송사 직원만 보고 남긴다. 고치거나 지울 수 없음
    match /driverSignupLogs/{id} {
      allow read: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // transportApplications · companyApplications — 아래 "보안 점검" 묶음에서 회사별로 정함
    // ⭐ 로그인 관리 — 기기별 로그인 기록. 본인 기록은 승인 전 계정(화주 승인대기 등)도 읽고 쓸 수 있어야
    // 중복 로그인 확인·연결 끊기가 된다. 관리자는 전체(강제 로그아웃).
    match /loginSessions/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // ⭐ 2026-11-07 보안 — 다른 사람 기록은 같은 회사 사무 직원만(예전엔 승인된 누구나 모든 회사 로그인 기록·기기를 봤다)
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isTotalMasterUser()
        || (isOfficeStaff() && resource.data.get('companyName', '') == myCo()));
      // ⭐ 최고관리자의 로그인은 본인 또는 최고관리자만 끊을 수 있다(관리자도 불가)
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isTotalMasterUser() ||
        (isOfficeStaff() && resource.data.get('companyName', '') == myCo()
          && resource.data.get('role', '') != 'totalMaster' && resource.data.get('email', '') != 'tjddnqkf@naver.com')
      );
      allow delete: if isTotalMasterUser();
    }
    // 운송사 초기화 비밀번호(해시) — 서버(Cloud Functions)만 읽고 쓴다
    match /adminSecrets/{id} {
      allow read, write: if false;
    }
    // 초기화 보관함(7일) — 서버만 읽고 쓴다(화면은 서버 함수를 통해 목록·복원)
    match /resetBackups/{document=**} {
      allow read, write: if false;
    }
    // 초기화·복원 진행률 — 최고관리자 화면이 실시간으로 읽는다(쓰기는 서버만)
    // ⭐ 2026-11-07 초기화 잠금(회사당 작업 하나) — 서버 전용
    match /resetLocks/{id} {
      allow read, write: if false;
    }
    match /resetJobs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    match /resetLogs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 📧 사내메일함 — 보낸 사람·받는 사람만 읽고, 받은 사람은 읽음/삭제 표시만 고칠 수 있다.
    match /internalMails/{id} {
      // ⭐ 2026-10-28 메일함 고도화 — status: sent(기본) | draft(임시보관) | scheduled(예약, 서버가 보낼 때 to를 채운다)
      //  임시보관·예약 메일은 to가 비어 있어야 해서 받는 사람이 미리 볼 수 없다.
      allow read: if isApproved() && (request.auth.uid in resource.data.get('to', []) || resource.data.get('fromUid', '') == request.auth.uid);
      allow create: if isApproved() && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('to', []) is list && request.resource.data.get('to', []).size() <= 500
        && (!(request.resource.data.get('status', 'sent') in ['draft', 'scheduled']) || request.resource.data.get('to', []).size() == 0);
      allow update: if isApproved() && (
        (request.auth.uid in resource.data.get('to', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy', 'starredBy', 'purgedBy']))
        || (resource.data.get('fromUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy', 'starredBy', 'purgedBy', 'recalledFor']))
        || (resource.data.get('fromUid', '') == request.auth.uid && resource.data.get('status', 'sent') in ['draft', 'scheduled']
          && request.resource.data.get('fromUid', '') == request.auth.uid && request.resource.data.get('status', 'sent') in ['draft', 'scheduled']
          && request.resource.data.get('to', []).size() == 0));
      allow delete: if isApproved() && resource.data.get('fromUid', '') == request.auth.uid && resource.data.get('status', 'sent') in ['draft', 'scheduled'];
    }
    // 📝 전자결재(2026-10-28) — 기안자·결재자·참조자(participants)만 보고, 관리자는 자기 회사 문서를 모두 본다.
    function isSuperEmail() {
      return request.auth.token.get('email', '') == "tjddnqkf@naver.com"
        // ⭐ 2026-11-05 부관리자 — 최고관리자와 같은 권한(최고관리자 본 계정이 지정: role totalMaster + subAdmin)
        || (isSignedIn() && (!ck() || (tk('tm', false) == true && tk('sa', false) == true))
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && myUser().get('role', '') == 'totalMaster' && myUser().get('subAdmin', false) == true);
    }
    // ⭐ 2026-11-05 다른 사람 계정에 최고관리자·부관리자 권한을 넣는 것은 최고관리자만(직원이 직원에게 올려 주던 구멍 막음)
    function roleEscalationOk() {
      return isTotalMasterUser() || (
        (request.resource.data.get('role', '') != 'totalMaster'
          || (resource != null && resource.data.get('role', '') == 'totalMaster'))
        && request.resource.data.get('subAdmin', false) == (resource == null ? false : resource.data.get('subAdmin', false)));
    }
    function isCompanyAdmin(company) {
      return isTotalMasterUser() ||
        ((myRole() in ['admin', 'allMgr', 'hrManager', 'hrAcct'] || isExecRoleUser()) && myCoRaw() == company);
    }
    // 👔 2026-10-31 권한 관리에서 "임원 화면"으로 정한 역할(직접 만든 역할) — 이름에 '임원'이 들어가고 화면 설정이 없으면 임원으로 본다
    // ⭐ 2026-11-02 점검 — 운송사별 권한(companyRoleOverrides/{회사}.roles)에서 만든 역할·"임원 화면" 지정도 임원으로 본다
    //  (화면의 mergeCompanyRoles + roleScreen과 같은 순서: 회사 설정 값이 공통 역할 값을 덮어쓴다)
    function isExecRoleUser() {
      return ck() ? tk('exec', false) == true : isExecRoleUserDoc();
    }
    function isExecRoleUserDoc() {
      let r = myUser().get('role', '');
      let p = /databases/$(database)/documents/customRoles/$(r);
      let ov = /databases/$(database)/documents/companyRoleOverrides/$(myUser().get('companyName', ''));
      let g = exists(p) ? get(p).data : {};
      let o = exists(ov) ? get(ov).data.get('roles', {}).get(r, {}) : {};
      let scr = ('screen' in o) ? o.get('screen', null) : g.get('screen', null);
      let lbl = o.get('label', '') != '' ? o.get('label', '') : (g.get('label', '') != '' ? g.get('label', '') : r);
      // ⭐ 2026-11-04 새 기본 역할(통합관리자·사무원·법무·개발)은 임원 역할이 아니다
      return r != '' && !(r in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'hrStaff', 'user', 'test', 'acctStaff', 'salesMgr', 'salesStaff', 'legalMgr', 'legalStaff', 'devMgr', 'devStaff', 'viewer', 'totalMaster', 'driver', 'shipper'])
        && (exists(p) || o.size() > 0)
        && (scr is string ? scr == 'exec' : string(lbl).matches('.*임원.*'));
    }
    // 💼 2026-11-01 경리(test)는 회사 결재 중 지출결의·근태(연차)·보고(사직서)만 읽는다 — 장부 가져오기·퇴직 정산·연차 계산
    function isAcctApprovalReader(d) {
      return myRole() in ['test', 'acctStaff'] && myCoRaw() == d.get('company', '')
        && d.get('cat', '') in ['expense', 'leave', 'report'];
    }
    function isExecUser() {
      return myPosExec();
    }
    // ⭐ 2026-11-02 점검 — 결재 문서 수정 규칙 보조 함수(바뀐 필드 / 기안자의 결재 취소 요청 형식 확인)
    function apAff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // 📑 2026-11-08 사업계획서(form "bizplan") 필수 결재선 — 상신할 때 서버에서 한 번 더 본다(화면: src/bizPlan.js validateBizLine)
    //  ① finIdx 번째 결재자 = 같은 회사의 경리·회계·재무 담당(권한 경리·경리사무원 또는 부서에 재무·경리·회계·총무)이고 '합의'
    //  ② 맨 끝 결재자 = 같은 회사의 대표(직책 대표·대표이사·사장)이고 '결재' — 기안자가 대표면 ②는 빠진다
    //  결재자 정보는 결재선에 적힌 값이 아니라 users/{uid} 문서로 확인한다(문서 읽기 2번).
    //  ⚠ "임원 결재 포함"은 회사마다 임원이 없을 수 있어 화면에서만 막는다.
    function apBizLineOk() {
      let d = request.resource.data;
      let n = d.line.size();
      let fi = d.get('finIdx', -1);
      let fin = get(/databases/$(database)/documents/users/$(d.line[fi].uid)).data;
      let ceo = get(/databases/$(database)/documents/users/$(d.line[n - 1].uid)).data;
      return n >= 2 && fi is int && fi >= 0 && fi < n - 1
        && d.line[fi].get('kind', '') == '합의'
        && fin.get('companyName', '') == myCo()
        && (fin.get('role', '') in ['acctStaff', 'test'] || fin.get('team', '').matches('.*(재무|경리|회계|총무).*'))
        && (myUser().get('position', '') in ['대표', '대표이사', '사장']
          || (d.line[n - 1].get('kind', '결재') == '결재'
              && ceo.get('companyName', '') == myCo()
              && ceo.get('position', '') in ['대표', '대표이사', '사장']));
    }
    // 📎 2026-11-08 첨부 파일 정보(files: Storage 경로 목록) — 한 문서 10개까지
    function apFilesOk() {
      return !('files' in request.resource.data) || (request.resource.data.files is list && request.resource.data.files.size() <= 10);
    }
    // 결재 취소 요청 — 승인된 문서에만, 처음 결재자부터 같은 인원으로 시작해야 한다(기안자가 자기 혼자 취소 결재선을 만드는 것 방지)
    function apCancelReqOk() {
      return resource.data.get('status', '') == 'approved'
        && resource.data.get('cancel', {}).get('status', '') != 'pending'
        // ⭐ 2026-11-07 지급완료(paid.at)된 지출결의는 결재 취소 요청 불가 — 경리가 지급완료를 먼저 취소(Approval.jsx cancelBlockedByPaid)
        && !(resource.data.get('cat', '') == 'expense' && resource.data.get('paid', null) != null && resource.data.paid.get('at', null) != null)
        && request.resource.data.cancel.get('status', '') == 'pending'
        && request.resource.data.cancel.get('step', -1) == 0
        && request.resource.data.cancel.line.size() == resource.data.line.size()
        && request.resource.data.cancel.line[0].uid == resource.data.line[0].uid;
    }
    // ⭐ 2026-11-02 점검 — 결재 설정(approvalSettings/{회사}) 전용 규칙: 관리자·임원만 설정을 바꾸고,
    //  일반 직원은 본인 자동 승인 항목만(임원 표시 exec:true·임원 직책은 못 넣음). 일일업무일지 자동 승인은 임원·관리자만
    function isExecProfileUser() {
      return isExecUser() || myTeamExec() || isExecRoleUser();
    }
    function approvalSettingsWriteOk(co) {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let entry = after.get('autoApprovers', {}).get(request.auth.uid, {});
      return isCompanyAdmin(co) || (co == myCo()
        && after.get('autoApprovers', {}).diff(before.get('autoApprovers', {})).affectedKeys().hasOnly([request.auth.uid])
        && ((isExecProfileUser()
              && after.diff(before).affectedKeys().hasOnly(['autoApprovers', 'companyName', 'autoApproveDaily', 'updatedBy', 'updatedAt']))
          || (after.diff(before).affectedKeys().hasOnly(['autoApprovers', 'companyName'])
              && entry.get('exec', false) != true
              && !(entry.get('position', '') is string && entry.get('position', '').trim() in ['이사', '상무', '전무', '부사장', '사장', '대표', '대표이사', '본부장', '임원']))));
    }
    match /approvalSettings/{co} {
      allow read: if coMatch(resource.data);
      allow create: if coCreate() && approvalSettingsWriteOk(co);
      allow update: if coMatch(resource.data) && coKeep() && approvalSettingsWriteOk(co);
      allow delete: if coMatch(resource.data) && isCompanyAdmin(co);
    }
    match /approvals/{id} {
      // 📑 2026-11-08 사업계획서 읽기 — 조회 하나의 규칙 계산 한도(1000)를 넘지 않게 이 두 줄을 맨 앞에, 싼 조건(문서 칸)부터 둔다
      //  ① 같은 회사 사무 직원은 최종 승인된 사업계획서를 읽는다(지출결의 "관련 사업계획" 고르기 · 조회는 company + form "bizplan" + status "approved")
      allow read: if resource.data.get('form', '') == 'bizplan' && resource.data.get('status', '') == 'approved'
        && isOfficeStaff() && resource.data.get('company', '') == myCo();
      //  ② 임원(직책·임원 부서·임원 역할)은 같은 회사 사업계획서 전부와 사업계획에 연결된 지출 문서(planId)를 읽는다(경영 분석 › 사업계획)
      allow read: if (resource.data.get('form', '') == 'bizplan' || resource.data.get('planId', '') != '')
        && isApproved() && resource.data.get('company', '') == myCo() && isExecProfileUser();
      allow read: if isApproved() && (isTotalMasterUser() || !locked() || resource.data.companyName == myCo())
        && (request.auth.uid in resource.data.get('participants', []) || isCompanyAdmin(resource.data.get('company', '')) || isAcctApprovalReader(resource.data));
      // ⭐ 2026-11-02 점검 — HOME › 직원 일정(ExecSuite TeamSchedule)은 회사의 연차(cat=="leave") 결재만 조회 → 같은 회사 직원(기사·화주 제외)은 읽기 허용
      //  (조회는 company == 우리 회사 + cat == "leave" 조건으로 보내야 한다)
      allow read: if isOfficeStaff() && resource.data.get('cat', '') == 'leave' && resource.data.get('company', '') == myCo();
      allow create: if coCreate() && request.resource.data.get('drafterUid', '') == request.auth.uid
        && apFilesOk()
        && (request.resource.data.get('form', '') != 'bizplan' || apBizLineOk())
        && (request.resource.data.get('status', '') == 'pending'
          // 일일 업무일지 자동 승인 — 회사 결재 설정(approvalSettings/{회사}.autoApproveDaily)이 켜져 있을 때만
          || (request.resource.data.get('status', '') == 'approved' && request.resource.data.get('form', '') == 'daily'
              && request.resource.data.get('autoApproved', false) == true
              && exists(/databases/$(database)/documents/approvalSettings/$(request.resource.data.get('company', '')))
              && get(/databases/$(database)/documents/approvalSettings/$(request.resource.data.get('company', ''))).data.get('autoApproveDaily', false) == true))
        && request.auth.uid in request.resource.data.get('participants', []);
      // ⭐ 2026-11-10 지급완료 규칙을 참여자 규칙보다 앞에 — 경리가 그 문서의 결재자(참여자)이기도 하면 앞 규칙 계산이 한도(1000)를 다 써서
      //  지급 완료 처리가 PERMISSION_DENIED로 막혔다(테스트: scripts/approvalPayRules.test.cjs). 싼 조건(문서 칸)부터 본다.
      // ⭐ 2026-11-04 전자결재 서명 — 지출결의 지급완료(paid) 처리·취소
      //  최종 승인된 비용·지출 결의(cat expense)만, 바꿀 수 있는 칸은 paid·history·updatedAt·drafterUnread 뿐.
      //  누를 수 있는 사람: 같은 회사의 경리(test)·경리사무원·hrAcct·allMgr(경리 화면)·최고관리자, 부서 이름에 재무·경리·회계·총무가 든 직원
      //  (Approval.jsx canPay와 같은 조건 — 결재 취소 진행 중에는 안 됨)
      allow update: if isApproved()
        && resource.data.get('status', '') == 'approved'
        && resource.data.get('cat', '') == 'expense'
        && resource.data.get('cancel', {}).get('status', '') != 'pending'
        && apAff().hasOnly(['paid', 'history', 'updatedAt', 'drafterUnread'])
        // ⭐ 2026-11-07 운송 관리자(admin)·최종 결재자는 지급 처리 불가 — 경리 역할·재무 부서만(통합관리자·통합인사관리자는 화면 전환으로 앱에서 한 번 더 막음)
        && (myRole() in ['test', 'acctStaff', 'hrAcct', 'allMgr', 'totalMaster'] || myTeamPay())
        && (myCoRaw() == resource.data.get('company', '') || isTotalMasterUser());
      // 기안자·참여자 수정 — 기안자·참여자 목록과 회사는 못 바꾼다(결재 진행·회수·의견·읽음)
      // ⭐ 2026-11-02 점검 — 참조자·기안자가 status/line을 직접 바꿔 스스로 최종 승인하던 문제:
      //  읽음·의견·보관함 표시는 참여자 누구나, 결재선(line/step)·승인은 "지금 내 차례"인 결재자만,
      //  결재 취소 진행은 취소 결재선의 내 차례만, 기안자는 대기 중 수정·회수·결재 취소 요청만
      allow update: if isApproved() && request.auth.uid in resource.data.get('participants', [])
        && request.resource.data.get('drafterUid', '') == resource.data.get('drafterUid', '')
        && request.resource.data.get('participants', []) == resource.data.get('participants', [])
        && request.resource.data.get('company', '') == resource.data.get('company', '')
        // 📑📎 2026-11-08 양식은 못 바꾸고(사업계획서 결재선 검사를 비켜 가지 못하게) 첨부는 10개까지
        && request.resource.data.get('form', '') == resource.data.get('form', '')
        && apFilesOk()
        && (apAff().hasOnly(['ccReadBy', 'seenBy', 'drafterUnread', 'history', 'updatedAt', 'hiddenBy'])
          || (resource.data.get('status', '') == 'pending' && resource.data.line[resource.data.get('step', 0)].uid == request.auth.uid)
          || (resource.data.get('cancel', {}).get('status', '') == 'pending'
              && resource.data.cancel.line[resource.data.cancel.get('step', 0)].uid == request.auth.uid)
          || (resource.data.drafterUid == request.auth.uid
              && !apAff().hasAny(['line', 'step'])
              && (request.resource.data.get('status', '') == resource.data.get('status', '')
                || (resource.data.get('status', '') == 'pending' && request.resource.data.get('status', '') == 'withdrawn'))
              // 승인 뒤에는 내용(금액 등)을 못 고친다 — 읽음·의견·결재 취소 요청만
              && (resource.data.get('status', '') == 'pending'
                || apAff().hasOnly(['ccReadBy', 'seenBy', 'drafterUnread', 'history', 'updatedAt', 'hiddenBy', 'cancel']))
              && (!apAff().hasAny(['cancel']) || apCancelReqOk())));
      // 회사 관리자(결재함 › 회사 전체)는 참여자가 아니어도 "내 보관함에서 삭제/되돌리기"(hiddenBy)만 바꿀 수 있다
      allow update: if isApproved() && isCompanyAdmin(resource.data.get('company', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy']);
      allow delete: if false;
    }

    // 🗂 사내 게시판(자유·관리자·임원) — 볼 수 있는 사람만 읽고 쓴다
    // 임원게시판은 권한(임원 기준)을 정하기 전까지 최고관리자만
    function canSeeBoard(b) {
      return b == 'free' || isTotalMasterUser()
        || (b == 'admin' && (myRole() in ['admin', 'allMgr', 'hrManager', 'hrAcct'] || isExecRoleUser()));
    }
    function isBoardAdmin() {
      return isSuperEmail() || myRole() in ['admin', 'allMgr', 'totalMaster', 'hrManager', 'hrAcct'];
    }
    // ⭐ 2026-11-03 공지 작성 권한 — 회사 마스터가 정함(companySettings/{회사}.noticeWriters: admin | exec | all)
    function noticePolicy() {
      return exists(/databases/$(database)/documents/companySettings/$(myCo()))
        ? get(/databases/$(database)/documents/companySettings/$(myCo())).data.get('noticeWriters', 'admin') : 'admin';
    }
    function canPostNotice() {
      return isBoardAdmin() || (isApproved() && !(myRole() in ['viewer', 'driver', 'shipper', 'cafeUser']) && (
        myIsMaster() || noticePolicy() == 'all' || (noticePolicy() == 'exec' && myTeamExec())));
    }
    // 💬 2026-11-03 댓글·좋아요(공지·게시판 공용, 문서 안 배열)
    //  likes: 내 uid 하나만 넣거나 뺄 수 있다(남의 좋아요는 못 건드림) · comments: 500개까지
    //  (댓글 하나하나의 "본인만 수정" 은 배열이라 규칙으로 가르기 어려워 화면에서 막는다 — 같은 회사 직원만 쓸 수 있음)
    function likesOnlyMine() {
      let before = resource.data.get('likes', []).toSet();
      let after = request.resource.data.get('likes', []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).hasOnly([request.auth.uid]);
    }
    function commentsOk() {
      return request.resource.data.get('comments', []) is list && request.resource.data.get('comments', []).size() <= 500;
    }
    function canTalkUser() {
      return isTotalMasterUser() || !(myRole() in ['viewer', 'driver', 'shipper', 'cafeUser']);
    }
    // 📢 공지사항 — 누구나 읽고, 쓰기·수정·삭제는 관리자(관리자·인사관리자·최고관리자)만
    //  🔒 2026-11-03 지정 공지(teams·targetUids) 비공개는 화면(notifyCore.canSeeTargetedNotice)과 서버 푸시에서 지킨다.
    //   보안규칙은 "조회 결과를 걸러 주지 않는" 구조라, 여기서 막으면 공지 목록 조회 전체가 거부된다(지정 공지가 하나라도 섞이면).
    match /notices/{id} {
      // 🔒 같은 운송사 공지만 · 화주사는 화주 대상 공지만
      // ⭐ 2026-11-07 보안 — 화주는 연동 운송사의 화주 대상 공지만(예전엔 모든 운송사의 화주 공지가 보였다)
      allow read: if coMatch(resource.data) || (isApproved() && isShipperUser() && resource.data.get('audience', '') in ['shipper', 'all']
          && myLinkedCo() != '' && resource.data.get('companyName', '') == myLinkedCo())
        // ⭐ 2026-11-03 기사 대상 공지(audiences에 driver) — 같은 회사 기사(승인된 계정)도 읽는다
        || (isApproved() && myRole() == 'driver' && 'driver' in resource.data.get('audiences', []) && resource.data.get('companyName', '') == myCo());
      allow create: if coCreate() && canPostNotice();
      // 수정·삭제는 작성자 본인만(최고관리자 예외). 작성자 기록이 없는 옛 공지는 공지 작성 권한자가 관리
      allow update, delete: if coMatch(resource.data) && canPostNotice()
        && (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('authorUid', '') == ''
            || isTotalMasterUser());
      // ⭐ 2026-11-04 관리자·마스터는 같은 회사 공지(임원이 올린 것 포함)를 삭제할 수 있다(수정은 작성자만)
      allow delete: if coMatch(resource.data) && isApproved()
        && (myRole() in ['admin', 'allMgr'] || myIsMaster());
      // 읽음 표시는 같은 회사 직원 누구나
      allow update: if coMatch(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      // 💬 댓글·좋아요는 같은 회사 직원(조회전용·기사·화주 제외)
      allow update: if coMatch(resource.data) && canTalkUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes', 'readBy'])
        && likesOnlyMine() && commentsOk();
    }
    // 📋 인수인계 — 받는 사람의 "확인"(readBy)은 누구나, 내용 수정·삭제는 작성자 본인만(최고관리자 예외)
    match /handovers/{id} {
      allow read: if coMatch(resource.data);
      allow create: if coCreate();
      allow update: if coMatch(resource.data) && (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('authorUid', '') == ''
        || isTotalMasterUser()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if coMatch(resource.data) && (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('authorUid', '') == ''
        || isTotalMasterUser());
    }
    match /boardPosts/{id} {
      allow read: if coMatch(resource.data) && canSeeBoard(resource.data.board);
      allow create: if coCreate() && request.resource.data.get('authorUid', '') == request.auth.uid && canSeeBoard(request.resource.data.get('board', ''));
      allow update: if coMatch(resource.data) && canSeeBoard(resource.data.board)
        && request.resource.data.get('board', '') == resource.data.board
        && (resource.data.get('authorUid', '') == request.auth.uid || isBoardAdmin()
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'comments', 'likes'])
                && likesOnlyMine() && commentsOk()));
      // 삭제는 작성자 본인만(최고관리자는 운영상 예외)
      allow delete: if coMatch(resource.data) && canSeeBoard(resource.data.board) && (resource.data.get('authorUid', '') == request.auth.uid || isTotalMasterUser());
    }
    // sessionLogs — 아래 "보안 점검" 묶음에서 정함(최고관리자만 열람)

    // ────────────────────────────────────────────────────────────
    // 그 외 모든 컬렉션 — 승인된 계정만 접근 가능
    // (운송사/화주사/기사 전용 화면은 전부 Firebase Auth 로그인 후에만 진입하므로
    // 기존 기능에는 영향이 없고, 로그인 없는 제3자의 접근만 차단한다)
    // ────────────────────────────────────────────────────────────
    // ⭐ 규칙은 "하나라도 허용하면 허용"이라, 서버 전용 컬렉션(초기화 비밀번호·보관함·기록)은
    // 여기서 빼야 위의 "allow … if false"가 실제로 막힌다.
    // ⭐ 개인 설정(자주 쓰는 계좌 등) — 본인만
    // 🏢 2026-11-01 운송사별 권한 설정 — 누구나(승인된 직원) 읽고, 최고관리자만 바꾼다
    match /companyRoleOverrides/{co} {
      // ⭐ 2026-11-07 보안 — 우리 회사 권한 설정만(예전엔 승인된 누구나 모든 회사 것)
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser();
      // ⭐ 2026-11-11 모든 운송사 마스터가 자기 회사 권한을 바꾼다(기본 켜짐) — 최고관리자가 끈 회사(companyFeatures/{회사}.masterRolePerms == false)만 막는다
      allow write: if isApproved() && myCo() == co && myIsMaster()
        && (!exists(/databases/$(database)/documents/companyFeatures/$(co))
          || get(/databases/$(database)/documents/companyFeatures/$(co)).data.get('masterRolePerms', true) != false)
        && request.resource.data.get('companyName', co) == co;
    }
    // 공통 권한(역할별 메뉴) — 최고관리자만 바꾼다(예전엔 승인된 누구나 쓸 수 있었음)
    match /customRoles/{key} {
      allow read: if isApproved();
      allow write: if isTotalMasterUser();
    }
    match /userPrefs/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    // ⭐ 2026-11-02 원격지원 — 직원 → 최고관리자 원격 지원 요청 · 화면 공유 세션(WebRTC 신호·채팅)
    //  요청: 승인된 직원이 "내 uid · 내 회사 · 대기" 로만 만든다. 읽기는 요청한 본인과 최고관리자.
    //  본인 수정은 취소 · 원격 번호 · 화면 공유 세션 연결(in_session/done)만. 최고관리자는 모두.
    function supAff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    match /supportRequests/{id} {
      allow create: if isApproved() && !isShipperUser()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('status', '') == 'pending';
      // ⭐ 2026-11-05 원격 지원 걸기 — 최고관리자만 다른 직원에게 "invited"(직원 응답 대기)로 만든다
      allow create: if isTotalMasterUser()
        && request.resource.data.get('status', '') == 'invited'
        && request.resource.data.get('initiatedBy', '') == 'master'
        && request.resource.data.get('uid', '') is string && request.resource.data.get('uid', '') != '';
      allow read: if isTotalMasterUser() || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow update: if isTotalMasterUser();
      //  직원 본인: invited → approved(수락) / declined(거절) 도 할 수 있다(respondedAt 기록)
      allow update: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid
        && supAff().hasOnly(['status', 'anydeskId', 'sessionId', 'updatedAt', 'cancelledAt', 'endedAt', 'respondedAt'])
        && (request.resource.data.get('status', '') == resource.data.get('status', '')
          || (request.resource.data.get('status', '') in ['approved', 'declined'] && resource.data.get('status', '') == 'invited')
          || (request.resource.data.get('status', '') == 'cancelled' && resource.data.get('status', '') in ['pending', 'approved'])
          || (request.resource.data.get('status', '') == 'in_session' && resource.data.get('status', '') == 'approved')
          || (request.resource.data.get('status', '') == 'done' && resource.data.get('status', '') == 'in_session'));
      allow delete: if isTotalMasterUser();
    }
    //  세션: 요청한 직원(requesterUid)과 최고관리자만. 하위 컬렉션(callerCandidates · calleeCandidates · messages)도 같게.
    //  ⭐ 2026-11-07 화면 제어 — controlAllowed(제어 허용)는 직원 본인만 켤 수 있다(최고관리자는 끄기만).
    //   제어 명령(controlCmds, 데이터 채널이 안 될 때의 느린 통로)은 최고관리자만, 직원이 허용한 동안에만 쓸 수 있다.
    match /supportSessions/{sid} {
      allow create: if isApproved() && request.resource.data.get('requesterUid', '') == request.auth.uid
        && request.resource.data.get('controlAllowed', false) != true;
      allow read: if isTotalMasterUser() || (isSignedIn() && resource.data.get('requesterUid', '') == request.auth.uid);
      allow update: if isSignedIn() && resource.data.get('requesterUid', '') == request.auth.uid
        && request.resource.data.get('requesterUid', '') == resource.data.get('requesterUid', '');
      allow update: if isTotalMasterUser()
        && (request.resource.data.get('controlAllowed', false) != true || resource.data.get('controlAllowed', false) == true);
      allow delete: if isTotalMasterUser();
      match /controlCmds/{cid} {
        allow create: if isTotalMasterUser()
          && get(/databases/$(database)/documents/supportSessions/$(sid)).data.get('controlAllowed', false) == true;
        allow read, delete: if isTotalMasterUser() || (isSignedIn()
          && get(/databases/$(database)/documents/supportSessions/$(sid)).data.get('requesterUid', '') == request.auth.uid);
      }
      match /{sub}/{docId} {
        allow read, write: if sub != 'controlCmds' && (isTotalMasterUser() || (isSignedIn()
          && get(/databases/$(database)/documents/supportSessions/$(sid)).data.get('requesterUid', '') == request.auth.uid));
      }
    }
    // ════════════════════════════════════════════════════════════
    // 💰 ⭐ 2026-11-06 직원 급여(급여 계산·명세서) · 연차 사용 촉진 — 잠금 스위치와 상관없이 항상 회사 검사
    // ⭐ 2026-11-07 급여는 경리 업무 — 급여 담당만 + 급여 비밀번호로 잠금 해제(30분)한 동안만
    //  급여 담당(payrollStaff): 경리관리자(test)·경리사무원(acctStaff)·통합인사관리자(hrAcct)·통합관리자(allMgr)
    //    · 재무/경리/회계/총무 부서 · 최고관리자. 인사관리자·대표·임원·회사 마스터는 경리가 아니면 못 본다(예전 조회 권한 없앰)
    //  잠금 해제(payUnlocked): payrollUnlocks/{uid}(서버 함수 payrollPwVerify가 만든다)의 회사가 같고 만료 전
    //  직원 본인: 발행된(published) 본인 명세서만 읽고 "읽음(readAt)"만 표시(비밀번호 없이) · 본인 연차 촉진 문서에 사용 계획만 제출
    //  화면 기준은 src/payrollAccess.js · 서버는 functions/payrollPw.js(같은 판단)
    // ════════════════════════════════════════════════════════════
    function payrollStaff() {
      return isTotalMasterUser() || (isApproved()
        && !(myRole() in ['driver', 'shipper', 'cafeUser'])
        && (myRole() in ['test', 'acctStaff', 'hrAcct', 'allMgr']
          || myTeamPay()));
    }
    function payUnlocked(co) {
      let p = /databases/$(database)/documents/payrollUnlocks/$(request.auth.uid);
      return isSignedIn() && exists(p) && get(p).data.get('companyName', '') == co && get(p).data.expiresAt > request.time;
    }
    // 이 회사 급여 문서를 지금 다룰 수 있는가(급여 담당 + 같은 회사 + 잠금 해제)
    function payOk(d) {
      return payrollStaff() && payCo(d) && payUnlocked(d.get('companyName', ''));
    }
    // 예전 이름 — 급여 담당 + 내 회사 잠금 해제
    function payrollEditor() {
      return payrollStaff() && payUnlocked(myCo());
    }
    // 연차 촉진 관리(발송·날짜 지정) — 인사팀(isHrStaff) + 회사 마스터
    function leaveManager() {
      return isApproved() && (isHrStaff() || myIsMaster());
    }
    function payCo(d) {
      return isTotalMasterUser() || d.get('companyName', '') == myCo();
    }
    // 급여 비밀번호(해시) · 틀린 횟수 — 서버만. 잠금 해제 문서는 본인만 읽는다(남은 시간 표시)
    match /payrollSecrets/{co} {
      allow read, write: if false;
    }
    match /payrollPwAttempts/{id} {
      allow read, write: if false;
    }
    // 🔒 2026-11-10 비공개 청구운임 — 직원들이 아는 청구운임과 따로, 정한 사람만 보는 "실제 청구 금액"
    //  privateFareSettings/{회사 키} = { companyName, viewers:[uid], clients:[{ name, mode, value }], updatedAt, updatedBy }
    //  privateFareSettings/{회사 키}/fares/{오더 id} = { orderId, client, date, base(그때 공개 청구운임), amount, memo, updatedAt, updatedBy }
    //  · 금액(fares)은 viewers에 든 사람만 읽고 쓴다 — 회사 마스터·관리자·최고관리자도 viewers가 아니면 못 본다
    //  · 설정 처음 만들기: 같은 회사 마스터(또는 관리자)가 자기 회사 문서로(최고관리자는 어느 회사든 대신 켜 줌) · 그 뒤 고치기는 viewers만(마스터가 몰래 자기를 넣지 못하게)
    //  · 설정 문서 읽기: viewers만(어느 거래처가 비공개인지도 알면 안 되므로) · 지우기 없음
    //  · 문서가 없을 때 "없음"만 확인하는 읽기는 승인된 직원 허용(화면이 메뉴를 보일지 판단)
    match /privateFareSettings/{co} {
      allow get: if isSignedIn() && (resource == null ? isApproved() : request.auth.uid in resource.data.get('viewers', []));
      allow list: if false;
      // 처음 만들기 — 같은 회사 마스터·관리자, 또는 최고관리자(고객사 대신 켜 주기 · 만든 뒤에는 viewers가 아니면 못 본다)
      allow create: if request.resource.data.viewers is list && request.resource.data.viewers.size() > 0 && request.resource.data.viewers.size() <= 10
        && request.resource.data.get('companyName', '') != ''
        && (isTotalMasterUser()
          || (isApproved() && !isShipperUser() && request.resource.data.get('companyName', '') == myCo() && (myIsMaster() || myRole() == 'admin')));
      allow update: if isSignedIn() && request.auth.uid in resource.data.get('viewers', [])
        && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
        && request.resource.data.viewers is list && request.resource.data.viewers.size() > 0 && request.resource.data.viewers.size() <= 10;
      allow delete: if false;
      match /fares/{oid} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/privateFareSettings/$(co)).data.get('viewers', []);
      }
    }
    match /payrollUnlocks/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // 급여·연차 설정(payrollSettings/{회사}) — 요율·지급일만 있고 사람별 급여는 없다(연차 촉진 화면도 읽어야 해서 읽기는 잠금 해제 없이)
    //  요율 저장은 급여 담당 + 잠금 해제 · 연차 촉진 설정(leave)은 인사 담당도
    match /payrollSettings/{co} {
      allow read: if isTotalMasterUser() || (myCo() == co && isApproved() && (payrollStaff() || leaveManager()));
      allow create, update: if (isTotalMasterUser() || myCo() == co) && request.resource.data.get('companyName', '') == co && (
        (payrollStaff() && payUnlocked(co))
        || (leaveManager() && (resource == null
          ? request.resource.data.keys().hasOnly(['companyName', 'leave', 'leaveUpdatedAt', 'leaveUpdatedBy'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'leave', 'leaveUpdatedAt', 'leaveUpdatedBy']))));
      allow delete: if isTotalMasterUser();
    }
    // 직원별 급여 설정 · 월 급여 처리(확정·발행·지급 기록)
    match /payrollEmployees/{id} {
      allow read: if (resource == null && payrollEditor()) || (resource != null && payOk(resource.data));
      allow create: if payOk(request.resource.data);
      allow update: if payOk(resource.data) && request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
      allow delete: if payOk(resource.data);
    }
    match /payrollRuns/{id} {
      allow read: if (resource == null && payrollEditor()) || (resource != null && payOk(resource.data));
      allow create: if payOk(request.resource.data);
      allow update: if payOk(resource.data) && request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
      allow delete: if isTotalMasterUser();
    }
    // 급여명세서 — 확정(confirmed)·지급(paid)된 명세서는 금액을 못 바꾸고 상태(확정 해제·발행·지급)만
    match /payslips/{id} {
      allow read: if (resource != null && isSignedIn() && resource.data.get('uid', '') == request.auth.uid && resource.data.get('published', false) == true)
        || (resource == null && payrollEditor())
        || (resource != null && payOk(resource.data));
      allow create: if payOk(request.resource.data);
      allow update: if (payOk(resource.data)
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
          && request.resource.data.get('uid', '') == resource.data.get('uid', '')
          && (resource.data.get('status', 'draft') == 'draft'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'published', 'publishedAt', 'publishedBy', 'paidAt', 'paidDate', 'updatedAt', 'updatedBy', 'unlockReason'])))
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid && resource.data.get('published', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']));
      allow delete: if payOk(resource.data) && resource.data.get('status', 'draft') == 'draft';
    }
    // 인사·급여 알림(명세서 발행 · 연차 촉진) — 받는 사람만 읽고 읽음 표시
    match /hrNotices/{id} {
      allow read: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create: if isTotalMasterUser() || (isApproved() && request.resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('uid', '') is string
        && (request.resource.data.get('kind', '') == 'leavePlan' || payrollEditor() || leaveManager()));
      allow delete: if isTotalMasterUser();
    }
    // 연차 사용 촉진 기록 — log는 덧붙이기만(지우거나 고치지 못함: 법적 증빙)
    match /leavePromotions/{id} {
      allow read: if (resource != null && isSignedIn() && resource.data.get('uid', '') == request.auth.uid)
        || (resource == null && isApproved())
        || ((leaveManager() || isTotalMasterUser() || (isApproved() && myRole() in ['test', 'acctStaff'])) && payCo(resource.data));
      allow create: if (leaveManager() || isTotalMasterUser()) && payCo(request.resource.data);
      allow update: if ((leaveManager() || isTotalMasterUser()) && payCo(resource.data)
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
          && request.resource.data.get('log', []).hasAll(resource.data.get('log', [])))
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'log', 'updatedAt'])
          && request.resource.data.get('log', []).size() == resource.data.get('log', []).size() + 1
          && request.resource.data.get('log', []).hasAll(resource.data.get('log', []))
          && request.resource.data.log[request.resource.data.log.size() - 1].get('type', '') == 'plan');
      allow delete: if isTotalMasterUser();
    }
    // 📊 2026-11-06 일일 경영 보고(임원 화면 · 대표·임원 일일 보고서) — src/dailyReport.js · functions/dailyReport.js
    //  받기 설정(사람마다): 본인만 읽고 쓴다(회사는 내 회사로만). 서버 푸시는 관리자 SDK로 읽는다.
    match /dailyReportPrefs/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isApproved() && request.auth.uid == uid && request.resource.data.get('uid', '') == uid
        && (isTotalMasterUser() || request.resource.data.get('companyName', '') == myCo());
    }
    //  회사 설정(받는 사람 recipients{uid:true|false}): 그 회사 직원은 읽고, 최고관리자·회사 관리자(isCompanyAdmin)·마스터·대표 직책만 바꾼다
    match /dailyReportCompany/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow create, update: if (isTotalMasterUser() || (isApproved() && myCo() == co && (isCompanyAdmin(co) || myIsMaster()
          || myPosCeo())))
        && request.resource.data.get('companyName', '') == co;
      allow delete: if isTotalMasterUser();
    }
    //  발송 기록(중복 발송 방지) — 서버만
    match /dailyReportLogs/{id} {
      allow read, write: if false;
    }
    // 🧠 2026-11-07 오더 스캔 회사별 학습 — scanLearn/{회사 키}/items/{id} (src/orderScanClient.js)
    //  회사 키: 배차 프로그램 계정 "lw:" + 내 회사명(myCo) · 허브 회원은 허브 회사 키(hubMyKey) — 같은 회사만 읽고 쓴다
    //  (로지스웹 계정으로 들어온 허브 회원은 키가 "lw:회사명"이라 배차 프로그램과 같은 기록을 쓴다)
    function scanKeyOk(key) {
      return (isApproved() && key == 'lw:' + myCo()) || (hubActive() && key == hubMyKey());
    }
    function scanLearnOk(d, key) {
      return d.keys().hasOnly(['fp', 'labels', 'head', 'text', 'fields', 'changed', 'aliases', 'labelMap', 'companyKey', 'uid', 'updatedAtMs', 'updatedAt'])
        && d.get('companyKey', '') == key && d.get('uid', '') == request.auth.uid
        && d.get('fp', '') is string && d.get('fp', '').size() <= 16
        && d.get('text', '') is string && d.get('text', '').size() <= 3000
        && d.get('fields', {}) is map && d.get('fields', {}).size() <= 40
        && d.get('labelMap', {}) is map && d.get('labelMap', {}).size() <= 40
        && d.get('aliases', []) is list && d.get('aliases', []).size() <= 10;
    }
    match /scanLearn/{key} {
      allow read, write: if false;
      match /items/{id} {
        allow read, delete: if scanKeyOk(key);
        allow create, update: if scanKeyOk(key) && scanLearnOk(request.resource.data, key);
      }
    }
    //  정밀 인식 하루 사용 횟수 — 서버(orderScanOcr · orderScanExtract)만
    match /scanUsage/{id} {
      allow read, write: if false;
    }
    // 🤖 2026-11-07 배차 AI 비서 — 사용 기록(질문 앞부분 · 도구 이름 · 토큰 수)은 서버만 쓰고 최고관리자만 본다 · 하루 질문 수는 서버만
    match /aiAssistantLogs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    match /aiAssistantUsage/{id} {
      allow read, write: if false;
    }
    // 🏛 2026-11-07 국세청 사업자 상태 · 기상청 예보 · 팝빌 — 서버(functions/publicData.js · popbill.js)만 쓴다
    //  bizStatusCache(번호별 24시간) · bizStatusUsage · weatherUsage(하루 횟수) · companyPopbill(운송사 연동회원) · integrationConfig(연동 스위치)
    match /bizStatusCache/{id} {
      allow read, write: if false;
    }
    match /bizStatusUsage/{id} {
      allow read, write: if false;
    }
    match /weatherUsage/{id} {
      allow read, write: if false;
    }
    //  예보 · 특보는 회사 데이터가 아니라 공용(지역 키) — 승인된 직원 · 허브 회원이 읽는다
    match /weatherCache/{id} {
      allow read: if isApproved() || hubActive();
      allow write: if false;
    }
    match /companyPopbill/{co} {
      allow read, write: if false;
    }
    match /integrationConfig/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 💬🏦 2026-11-08 팝빌 자동화 — 알림톡 배차 알림 · 은행 입금 자동 조회(functions/alimtalk.js · bankSync.js)
    //  popbillSettings/{회사}: 알림톡 설정 · 조회할 계좌 — 그 회사 직원이 읽고, 회사 관리자만 쓴다(정한 칸만)
    //  bankSyncState/{회사} · bankAliases/{회사} · bankTxns · alimtalkLogs: 서버만 쓰고 그 회사 직원(기사 · 화주 제외)만 읽는다
    function popbillSettingsWriter(co) {
      return isTotalMasterUser() || (isApproved() && myCo() == co
        && (myUser().get('role', '') in ['admin', 'allMgr', 'hrManager', 'hrAcct'] || myUser().get('isMaster', false) == true));
    }
    match /popbillSettings/{co} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && myCo() == co);
      allow create, update: if popbillSettingsWriter(co)
        && request.resource.data.keys().hasOnly(['companyName', 'alimtalk', 'bankAccounts', 'sms', 'updatedAt', 'updatedBy'])
        && request.resource.data.get('companyName', co) == co;
      allow delete: if isTotalMasterUser();
    }
    match /bankSyncState/{co} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && myCo() == co);
      allow write: if false;
    }
    match /bankAliases/{co} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && myCo() == co);
      allow write: if false;
    }
    match /bankTxns/{id} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '') == myCo());
      allow write: if false;
    }
    match /alimtalkLogs/{id} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '') == myCo());
      allow write: if false;
    }
    // 💬 2026-11-10 문자 보내기(팝빌) 기록(functions/smsSend.js) — 서버만 쓰고 그 회사 직원만 읽는다
    match /smsLogs/{id} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '') == myCo());
      allow write: if false;
    }
    // 💬 2026-11-10 운송사별 월 문자 · 알림톡 사용량(messageUsage/{회사}__{YYYY-MM}) — 서버만 쓰고, 그 회사 직원 · 최고관리자가 읽는다(로지스웹 월말 청구 근거)
    match /messageUsage/{id} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('company', '') == myCo());
      allow write: if false;
    }
    // ✉️ 2026-11-08 운송사별 발신 메일(functions/companyMail.js — mailSettings · sendCompanyMail)
    //  companyMailSettings/{회사}: 발신 주소 · 이름 · 메일 서비스 · 마지막 테스트(비밀 없음) — 같은 회사 직원이 읽고, 쓰기는 서버만
    //  companyMailSecrets(앱 비밀번호 암호문) · companyMailUsage(하루 보낸 횟수) — 서버만
    match /companyMailSettings/{co} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && myCo() == co);
      allow write: if false;
    }
    match /companyMailSecrets/{id} {
      allow read, write: if false;
    }
    match /companyMailUsage/{id} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════════════
    // 🔒 2026-11-07 보안 점검 — 예전에 맨 아래 공용 규칙(승인된 계정이면 회사와 상관없이 읽기·쓰기)에 걸려 있던 컬렉션들
    //  하나하나 회사(또는 본인) 기준으로 잠근다. 새 컬렉션을 만들면 반드시 여기(또는 위)에 규칙을 따로 쓰고
    //  아래 공용 규칙 제외 목록에도 넣어야 한다 — 공용 규칙은 이제 "문서의 companyName == 내 회사"일 때만 연다.
    // ════════════════════════════════════════════════════════════
    // ── 기사·지입차 기록(위치·운행일지·사진·알림·긴급·온도·근태·휴일 등) — 서버(관리자 SDK)·옛 기록은 회사명이 없을 수 있다.
    //  잠금 스위치(locked) 전에는 예전처럼, 켠 뒤에는 같은 회사(companyName) 또는 본인 기록(driverId·uid)만.
    //  회사명이 없는 옛 문서는 한 건 조회(get)만 같은 운송사 직원 누구에게나(목록에는 안 나온다 — 화면은 회사 조건으로 조회)
    function looseOwner(d) {
      return isSignedIn() && (d.get('driverId', '') == request.auth.uid || d.get('uid', '') == request.auth.uid || d.get('driverUid', '') == request.auth.uid);
    }
    function looseRead(d) {
      return isTotalMasterUser() || looseOwner(d)
        || (isApproved() && (!locked() || (!isShipperUser() && d.get('companyName', '') == myCo())));
    }
    function looseLegacyGet(d) {
      return isApproved() && !isShipperUser() && !('companyName' in d);
    }
    function looseCreate() {
      return isTotalMasterUser() || (isApproved() && (!locked() || request.resource.data.get('companyName', myCo()) == myCo()));
    }
    function looseKeep() {
      return isTotalMasterUser() || request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
    }
    match /{lcol}/{id} {
      allow get: if lcol in ['driver_logs', 'gps_tracks', 'driver_photo_logs', 'driver_notifications', 'location_change_requests',
          'emergency_alerts', 'collision_alerts', 'cargo_temp', 'cargo_camera', 'deliverySignatureHistory', 'attendance', 'holidays',
          'fleet_settings', 'importBatches', 'driver_documents', 'driver_uploads']
        && (looseRead(resource.data) || looseLegacyGet(resource.data));
      allow list: if lcol in ['driver_logs', 'gps_tracks', 'driver_photo_logs', 'driver_notifications', 'location_change_requests',
          'emergency_alerts', 'collision_alerts', 'cargo_temp', 'cargo_camera', 'deliverySignatureHistory', 'attendance', 'holidays',
          'fleet_settings', 'importBatches', 'driver_documents', 'driver_uploads']
        && looseRead(resource.data);
      allow create: if lcol in ['driver_logs', 'gps_tracks', 'driver_photo_logs', 'driver_notifications', 'location_change_requests',
          'emergency_alerts', 'collision_alerts', 'cargo_temp', 'cargo_camera', 'deliverySignatureHistory', 'attendance', 'holidays',
          'fleet_settings', 'importBatches', 'driver_documents']
        && looseCreate();
      allow update, delete: if lcol in ['driver_logs', 'gps_tracks', 'driver_photo_logs', 'driver_notifications', 'location_change_requests',
          'emergency_alerts', 'collision_alerts', 'cargo_temp', 'cargo_camera', 'deliverySignatureHistory', 'attendance', 'holidays',
          'fleet_settings', 'importBatches', 'driver_documents', 'driver_uploads']
        && (looseRead(resource.data) || looseLegacyGet(resource.data)) && (request.resource == null || looseKeep());
    }
    // 실시간 위치(liveLocations/{오더id}) — 업로드 링크(로그인 없음)는 오더 id로 한 건만 읽고 쓴다(위 공개 규칙). 목록·삭제는 같은 회사만
    // (위 /liveLocations 규칙의 list·delete "승인된 누구나"는 아래 공용 규칙 제외로 이 규칙과 같아진다 — 위 규칙을 고친다)

    // ── 💬 사내 메신저 — 방 참여자만(다른 회사 사람은 초대받아야만 — 화주↔연동 운송사 대화)
    function chatMember(rid) {
      let p = /databases/$(database)/documents/chat_rooms/$(rid);
      return isSignedIn() && rid is string && rid != '' && exists(p) && request.auth.uid in get(p).data.get('members', []);
    }
    match /chat_rooms/{rid} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.get('members', []);
      allow create: if isApproved() && request.auth.uid in request.resource.data.get('members', []);
      allow update, delete: if isApproved() && request.auth.uid in resource.data.get('members', []);
    }
    match /chat_messages/{mid} {
      allow read: if chatMember(resource.data.get('roomId', ''));
      allow create: if isApproved() && request.resource.data.get('senderUid', '') == request.auth.uid
        && chatMember(request.resource.data.get('roomId', ''));
      allow update: if isApproved() && chatMember(resource.data.get('roomId', ''))
        && request.resource.data.get('roomId', '') == resource.data.get('roomId', '')
        && (resource.data.get('senderUid', '') == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'reactions']));
      allow delete: if isApproved() && resource.data.get('senderUid', '') == request.auth.uid;
    }
    //  채팅 프로필(이름·사진·상태 문구) — 같은 회사(화주는 연동 운송사도)만 본다. 쓰기는 본인만, 회사 칸은 내 회사로만
    function chatProfileVisible(d) {
      return isTotalMasterUser() || (isApproved() && (d.get('company', '') == myCo()
        || (isShipperUser() && myLinkedCo() != '' && d.get('company', '') == myLinkedCo())));
    }
    match /chat_profiles/{uid} {
      allow get: if (isSignedIn() && request.auth.uid == uid) || chatProfileVisible(resource.data);
      allow list: if chatProfileVisible(resource.data);
      allow create: if isSignedIn() && request.auth.uid == uid
        && (isTotalMasterUser() || request.resource.data.get('company', '') == myCo() || request.resource.data.get('company', '') == '');
      allow update: if isSignedIn() && request.auth.uid == uid
        && (isTotalMasterUser() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['company'])
          || request.resource.data.get('company', '') == myCo());
      allow delete: if isTotalMasterUser();
    }

    // ── 🏢 운송사 가입 신청서(회사 정보 · 사업자번호 · 직인 이미지 · 회사 코드) — 예전엔 승인된 누구나 모든 운송사 것을 읽고 지웠다
    //  읽기: 최고관리자 · 신청한 본인 · 같은 운송사 직원 · 연동 화주(연동 운송사 정보)
    //  고치기: 최고관리자 · 같은 운송사 직원(승인 상태·회사명은 못 바꿈) · 가입 화면(빈 주소 채우기만)
    match /transportApplications/{id} {
      allow create: if isSignedIn() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid
        && request.resource.data.get('status', 'pending') in ['pending', '대기', ''];
      allow read: if isTotalMasterUser()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid)
        || (isApproved() && !isShipperUser() && resource.data.get('companyName', '') == myCo())
        || (isApproved() && isShipperUser() && myLinkedCo() != '' && resource.data.get('companyName', '') == myLinkedCo());
      allow update: if isTotalMasterUser()
        || (isApproved() && !isShipperUser() && !(myRole() in ['driver', 'viewer', 'cafeUser'])
          && resource.data.get('companyName', '') == myCo()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyName', 'status', 'type', 'companyCode', 'userId']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address'])
          && resource.data.get('address', '') == '')
        // ⭐ 2026-11-09 기존 회사 직원 가입 — 회사 승인 담당(마스터·관리자 등)이 직원을 승인/해제하면 신청서 상태도 같이 맞춘다
        //  (예전엔 이 쓰기가 막혀 관리자센터 가입신청관리에 이미 승인된 직원이 계속 '대기'로 남았다)
        || (isApproved() && userManager() && resource.data.get('companyName', '') == myCo() && resource.data.get('type', '') == '기존'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'processedAt'])
          && request.resource.data.get('status', '') in ['approved', 'pending']);
      allow delete: if isTotalMasterUser() || (isApproved() && resource.data.get('companyName', '') == myCo() && userManager());
    }
    // ── 🤝 화주사 가입·연동 신청서 — 신청한 본인 · 같은 화주사 · 연동을 신청받은 운송사 · 최고관리자만
    match /companyApplications/{id} {
      allow create: if isSignedIn() && request.resource.data.get('userId', request.auth.uid) == request.auth.uid
        && request.resource.data.get('status', 'pending') == 'pending';
      allow read: if isTotalMasterUser()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid)
        || (isApproved() && !isShipperUser() && linkedCoOf(resource.data) == myCo())
        || (isApproved() && isShipperUser() && resource.data.get('companyName', '') == myCo());
      allow update: if isTotalMasterUser()
        || (isApproved() && !isShipperUser() && userManager() && linkedCoOf(resource.data) == myCo()
          && (linkedCoOf(request.resource.data) == myCo() || linkedCoOf(request.resource.data) == '')
          && request.resource.data.get('userId', '') == resource.data.get('userId', ''))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address'])
          && resource.data.get('address', '') == '');
      allow delete: if isTotalMasterUser() || (isApproved() && !isShipperUser() && userManager() && linkedCoOf(resource.data) == myCo());
    }
    // 회사 정보 수정 요청 — 요청한 본인 + 최고관리자(처리)
    match /companyEditRequests/{id} {
      allow read: if isTotalMasterUser() || (isSignedIn() && resource.data.get('requestedByUserId', '') == request.auth.uid);
      allow create: if isApproved() && request.resource.data.get('requestedByUserId', '') == request.auth.uid;
      allow update: if isTotalMasterUser() || (isSignedIn() && resource.data.get('requestedByUserId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifiedRequester']));
      allow delete: if isTotalMasterUser();
    }
    // 화주 문의 — 문의한 화주 본인 · 문의를 받은 운송사(transportCompany) 직원 · 최고관리자
    //  (transportCompany가 없는 예전 문의는 최고관리자·작성자만 — 2026-11-07 이후 문의부터 연동 운송사 이름을 함께 저장)
    match /inquiries/{id} {
      allow read: if isTotalMasterUser() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid)
        || (isOfficeStaff() && resource.data.get('transportCompany', '') == myCo());
      allow create: if isApproved() && request.resource.data.get('userId', '') == request.auth.uid
        && (!isShipperUser() || request.resource.data.get('transportCompany', '') == myLinkedCo());
      allow update: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('transportCompany', '') == myCo()
        && request.resource.data.get('transportCompany', '') == resource.data.get('transportCompany', '')
        && request.resource.data.get('userId', '') == resource.data.get('userId', ''));
      allow delete: if isTotalMasterUser();
    }
    // 화주사 운송 관리(화주 본인 것만)
    match /shipper_orders/{id} {
      allow read, update, delete: if isTotalMasterUser() || (isSignedIn() && resource.data.get('shipperUid', '') == request.auth.uid);
      allow create: if isApproved() && request.resource.data.get('shipperUid', '') == request.auth.uid;
    }
    // 개인 표시(본 알림·공지 읽은 시각) — 본인만
    match /userSeenNotifs/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /userSettings/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    // ── 💰 미수금 입금(arPayments, 회사 칸 company) · 다중 단가표 · 손익 수기 입력 — 항상 회사 검사(화면도 회사 조건으로 조회)
    match /arPayments/{id} {
      allow read, delete: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('company', '') == myCo());
      allow update: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('company', '') == myCo()
        && request.resource.data.get('company', '') == myCo());
      allow create: if isTotalMasterUser() || (isOfficeStaff() && request.resource.data.get('company', '') == myCo());
    }
    match /multiRateSheets/{id} {
      allow read, delete: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '') == myCo());
      allow update: if isTotalMasterUser() || (isOfficeStaff() && resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('companyName', '') == myCo());
      allow create: if isTotalMasterUser() || (isOfficeStaff() && request.resource.data.get('companyName', '') == myCo());
    }
    //  plManual/{연도} (기본 회사 예전 문서, 회사명 없음) · plManual/{회사__연도}
    match /plManual/{id} {
      allow read: if isTotalMasterUser() || (isOfficeStaff() && (resource == null
        || resource.data.get('companyName', '돌캐') == myCo()));
      allow create, update: if isTotalMasterUser() || (isOfficeStaff() && request.resource.data.get('companyName', '') == myCo()
        && (resource == null || resource.data.get('companyName', '돌캐') == myCo()));
      allow delete: if isTotalMasterUser();
    }
    // ── ⚙ 시스템 설정 — tenancy(운송사 분리 잠금 스위치) · forceUpdate(강제 업데이트)는 최고관리자만 바꾼다
    //  (예전엔 승인된 누구나 serverFilter를 끌 수 있어 회사 분리 자체를 풀 수 있었다)
    //  dataVersion은 회사마다 자기 회사 칸(시각)만 갱신
    match /systemConfig/{id} {
      allow get: if isSignedIn();
      allow list: if isTotalMasterUser();
      allow write: if isTotalMasterUser();
      allow create, update: if id == 'dataVersion' && isApproved() && !isShipperUser()
        && (resource == null ? request.resource.data.keys().hasOnly([myCo()])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly([myCo()]));
    }
    // ── 서버(Cloud Functions)만 쓰는 기록 — 화면에서 읽지 않는다
    //  closeReports · contractNoticeLogs · fleet_late_alerts · geo_cache · orderTrash · recurringRuns — 아래 공용 규칙 제외 목록에 넣어 막는다
    // 접속 이력(로그인·로그아웃) — 남기기는 본인 이름으로, 보기·정리는 최고관리자만(예전엔 누구나 다른 회사 접속 기록을 보고 지웠다)
    match /sessionLogs/{id} {
      allow create: if isSignedIn() && request.resource.data.get('uid', '') == request.auth.uid;
      allow read, update, delete: if isTotalMasterUser();
    }

    // ────────────────────────────────────────────────────────────
    // 🏢 PnK PROJECT 사내 인트라넷(pnk-site, 2026-11-10) — 로지스웹 고객사와 상관없는 본사 전용 데이터
    //  구성원 = pnkMembers/{uid} 문서가 status "active" 인 계정. 대표 = 최고관리자(isTotalMasterUser).
    //  관리자 = 대표 또는 role "owner" · "admin". 로지스웹 고객사 직원은 구성원 문서가 없으면 아무것도 못 본다.
    //  ⚠ 아래 컬렉션은 맨 아래 catchAllExcluded 목록에도 넣었다(빠지면 공용 규칙이 덮는다).
    // ────────────────────────────────────────────────────────────
    function pnkDoc() {
      return /databases/$(database)/documents/pnkMembers/$(request.auth.uid);
    }
    // 🔐 최고관리자 · 부관리자(totalMaster)는 이번 로그인에 대해 2차 인증(8자리)을 마쳐야 한다 — functions/pnkMfa.js 가 pnkMfaSessions/{uid} 를 적는다
    function pnkMfaOk() {
      return exists(/databases/$(database)/documents/pnkMfaSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/pnkMfaSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time
        && get(/databases/$(database)/documents/pnkMfaSessions/$(request.auth.uid)).data.until > request.time;
    }
    // 최고관리자 · 부관리자인지 — users 문서가 없는 계정(인트라넷에서 새로 가입한 직원)도 오류 없이 false
    function pnkIsTM() {
      return request.auth.token.get('email', '') == "tjddnqkf@naver.com"
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'totalMaster');
    }
    function pnkTM() {
      return pnkIsTM() && pnkMfaOk();
    }
    // 로지스웹 계정(users 문서가 있음) — 사내 인트라넷은 인트라넷 회원가입한 직원만(최고관리자 · 부관리자 예외)
    function pnkLogisweb() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function pnkStaff() {
      return isSignedIn() && (pnkIsTM() ? pnkMfaOk()
        : (!pnkLogisweb() && exists(pnkDoc()) && get(pnkDoc()).data.get('status', '') == 'active' && get(pnkDoc()).data.get('empNo', '') != ''));
    }
    function pnkAdmin() {
      return isSignedIn() && (pnkIsTM() ? pnkMfaOk()
        : (!pnkLogisweb() && exists(pnkDoc()) && get(pnkDoc()).data.get('status', '') == 'active' && get(pnkDoc()).data.get('empNo', '') != ''
          && get(pnkDoc()).data.get('role', '') in ['owner', 'admin']));
    }
    function pnkOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // 구성원 — 본인은 "승인 대기 · 직원"으로만 가입 요청, 이름·연락처만 고친다. 역할·상태는 관리자(대표 역할은 대표만)
    match /pnkMembers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || pnkStaff());
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == 'pending' && request.resource.data.role == 'staff'
          && request.resource.data.get('mailId', '') == '' && request.resource.data.get('empNo', '') == '' && !pnkLogisweb())
        || (request.auth.uid == uid && pnkTM())
        || (pnkAdmin() && request.resource.data.get('role', '') != 'owner'));
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && pnkOnly(['name', 'phone', 'bio', 'birthday', 'updatedAt']))
        || (pnkAdmin() && (pnkTM() || (request.resource.data.get('role', '') != 'owner' && resource.data.get('role', '') != 'owner'))));
      allow delete: if pnkAdmin() && (pnkTM() || resource.data.get('role', '') != 'owner');
    }
    // 공지 · 게시판 · 회의록 — 공지는 관리자만 쓰기. 누구나 읽음 표시(readBy)만 남길 수 있다
    match /pnkPosts/{id} {
      allow read: if pnkStaff();
      allow create: if pnkStaff() && request.resource.data.authorUid == request.auth.uid
        && (request.resource.data.board != 'notice' || pnkAdmin());
      allow update: if pnkStaff() && (
        ((resource.data.authorUid == request.auth.uid || pnkAdmin()) && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.board == resource.data.board)
        || pnkOnly(['readBy', 'updatedAt']));
      allow delete: if pnkStaff() && (resource.data.authorUid == request.auth.uid || pnkAdmin());
      match /comments/{cid} {
        allow read: if pnkStaff();
        allow create: if pnkStaff() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if pnkStaff() && (resource.data.authorUid == request.auth.uid || pnkAdmin());
      }
    }
    // 자료실 — adminOnly 자료는 관리자만 보고 올린다
    match /pnkFiles/{id} {
      allow read: if pnkStaff() && (resource.data.get('adminOnly', false) != true || pnkAdmin());
      allow create: if pnkStaff() && request.resource.data.uploaderUid == request.auth.uid
        && (request.resource.data.get('adminOnly', false) != true || pnkAdmin());
      allow update, delete: if pnkStaff() && (resource.data.uploaderUid == request.auth.uid || pnkAdmin());
    }
    // 업무 · 일정 · 영업 · 서비스 현황 — 구성원 누구나(지우기는 만든 사람 또는 관리자)
    match /pnkTasks/{id} {
      allow read, update: if pnkStaff();
      allow create: if pnkStaff() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if pnkStaff() && (resource.data.createdBy == request.auth.uid || pnkAdmin());
    }
    match /pnkEvents/{id} {
      allow read, update: if pnkStaff();
      allow create: if pnkStaff() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if pnkStaff() && (resource.data.createdBy == request.auth.uid || pnkAdmin());
    }
    match /pnkSales/{id} {
      allow read, update: if pnkStaff();
      allow create: if pnkStaff() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if pnkStaff() && (resource.data.createdBy == request.auth.uid || pnkAdmin());
    }
    match /pnkServices/{id} {
      allow read: if pnkStaff();
      allow write: if pnkAdmin();
    }
    match /pnkReleases/{id} {
      allow read: if pnkStaff();
      allow create: if pnkStaff() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if pnkStaff() && (resource.data.createdBy == request.auth.uid || pnkAdmin());
    }
    // 회사 정보 — info 는 구성원 모두 읽기, secure(계좌 · 인증서 위치 등)는 관리자만. 쓰기는 관리자
    match /pnkCompany/{docId} {
      allow read: if pnkStaff() && (docId != 'secure' || pnkAdmin());
      allow write: if pnkAdmin();
    }
    // 매출 · 비용 장부 — 관리자만
    match /pnkFinance/{id} {
      allow read, write: if pnkAdmin();
    }
    // 사내메일 — 보낸 사람 · 받는 사람만 읽는다. 받은 사람은 읽음 · 휴지통 · 별표 표시만 바꾼다(내용은 못 고침)
    match /pnkMail/{id} {
      allow read: if pnkStaff() && (request.auth.uid in resource.data.toUids || resource.data.fromUid == request.auth.uid);
      allow create: if pnkStaff() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUids is list && request.resource.data.toUids.size() <= 50
        && request.resource.data.get('extStatus', '') in ['', 'queued'] && request.resource.data.get('direction', '') != 'in'
        && request.resource.data.get('messageId', '') == '';
      allow update: if pnkStaff() && (request.auth.uid in resource.data.toUids || resource.data.fromUid == request.auth.uid)
        && pnkOnly(['readBy', 'trashBy', 'starBy', 'updatedAt']);
    }

    // 🎨 PnK 인트라넷 — 화면 편집(글자 · 모양 · 메뉴 · 테마). 로그인 화면 문구도 바꾸므로 누구나 읽기 · 쓰기는 최고관리자 · 부관리자(2차 인증 후)만
    match /pnkUi/{id} {
      allow read: if true;
      allow write: if isSignedIn() && pnkTM();
    }
    match /pnkUiHistory/{id} {
      allow read, write: if isSignedIn() && pnkTM();
    }
    // 🏢 PnK 인트라넷 — 사번 색인(사번 → uid). 같은 사번은 두 번 못 만든다(이미 있으면 create 가 아니라 update 라 막힘)
    //  로그인은 사번 + 이메일 + 비밀번호 — 로그인한 뒤 본인 구성원 문서의 사번과 맞춰 본다(로그인 전에는 아무것도 못 읽음)
    match /pnkEmpIndex/{empNo} {
      allow read: if pnkStaff();
      allow create: if isSignedIn() && (pnkAdmin() || (pnkTM() && request.resource.data.uid == request.auth.uid));
      allow delete: if pnkAdmin();
    }
    // 🏢 PnK 인트라넷 — 전자결재. 기안자 · 결재선 · 참조자(viewers)만 읽는다
    //  · 올리기: 기안자 본인, 진행 중(pending) · 첫 단계(step 0)로만
    //  · 결재: 지금 차례인 결재자(line[step].uid)가 line · step · status 만 바꾼다
    //  · 회수: 기안자가 진행 중인 문서를 canceled 로
    match /pnkApprovals/{id} {
      allow read: if pnkStaff() && (request.auth.uid in resource.data.viewers || pnkAdmin());
      allow create: if pnkStaff() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.step == 0
        && request.auth.uid in request.resource.data.viewers
        && request.resource.data.line is list && request.resource.data.line.size() >= 1 && request.resource.data.line.size() <= 8;
      allow update: if pnkStaff() && resource.data.status == 'pending' && (
        (resource.data.line[resource.data.step].uid == request.auth.uid
          && pnkOnly(['line', 'step', 'status', 'updatedAt', 'doneAt'])
          && request.resource.data.authorUid == resource.data.authorUid)
        || (resource.data.authorUid == request.auth.uid && request.resource.data.status == 'canceled' && pnkOnly(['status', 'updatedAt', 'doneAt'])));
      allow delete: if pnkAdmin();
    }
    // 🏢 PnK 인트라넷 — 출퇴근. 문서 번호 = {uid}_{날짜}. 본인 것만 찍고(출근 · 퇴근 · 메모), 지난 기록 고치기는 관리자
    match /pnkAttendance/{id} {
      allow read: if pnkStaff();
      allow create: if pnkStaff() && request.resource.data.uid == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
      allow update: if pnkStaff() && (pnkAdmin()
        || (resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.date == resource.data.date
          && pnkOnly(['outAt', 'outNote', 'note', 'place', 'workMin', 'updatedAt', 'outLate'])));
      allow delete: if pnkAdmin();
    }

    // ⭐ 2026-11-07 공용 규칙도 회사 검사 — 따로 규칙이 없는 컬렉션은 "문서의 companyName == 내 회사"인 문서만(최고관리자는 전체).
    //  예전: 승인된 계정이면 회사와 상관없이 모두 읽고 쓰기(users·메신저·기사 위치·운송사 신청서·시스템 스위치까지 — 이 목록에 없던 컬렉션 전부)
    //  ⚠ 따로 규칙을 둔 컬렉션은 반드시 아래 제외 목록에 넣는다(규칙은 "하나라도 허용하면 허용" — 빠지면 이 규칙이 따로 정한 규칙을 덮는다)
    function catchAllRead() {
      return isTotalMasterUser() || (isApproved() && !isShipperUser()
        && (resource == null || resource.data.get('companyName', '') == myCo()));
    }
    function catchAllWrite() {
      return isTotalMasterUser() || (isApproved() && !isShipperUser()
        && (resource == null || resource.data.get('companyName', '') == myCo())
        && (request.method == 'delete' || request.resource.data.get('companyName', '') == myCo()));
    }
    match /{col}/{rest=**} {
      allow read: if !catchAllExcluded(col) && catchAllRead();
      allow write: if !catchAllExcluded(col) && catchAllWrite();
    }
    function catchAllExcluded(col) {
      return col in [
        // 🏢 2026-11-10 PnK PROJECT 사내 인트라넷 — 위에서 따로 정함(빠지면 로지스웹 고객사 직원이 읽고 쓸 수 있다)
        'pnkMembers', 'pnkPosts', 'pnkFiles', 'pnkTasks', 'pnkEvents', 'pnkSales', 'pnkServices', 'pnkReleases', 'pnkCompany', 'pnkFinance', 'pnkMail',
        //  사번 색인 · 전자결재 · 출퇴근 · 메일 서버 비밀값(서버만) · 외부 발송 횟수(서버만)
        'pnkEmpIndex', 'pnkApprovals', 'pnkAttendance', 'pnkMailSecrets', 'pnkMailUsage', 'pnkMfaSecrets', 'pnkMfaSessions', 'pnkUi', 'pnkUiHistory',
        'adminSecrets', 'resetBackups', 'resetLogs', 'resetJobs', 'resetLocks', 'loginSessions', 'orderTrash', 'recurringRuns', 'internalMails', 'approvals', 'boardPosts', 'notices', 'handovers', 'salesQuotes', 'contracts', 'platformNotices', 'platformInvoices', 'companyPlans', 'publicPricing', 'planRequests', 'userPrefs', 'companyRoleOverrides', 'customRoles', 'supportRequests', 'supportSessions', 'driverStatements', 'fleetPenalties', 'driverContracts', 'fixedRoutes', 'routeBoards', 'personalSchedules', 'publicCompanies', 'companyContracts',
        // 🔒 회사별로 잠근 컬렉션(위에서 따로 정함)
        'orders', 'dispatch', 'dispatch_test', 'fixedClients', 'drivers', 'clients', 'places', 'recurringOrders', 'deletedOrders',
        'driver_completed_archive', 'notifications', 'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests',
        'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'approvalSettings', 'acctFunds',
        // ⭐ 2026-11-02 운임규칙 · 회사별 맞춤 기능(위에서 따로 정함)
        'fareRules', 'companyFeatures', 'companySettings', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes',
        // 🚚 2026-11-09 차량관리 자동화 — 카드 이용내역 · 회사별 소모품 주기 · 월 비용 리포트(위 회사 데이터 규칙에서 따로 정함)
        'vehicleCardTx', 'vehicleCareSettings', 'vehicleCostReports',
        // 🧾 2026-11-10 차량 비용 영수증 · 정기 차량 사진(위에서 따로 정함 — 빠지면 같은 회사 기사가 다른 기사 영수증을 고칠 수 있다)
        'vehicleExpenses', 'vehiclePhotoSettings', 'vehiclePhotos',
        // 💰 2026-11-04 플랫폼 운영 문서 — 위에서 따로 정함(예전엔 siteConfig가 이 목록에 없어 승인된 고객사 직원도 요금·관제 집계를 읽을 수 있었다)
        'siteConfig', 'platformConfig', 'platformUsage', 'usageCounters',
        // ⭐ 2026-11-05 기사 가입 처리 기록 — 위에서 따로 정함
        'driverSignupLogs',
        // ⭐ 2026-11-11 기사 합치기 기록 — 서버만 쓴다(여기에 넣어 화면에서는 읽기·쓰기 모두 막음)
        'driverMergeLog',
        // 🧯 2026-11-10 오류 신고 · 🛡 보안 알림 — 위에서 따로 정함(빠지면 승인된 직원이 회사명 없는 문서를 만들거나 고칠 수 있다)
        'errorReports', 'securityEvents', 'securityProfiles',
        // ⭐ 2026-11-06 문구 편집 모드 — 위에서 따로 정함(쓰기는 최고관리자만)
        'textOverrides', 'textOverridesPublic',
        // ⭐ 2026-11-07 화면 편집 모드 — 위에서 따로 정함(빠지면 승인된 직원 누구나 화면 설정을 고칠 수 있다)
        'uiConfig', 'uiConfigHistory',
        // ⭐ 2026-11-06 오더마켓 — 위에서 따로 정함(예전엔 이 목록에 없어 승인된 직원이면 누구나 게시글을 고칠 수 있었다)
        'cafeOrders', 'marketNotices',
        // ⭐ 2026-11-06 로지스웹 허브 콜 — 위에서 따로 정함(빠지면 배차 프로그램 직원 누구나 허브 회원·오더를 고칠 수 있다)
        'hubMembers', 'hubStats', 'hubQuota', 'hubOrders', 'hubNotices', 'hubReports',
        // ⭐ 2026-11-06 허브 위치관제 · 예치금 원장 · 설정 — 위에서 따로 정함(빠지면 배차 프로그램 직원 누구나 잔액을 쓸 수 있다)
        'hubLive', 'hubWallets', 'hubLedger', 'hubLedgerKeys', 'hubCharges', 'hubPayouts', 'hubAdjustments', 'hubDebts', 'hubSettings', 'hubAnnouncements',
        // ⭐ 2026-11-07 허브 고객관리 · 출금 · 배차 프로그램 허브 등록 요청 — 위에서 따로 정함(빠지면 다른 회사 장소 · 출금을 고칠 수 있다)
        'hubPlaces', 'hubWithdrawals', 'hubPostRequests',
        // 💰 2026-11-06 직원 급여 · 연차 촉진 — 위에서 따로 정함
        'payrollSettings', 'payrollEmployees', 'payrollRuns', 'payslips', 'hrNotices', 'leavePromotions',
        // 🔐 2026-11-07 급여 비밀번호 · 잠금 해제 · 틀린 횟수 — 위에서 따로 정함(서버만 쓴다)
        'payrollSecrets', 'payrollUnlocks', 'payrollPwAttempts',
        // 🔒 2026-11-10 비공개 청구운임 — 위에서 따로 정함(빠지면 같은 회사 직원 누구나 실제 청구 금액을 읽는다)
        'privateFareSettings',
        // 🤖 2026-11-06 AI 팀 사용 기록 — 위에서 따로 정함
        'aiTeamLogs',
        // 📊 2026-11-06 일일 경영 보고 — 위에서 따로 정함
        'dailyReportPrefs', 'dailyReportCompany', 'dailyReportLogs',
        // 🧠 2026-11-07 오더 스캔 회사별 학습 · 사용 횟수 — 위에서 따로 정함(빠지면 승인된 직원 누구나 다른 회사 학습 기록을 읽는다)
        'scanLearn', 'scanUsage',
