rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ⭐ 보안 1단계 — "가입만 하고 승인 안 된 계정"이 DB 전체를 읽고 쓰는 것을 막는다.
    // 앱(App.jsx)과 같은 기준: users/{uid} 문서가 있고, approved가 false가 아니며(예전 계정처럼
    // 값이 없으면 승인으로 봄), 퇴사 처리되지 않은 계정. 최고관리자 이메일은 항상 허용.
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         myUser().get('approved', true) != false &&
         myUser().get('employmentStatus', '') != '퇴사' &&
         // 배차마당(cafe-site) 가입 계정은 가입과 동시에 approved:true로 저장되므로
         // 배차 프로그램 데이터에는 접근할 수 없게 따로 제외한다(배차마당 컬렉션만 사용).
         myUser().get('role', '') != 'cafeUser' &&
         // ⭐ 2026-11-06 계약종료 — companyPlans/{회사}.status == "ended"인 운송사 사람(직원·기사, 화주는 연동 운송사)은
         //  데이터가 남아 있어도 아무것도 못 읽고 쓴다. 최고관리자·부관리자(role totalMaster)만 예외.
         //  문서 1개(get/exists 같은 문서 = 읽기 1회)만 더 본다.
         (myUser().get('role', '') == 'totalMaster' || !contractEnded(myUser())))
      );
    }
    function contractCoOf(u) {
      return u.get('role', '') == 'shipper'
        ? (u.get('linkedTransportCompany', null) is map ? u.linkedTransportCompany.get('companyName', '') : '')
        : u.get('companyName', '돌캐');
    }
    function contractEnded(u) {
      let co = contractCoOf(u);
      return co is string && co != '' &&
        exists(/databases/$(database)/documents/companyPlans/$(co)) &&
        get(/databases/$(database)/documents/companyPlans/$(co)).data.get('status', '') == 'ended';
    }
    // DriverLogin/DriverRegister의 차량번호 정규화와 동일(공백 제거 + 대문자)
    function plateId(carNo) {
      return carNo.trim().replace('\\s+', '').upper();
    }
    // 기사앱 로그인 — PC 기사관리에서 미리 등록한 차량(drivers/{차량번호})과 이름·회사명이 같으면
    // 승인 없이 approved:true로 가입시키는 기존 흐름을 서버에서도 똑같이 확인한다.
    // ⭐ 2026-11-02 점검 — 기본 회사가 아닌 운송사는 PC 선등록 문서 이름이 "회사__차량번호"(coDocKey)라
    //  예전 이름(차량번호)만 보던 확인이 실패해 기사 첫 로그인이 막히던 문제 — 두 이름 모두 확인
    function preKeyDoc(data) {
      return /databases/$(database)/documents/drivers/$(data.get('companyName', '').trim() + '__' + plateId(data.carNo));
    }
    function preDocMatches(p, data) {
      return exists(p) &&
        get(p).data.get('이름', get(p).data.get('name', '')).trim() == data.get('name', '').trim() &&
        get(p).data.get('companyName', '').trim() == data.get('companyName', '').trim();
    }
    function preRegisteredDriverOk(data) {
      return data.get('role', '') == 'driver' &&
        data.get('carNo', '') is string && data.get('carNo', '') != '' &&
        (preDocMatches(preKeyDoc(data), data) ||
         preDocMatches(/databases/$(database)/documents/drivers/$(plateId(data.carNo)), data));
    }
    // 본인 users 문서 쓰기 — 승인 여부/권한(role)을 스스로 올리는 것만 막는다.
    function selfUserWriteOk(userId) {
      return request.auth.uid == userId && (
        request.resource.data.get('approved', false) == false ||
        request.resource.data.get('role', '') == 'cafeUser' ||
        preRegisteredDriverOk(request.resource.data) ||
        (resource != null &&
         request.resource.data.get('approved', null) == resource.data.get('approved', null) &&
         request.resource.data.get('role', null) == resource.data.get('role', null))
      );
    }

    // ⭐ 프로그램 전역 설정(랜딩페이지 편집, 알림 문구 설정 등)은 최고관리자만
    // 읽고 쓸 수 있어야 한다 — AdminMenu.jsx의 isTotalMaster 판정 로직과 동일하게
    // (1) 고정된 총마스터 이메일이거나 (2) 본인 users 문서의 role이 "totalMaster"인
    // 경우만 인정한다. 클라이언트 쪽 isTotalMaster는 신뢰할 수 없으니(누구나 조작
    // 가능) 서버(규칙)에서 독립적으로 다시 검증한다.
    function isTotalMasterUser() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "totalMaster"
      );
    }

    // ────────────────────────────────────────────────────────────
    // 🏢 운송사(회사)별 데이터 잠금 — 2026-10-30
    // 회사 데이터는 문서의 companyName이 내 계정의 회사와 같을 때만 읽고 쓴다(최고관리자는 전체).
    // 앱은 조회할 때 "companyName == 우리 회사" 조건을 붙여서 보낸다(규칙은 조회 조건을 보고 판단).
    // ────────────────────────────────────────────────────────────
    function myCo() {
      return myUser().get('companyName', '돌캐');
    }
    // 잠금 스위치 — 관리센터 › 운송사 분리에서 "예전 데이터 정리 → 서버 분리 켜기"를 한 뒤에만 회사 검사를 한다.
    // (켜기 전에는 예전 규칙과 똑같이 동작하므로, 이 규칙을 먼저 배포해도 기존 화면이 깨지지 않는다)
    function locked() {
      return exists(/databases/$(database)/documents/systemConfig/tenancy) &&
        get(/databases/$(database)/documents/systemConfig/tenancy).data.get('serverFilter', false) == true;
    }
    function isShipperUser() {
      return myUser().get('role', '') == 'shipper';
    }
    // 같은 운송사 직원·기사
    function coMatch(d) {
      return isTotalMasterUser() || (isApproved() && (!locked() || (!isShipperUser() && d.companyName == myCo())));
    }
    // 새 문서는 반드시 우리 회사 이름으로
    function coCreate() {
      return isTotalMasterUser() || (isApproved() && (!locked() || (!isShipperUser() && request.resource.data.get('companyName', '') == myCo())));
    }
    // 수정해도 회사는 못 바꾼다
    function coKeep() {
      return isTotalMasterUser() || !locked() || request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
    }
    // 화주사 — 자기 회사가 등록/전송받은 오더만
    function shipperOwns(d) {
      return isApproved() && isShipperUser() && (d.get('shipperCompany', '') == myCo() || d.get('shipperUid', '') == request.auth.uid);
    }
    function shipperCreate() {
      return isApproved() && isShipperUser() && request.resource.data.get('shipperUid', '') == request.auth.uid;
    }

    // 비로그인 상태(기사)가 업로드 페이지에서 건드릴 수 있는 필드는 이 3개뿐이다.
    // 업로드토큰은 절대 포함하지 않는다 — 그건 로그인한 운송사 앱만 발급할 수 있어야
    // 링크 잠금/재발급 로직이 실제로 의미가 있다.
    // ⭐ 2026-11-02 점검 — 업로드 페이지(UploadPage.jsx)가 잠글 때 함께 쓰는 '업로드잠금해제만료'(비우기만)와
    //  '재업로드완료알림'(true만)도 허용 — 예전엔 이 두 칸 때문에 링크 잠금·재업로드 완료 알림 저장 전체가 거부됐다
    function isPublicOrderUpdate() {
      let aff = request.resource.data.diff(resource.data).affectedKeys();
      return aff.hasOnly(['attachCount', '위치공유중', '업로드잠금', '업로드잠금해제만료', '재업로드완료알림'])
        && (!aff.hasAny(['업로드잠금해제만료']) || request.resource.data.get('업로드잠금해제만료', null) == null)
        && (!aff.hasAny(['재업로드완료알림']) || request.resource.data.get('재업로드완료알림', false) == true);
    }

    // ────────────────────────────────────────────────────────────
    // 로그인 없이 접근하는 공개 배차/기사 관련 문서
    // (기사에게 문자/카톡으로 전달되는 인수증 업로드 링크, 통합 업로드 검색 링크)
    // ────────────────────────────────────────────────────────────
    // 🔒 오더 — 한 건 조회(get)는 업로드 링크(오더 번호 = 추측 불가)를 위해 열어 두고,
    //  목록 조회는 같은 운송사(또는 그 오더의 화주사)만. 기사 통합 업로드 검색은 서버 함수(driverSearch)로 옮겼다.
    match /orders/{id} {
      allow get: if true;
      allow list: if !locked() || coMatch(resource.data) || shipperOwns(resource.data);
      allow create: if coCreate() || shipperCreate();
      allow update: if (coMatch(resource.data) && coKeep()) || isPublicOrderUpdate() || shipperOwns(resource.data);
      allow delete: if coMatch(resource.data) || shipperOwns(resource.data);
    }
    match /dispatch/{id} {
      allow get: if true;
      allow list: if !locked() || coMatch(resource.data) || shipperOwns(resource.data);
      allow create: if coCreate() || shipperCreate();
      allow update: if (coMatch(resource.data) && coKeep()) || isPublicOrderUpdate() || shipperOwns(resource.data);
      allow delete: if coMatch(resource.data) || shipperOwns(resource.data);
    }
    match /dispatch_test/{id} {
      allow read, delete: if coMatch(resource.data);
      allow create: if coCreate();
      allow update: if coMatch(resource.data) && coKeep();
    }
    match /fixedClients/{id} {
      allow get: if true;
      allow list: if !locked() || coMatch(resource.data);
      allow update: if (coMatch(resource.data) && coKeep()) || isPublicOrderUpdate();
      allow create: if coCreate();
      allow delete: if coMatch(resource.data);
    }
    // 🧾 기사에게 보내는 서류 — 지급명세서(driverStatements) · 과태료·사고 서류(fleetPenalties)
    //  직원(기사·화주 제외)은 같은 회사 전체, 기사는 본인 것만 읽고 "확인" 표시만 바꿀 수 있다.
    function isOfficeStaff() {
      return isTotalMasterUser() || (isApproved() && !(myUser().get('role', '') in ['driver', 'shipper']));
    }
    match /{dcol}/{id} {
      allow read: if dcol in ['driverStatements', 'fleetPenalties'] && (
        (isOfficeStaff() && coMatch(resource.data)) || (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid));
      allow create: if dcol in ['driverStatements', 'fleetPenalties'] && isOfficeStaff() && coCreate();
      allow update: if dcol in ['driverStatements', 'fleetPenalties'] && (
        (isOfficeStaff() && coMatch(resource.data) && coKeep()) ||
        (isSignedIn() && resource.data.get('driverId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'confirmedAt', 'status', 'driverMemo', 'paidAt', 'objectedAt', 'driverAction'])));
      allow delete: if dcol in ['driverStatements', 'fleetPenalties'] && isOfficeStaff() && coMatch(resource.data);
    }
    // 📜 계약서 보관함(전자결재 › 계약서) — 직원만
    match /companyContracts/{id} {
      allow read, update, delete: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // 🛣 고정노선(지입차관리 › 고정노선) — 직원만
    match /fixedRoutes/{id} {
      allow read, update, delete: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // ⭐ 2026-11-03 개인 일정 — 본인만 읽고 쓴다(uid = 로그인한 사람)
    match /personalSchedules/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    // ⭐ 2026-11-02 배차표 양식(고정노선 › 배차표) — 회사 직원(기사·화주 제외)만
    match /routeBoards/{id} {
      allow read, update, delete: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    // ⭐ 2026-11-05 고정노선현황 › 운송업체 설정(routeCarrierSettings/{회사} = { companyName, carriers:[{name,on}], removed:[이름] })
    //  끈·삭제한 운송업체의 고정노선 오더는 정산·매출에서 빠진다 — 그 회사 직원(기사·화주 제외)은 읽고, 관리자급(isCompanyAdmin·test)만 바꾼다.
    //  문서 이름 = 회사명이라 잠금 스위치와 상관없이 다른 회사는 못 본다.
    match /routeCarrierSettings/{co} {
      allow read: if fareRulesStaff(co);
      allow create, update: if (isTotalMasterUser() || (isOfficeStaff() && myCo() == co && (isCompanyAdmin(co) || myUser().get('role', '') == 'test')))
        && request.resource.data.get('companyName', '') == co;
      allow delete: if isTotalMasterUser() || isCompanyAdmin(co);
    }
    // ⭐ 2026-11-02 운임규칙 — 회사별 운임 규칙(fareRules/{회사}) — 그 회사 직원(기사·화주 제외)만 읽고,
    //  조회전용(viewer)이 아닌 직원은 누구나 수정. 문서 이름 = 회사명이라 잠금 스위치와 상관없이 다른 회사는 못 본다.
    function fareRulesStaff(co) {
      return isTotalMasterUser() || (isOfficeStaff() && myCo() == co);
    }
    // 회사별 맞춤 기능(companyFeatures/{회사} = { fareRules: true, … }) — 최고관리자(관리자센터)만 켜고 끈다.
    //  그 회사 승인 직원은 읽기만(켜진 회사에만 메뉴가 보이게)
    // ⭐ 2026-11-03 회사 설정(공지 작성 권한 등) — 같은 회사는 읽고, 그 회사 마스터·최고관리자만 바꾼다
    match /companySettings/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser() || (isApproved() && myCo() == co && myUser().get('isMaster', false) == true);
      // 사업자 목록(bizList)은 관리자·경리·인사도(공지 작성 권한은 못 바꿈)
      // ⭐ 2026-11-04 통합관리자(allMgr = 운송+경리+인사)·경리사무원(acctStaff)도
      allow create: if isApproved() && myCo() == co && myUser().get('role', '') in ['admin', 'allMgr', 'hrAcct', 'hrManager', 'test', 'acctStaff']
        && request.resource.data.keys().hasOnly(['companyName', 'bizList', 'bizListAt', 'bizMemory']);
      allow update: if isApproved() && myCo() == co && myUser().get('role', '') in ['admin', 'allMgr', 'hrAcct', 'hrManager', 'test', 'acctStaff']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'bizList', 'bizListAt', 'bizMemory']);
      // ⭐ 2026-11-03 청구 사업자 기억(bizMemory: 거래처+상차지+하차지 → 사업자 이름) — 실무자(user)도 오더를 저장할 때 함께 기록한다(이 칸만)
      allow update: if isApproved() && myCo() == co && myUser().get('role', '') in ['admin', 'allMgr', 'hrAcct', 'hrManager', 'test', 'acctStaff', 'hrStaff', 'user']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bizMemory']);
    }
    // 🎨 2026-11-03 표 컬럼 색(회사 공용) — 그 회사 직원은 읽고, 둘러보기(viewer) 말고는 바꿀 수 있다
    match /colStyles/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser() || (isApproved() && myCo() == co && myUser().get('role', '') != 'viewer'
        && request.resource.data.get('companyName', '') == co);
    }
    match /companyFeatures/{co} {
      allow read: if isTotalMasterUser() || (isApproved() && myCo() == co);
      allow write: if isTotalMasterUser();
    }
    function fareFeatureOn(co) {
      return exists(/databases/$(database)/documents/companyFeatures/$(co))
        && get(/databases/$(database)/documents/companyFeatures/$(co)).data.get('fareRules', false) == true;
    }
    // ⭐ 2026-11-04 운임구분 바로 추가 — 오더 화면 운임구분 드롭다운에서 새 규칙을 바로 추가(rules·history arrayUnion, merge)해도
    //  아래 update 조건(조회전용 아닌 그 회사 직원 + 기능 켜짐 + companyName 유지) 그대로 통과 → 규칙 변경 없음
    match /fareRules/{co} {
      allow read: if fareRulesStaff(co);
      allow create: if fareRulesStaff(co) && myUser().get('role', '') != 'viewer' && (isTotalMasterUser() || fareFeatureOn(co))
        && request.resource.data.get('companyName', '') == co;
      allow update: if fareRulesStaff(co) && myUser().get('role', '') != 'viewer' && (isTotalMasterUser() || fareFeatureOn(co))
        && request.resource.data.get('companyName', '') == co;
      allow delete: if fareRulesStaff(co) && isCompanyAdmin(co);
    }
    // 🔒 회사 데이터(거래처·하차지·정기오더·삭제기록·알림·일정·메일·인사·근태신청·회계·결재선)
    // ⭐ 2026-11-02 점검 — approvalSettings(결재 설정)는 아래 전자결재 쪽 전용 규칙으로 옮김(누구나 임원 자동 승인을 켜던 문제)
    match /{tcol}/{id} {
      allow read: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes']
        // ⭐ 2026-11-02 점검 — 없는 문서를 getDoc하면 resource가 null이라 coMatch(resource.data)가 오류 → 거부되던 문제
        //  (ledgerAuto.js 자동 장부의 "새 줄인지" 확인). 없는 문서는 승인된 계정이면 "없음"만 알 수 있게 허용
        && ((resource == null && isApproved()) || coMatch(resource.data));
      allow create: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes']
        && coCreate();
      allow update: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes']
        && coMatch(resource.data) && coKeep();
      allow delete: if tcol in ['clients', 'places', 'recurringOrders', 'deletedOrders', 'driver_completed_archive', 'notifications',
          'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests', 'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes']
        && coMatch(resource.data);
    }
    // 💰 자금(통장·현금 잔액) — 경리(test)·관리자(대표 등)만. 화면에서는 경리 + 대표 직책만 보이게 한다
    // ⭐ 2026-11-02 점검 — 권한 관리에서 직접 만든 역할에 '자금관리' 메뉴를 켜면(읽기 → 조회, 쓰기 → 등록·수정·삭제) 자금 데이터도 허용
    //  (화면의 mergeCompanyRoles + getMenuAccess와 같은 순서: 운송사별 설정의 menus가 있으면 공통 역할 menus 대신 쓴다. 내장 역할은 제외)
    function fundsMenuLevel() {
      let r = myUser().get('role', '');
      let p = /databases/$(database)/documents/customRoles/$(r);
      let ov = /databases/$(database)/documents/companyRoleOverrides/$(myUser().get('companyName', ''));
      let g = exists(p) ? get(p).data : {};
      let o = exists(ov) ? get(ov).data.get('roles', {}).get(r, {}) : {};
      let menus = ('menus' in o) ? o.get('menus', {}) : g.get('menus', {});
      // (사무원·법무·개발 역할은 직접 만든 역할처럼 메뉴 설정을 따른다 — 통합관리자는 아래 역할 목록으로)
      return (r != '' && !(r in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'user', 'test', 'viewer', 'totalMaster', 'driver', 'shipper'])
        && (exists(p) || o.size() > 0)) ? menus.get('자금관리', 'hidden') : 'hidden';
    }
    match /acctFunds/{id} {
      allow read: if coMatch(resource.data) && (isTotalMasterUser() || myUser().get('role', '') in ['test', 'admin', 'hrAcct', 'allMgr'] || isExecRoleUser() || fundsMenuLevel() in ['read', 'write']);
      allow create: if coCreate() && (isTotalMasterUser() || myUser().get('role', '') in ['test', 'admin', 'hrAcct', 'allMgr'] || fundsMenuLevel() == 'write');
      allow update: if coMatch(resource.data) && coKeep() && (isTotalMasterUser() || myUser().get('role', '') in ['test', 'admin', 'hrAcct', 'allMgr'] || fundsMenuLevel() == 'write');
      allow delete: if coMatch(resource.data) && (isTotalMasterUser() || myUser().get('role', '') in ['test', 'admin', 'hrAcct', 'allMgr'] || fundsMenuLevel() == 'write');
    }
    // 화주사 주소록(places) — 화주 본인이 등록한 주소만
    match /places/{id} {
      allow read, update, delete: if isApproved() && isShipperUser() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isApproved() && isShipperUser() && request.resource.data.get('userId', '') == request.auth.uid;
    }
    // 알림 — 받는 사람 본인은 읽고 "읽음" 표시
    match /notifications/{id} {
      allow read: if isApproved() && resource.data.get('toUid', '') == request.auth.uid;
      allow update: if isApproved() && resource.data.get('toUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // 기사전달용 업로드 링크 단축 — /u/{code}가 로그인 없이 code로 원본
    // (오더id+토큰)을 조회해 /upload로 넘겨줘야 한다. list는 막아서 전체
    // 코드 목록이 노출되지 않게 하고, 발급(create/update)은 로그인한
    // 운송사 앱에서만 가능하게 한다.
    match /shortLinks/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isApproved();
      allow delete: if isApproved();
    }

    // 인수증/서류 첨부 — 오더 문서 id만 알면 사진을 올리고 확인·삭제(되돌리기)할 수 있어야 한다.
    // 첨부 문서 id는 추측 불가능한 Firestore 자동 id라 list를 막아도 기능에 지장이 없다.
    match /{col}/{orderId}/attachments/{attId} {
      allow get, create, delete: if true;
      allow list, update: if isApproved();
    }

    // 수동 업로드(오더 id 없이 들어온 기사) — 새 메타 문서 생성만 허용, 조회는 로그인 사용자만.
    match /driver_uploads/{id} {
      allow create: if true;
      allow get, list, update, delete: if isApproved();
    }

    // 홈페이지(랜딩페이지) 도입 문의 — 로그인 없는 방문자가 폼으로 제출만 할 수 있고,
    // 목록 조회/상태 변경은 관리자메뉴(로그인 사용자)만 가능하다.
    match /landingInquiries/{id} {
      allow create: if true;
      allow get, list, update, delete: if isApproved();
    }

    // 실시간 위치공유 — 업로드 페이지에서 오더 id로만 쓰고 읽는다. 전체 목록 열람은 로그인 사용자만.
    match /liveLocations/{id} {
      allow get, create, update: if true;
      allow list, delete: if isApproved();
    }

    // ────────────────────────────────────────────────────────────
    // ⭐ 2026-11-06 오더마켓(예전 배차마당) — 운송사끼리 오더를 주고받는 거래소
    //  · 게시글 본문(cafeOrders)은 로그인 회원 전체 열람. 새 글(v 2)은 시/구까지만 담고, 상·하차지명·정확한 주소·연락처는
    //    private/detail 에 따로 둔다 → 올린 운송사 + 매칭된 운송사만 열람. private/settle(청구 운임·수수료)은 올린 운송사만.
    //  · 새 글 등록·잡기 요청·수락은 승인된 운송사 직원 계정만(배차마당 가입 계정·기사·화주·조회전용 제외).
    //  · 예전 글(v 없음)은 예전 규칙(10초 배차신청 · contact/info 연락처)을 그대로 따른다.
    // ────────────────────────────────────────────────────────────
    function isMarketCompany() {
      return isApproved() && !(myUser().get('role', '') in ['driver', 'shipper', 'cafeUser', 'viewer'])
        && myUser().get('companyName', '') != '';
    }
    function mkDoc(orderId) {
      return get(/databases/$(database)/documents/cafeOrders/$(orderId)).data;
    }
    function mkPoster(d) {
      return isSignedIn() && d.get('posterUid', '') == request.auth.uid;
    }
    function mkTaker(d) {
      return isSignedIn() && d.get('takerUid', '') == request.auth.uid && d.get('status', '') in ['matched', 'dispatched', 'delivered'];
    }
    function mkV2(d) {
      return d.get('v', 0) >= 2;
    }
    // 요청자 목록은 "내 uid 하나"만 넣고 뺄 수 있다
    function mkOnlyMyUid() {
      let before = resource.data.get('requesterUids', []).toSet();
      let after = request.resource.data.get('requesterUids', []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).hasOnly([request.auth.uid]);
    }
    match /cafeOrders/{orderId} {
      allow read: if isSignedIn();
      // 새 글 — 우리 회사 이름으로, 모집중 상태로, 정확한 주소·지명·연락처 없이
      allow create: if isMarketCompany()
        && request.resource.data.get('v', 0) == 2
        && request.resource.data.get('posterUid', '') == request.auth.uid
        && request.resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('takerUid', null) == null
        && !request.resource.data.keys().hasAny(['상차지명', '상차지주소', '하차지명', '하차지주소', 'posterPhone', '상차지담당자번호', '하차지담당자번호']);
      allow update: if
        // ① 올린 운송사 — 회사·작성자는 못 바꾸고, 매칭 상대는 실제로 요청한 운송사만
        (mkPoster(resource.data)
          && request.resource.data.get('posterUid', '') == resource.data.get('posterUid', '')
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
          && request.resource.data.get('v', 0) == resource.data.get('v', 0)
          && (!mkV2(resource.data) || !request.resource.data.keys().hasAny(['상차지주소', '하차지주소', 'posterPhone']))
          && (request.resource.data.get('takerUid', null) == null
              || request.resource.data.get('takerUid', null) == resource.data.get('takerUid', null)
              || (resource.data.get('status', '') == 'open'
                  && exists(/databases/$(database)/documents/cafeOrders/$(orderId)/requests/$(request.resource.data.takerUid))
                  && get(/databases/$(database)/documents/cafeOrders/$(orderId)/requests/$(request.resource.data.takerUid)).data.get('status', '') == 'pending'))) ||
        // ② 잡기 요청/철회 — 다른 운송사가 요청자 목록에 자기 uid만 넣고 뺀다
        (mkV2(resource.data) && isMarketCompany() && !mkPoster(resource.data)
          && resource.data.get('status', '') == 'open' && resource.data.get('companyName', '') != myCo()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requesterUids', 'updatedAt'])
          && mkOnlyMyUid()) ||
        // ③ 매칭된 운송사 — 진행 단계(앞으로만)·내 프로그램 오더 번호·평가만
        (mkV2(resource.data) && mkTaker(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'takerOrderId', 'dispatchedAt', 'deliveredAt', 'driverMasked', 'ratingByTaker', 'updatedAt'])
          && request.resource.data.get('status', '') in ['matched', 'dispatched', 'delivered']
          && (request.resource.data.get('takerOrderId', null) == resource.data.get('takerOrderId', null)
              || request.resource.data.get('takerOrderId', '') == 'mkt_' + orderId)) ||
        // ④ 예전 글 — 10초 배차신청 흐름(신청·취소·확정)
        (!mkV2(resource.data) && isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'applicantUid', 'applicantName', 'applicantNickname', 'applyRequestedAt', 'confirmedAt', 'updatedAt'])
          && request.resource.data.get('status', '') in ['open', 'applying', 'confirmed']);
      allow delete: if mkPoster(resource.data);

      // 비공개 상세(detail: 올린 운송사 + 매칭된 운송사) · 정산 메모(settle: 올린 운송사만)
      match /private/{docId} {
        allow read: if mkPoster(mkDoc(orderId)) || (docId == 'detail' && mkTaker(mkDoc(orderId)));
        allow create, update: if docId in ['detail', 'settle'] && isSignedIn()
          && getAfter(/databases/$(database)/documents/cafeOrders/$(orderId)).data.get('posterUid', '') == request.auth.uid;
        allow delete: if mkPoster(mkDoc(orderId));
      }

      // 잡기 요청 — 문서 이름 = 요청한 운송사 계정 uid
      match /requests/{rid} {
        allow get: if isSignedIn() && (request.auth.uid == rid || mkPoster(mkDoc(orderId)));
        allow list: if mkPoster(mkDoc(orderId));
        allow create: if isMarketCompany() && request.auth.uid == rid
          && mkV2(mkDoc(orderId)) && mkDoc(orderId).get('status', '') == 'open'
          && mkDoc(orderId).get('posterUid', '') != rid && mkDoc(orderId).get('companyName', '') != myCo()
          && request.resource.data.get('takerUid', '') == rid
          && request.resource.data.get('takerCompany', '') == myCo()
          && request.resource.data.get('status', '') == 'pending';
        allow update: if
          // 요청한 운송사 — 다시 요청(pending) / 철회(withdrawn)
          (isMarketCompany() && request.auth.uid == rid
            && request.resource.data.get('takerUid', '') == rid
            && request.resource.data.get('takerCompany', '') == myCo()
            && request.resource.data.get('status', '') in ['pending', 'withdrawn']
            && (request.resource.data.get('status', '') == 'withdrawn' || mkDoc(orderId).get('status', '') == 'open')) ||
          // 올린 운송사 — 수락/거절/마감/매칭취소 표시만
          (mkPoster(mkDoc(orderId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'updatedAt'])
            && request.resource.data.get('status', '') in ['accepted', 'rejected', 'closed', 'cancelled']);
        allow delete: if false;
      }

      // (예전 글) 연락처 — "배차완료" 상태에서 당사자(등록자/신청자)만
      match /contact/{docId} {
        allow read: if isSignedIn() &&
          mkDoc(orderId).status == "confirmed" &&
          (request.auth.uid == mkDoc(orderId).posterUid || request.auth.uid == mkDoc(orderId).applicantUid);
        allow write: if isSignedIn() && !mkV2(getAfter(/databases/$(database)/documents/cafeOrders/$(orderId)).data);
      }
    }
    // ⭐ 2026-11-06 오더마켓 알림 — 받는 사람 본인만 읽고 "읽음" 표시. 보내기는 운송사 계정이 자기 이름으로만.
    match /marketNotices/{id} {
      allow read: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create: if isMarketCompany()
        && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('toUid', '') is string && request.resource.data.get('toUid', '') != request.auth.uid
        && request.resource.data.get('read', true) == false
        && exists(/databases/$(database)/documents/cafeOrders/$(request.resource.data.get('orderId', '_')));
      allow delete: if isSignedIn() && resource.data.get('toUid', '') == request.auth.uid;
    }

    // ────────────────────────────────────────────────────────────
    // 프로그램 전역 설정 — 최고관리자만 설정/열람 가능(요청사항).
    // 단 siteConfig/landing(로그인 전 랜딩페이지 커스터마이징)은 그 페이지 자체가
    // 로그인 없이 열리므로 읽기만은 누구나 가능해야 한다 — 그래야 방문자 화면에
    // 실제로 반영된다. 쓰기는 여기도 최고관리자만.
    // ────────────────────────────────────────────────────────────
    match /siteConfig/landing {
      allow get: if true;
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    // siteConfig/labels(프로그램 전체 편집모드의 글자 오버라이드)는 전체 사용자
    // 화면에 반영돼야 하니 읽기는 로그인한 사용자 전체 허용, 쓰기(=편집)만
    // 최고관리자로 제한한다 — landing과 같은 이유의 예외.
    match /siteConfig/labels {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    // ⭐ 2026-11-06 문구 편집 모드(src/textOverrides.js) — 화면 글자 덮어쓰기 사전.
    //  읽기: 로그인한 사용자 전체(기사·화주 포함 — 그들 화면에도 반영) · 쓰기: 최고관리자(부관리자 포함)만.
    //  textOverridesPublic은 로그인 전 화면(로그인·기사 로그인 등)용 사본이라 누구나 읽기만 가능.
    match /textOverrides/{id} {
      allow read: if isSignedIn();
      allow write: if isTotalMasterUser();
    }
    match /textOverridesPublic/{id} {
      allow read: if true;
      allow write: if isTotalMasterUser();
    }
    // 💼 영업 견적(관리센터 › 영업) — 최고관리자만
    match /salesQuotes/{id} {
      allow read, write: if isTotalMasterUser();
    }
    // ✍ 전자계약 — 계약 ID(추측 불가 18자)를 아는 사람만 한 건씩 열람(get) 가능, 목록은 최고관리자만.
    //  고객(로그인 없음)은 "발송" 상태일 때 ① 처음 열람 시각(viewedAt) 또는 ② 서명 관련 칸만 채워 "서명완료"로 바꿀 수 있다.
    match /contracts/{id} {
      allow get: if true;
      allow list, create, delete: if isTotalMasterUser();
      allow update: if isTotalMasterUser()
        || (resource.data.status == '발송'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
            && !('viewedAt' in resource.data))
        || (resource.data.status == '발송'
            && request.resource.data.status == '서명완료'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt', 'signer', 'signatureImg', 'signerAgent', 'signedHash', 'consent'])
            && request.resource.data.signatureImg is string
            && request.resource.data.signatureImg.size() < 600000);
    }
    // 📢 플랫폼 공지(관리센터 → 고객사 배너 + 운송사 공지사항 목록) — 최고관리자 쓰기
    // ⭐ 2026-11-02 관리자센터2 — 대상별 읽기: 전체/전체 운송사/전체 화주사 공지는 로그인 사용자 누구나,
    //  "선택한 운송사" 공지(audience 'selected')는 targetCompanies에 내 회사가 있을 때만.
    //  앱 조회: where(audience in [...]) 와 where(targetCompanies array-contains 우리 회사) 두 가지 — 둘 다 이 규칙으로 증명된다.
    match /platformNotices/{id} {
      allow read: if isTotalMasterUser()
        || (isSignedIn() && (resource.data.audience in ['all', 'carrier', 'shipper']
            || myCo() in resource.data.targetCompanies));
      allow write: if isTotalMasterUser();
      // ⭐ 2026-11-03 조회수 — 승인된 사용자는 본 사람 목록(viewedBy)만 더할 수 있다(한 계정 1회)
      allow update: if isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
    }
    // 🧾 플랫폼 청구·입금 기록 — 최고관리자는 전부, 고객사는 자기 회사 청구서만 읽고 "입금 알림(payNotice)"만 남길 수 있다
    // ⭐ 2026-11-03 구독·결제 권한(src/billingAccess.js와 같은 기준) — 보기: 경리팀·재무·임원·대표 / 입금 알림: 경리팀·재무만
    function isBillingFinance() {
      return myUser().get('role', '') in ['test', 'hrAcct', 'allMgr', 'acctStaff'] || string(myUser().get('team', '')).matches('.*(경리|회계|재무).*');
    }
    function isBillingViewer() {
      return isBillingFinance() || isExecProfileUser();
    }
    match /platformInvoices/{id} {
      allow read: if isTotalMasterUser()
        || (isApproved() && resource.data.company == myUser().get('companyName', '') && isBillingViewer());
      allow write: if isTotalMasterUser();
      allow update: if isApproved()
        && resource.data.company == myUser().get('companyName', '')
        && isBillingFinance()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payNotice']);
    }
    // 💳 회사별 요금제 — 로그인 사용자는 읽기(메뉴 잠금 판단), 지정은 최고관리자만
    // 🏢 가입 화면용 공개 운송사 목록(이름·주소) — 로그인 전에도 읽는다
    match /publicCompanies/{id} {
      allow read: if true;
      allow write: if isTotalMasterUser() || (isApproved() && request.resource.data.get('companyName', '') == myUser().get('companyName', ''));
    }
    match /companyPlans/{company} {
      allow read: if isSignedIn();
      allow write: if isTotalMasterUser();
    }
    // 💳 공개 요금(가격·포함량·입금 계좌) — 고객사 화면의 요금 비교·결제 안내용
    match /publicPricing/{id} {
      allow read: if isSignedIn();
      allow write: if isTotalMasterUser();
    }
    // 💳 요금제 변경 요청 — 고객사는 자기 회사 이름으로만 만들 수 있고, 처리는 최고관리자
    match /planRequests/{id} {
      // ⭐ 2026-11-01 요금제 변경 요청은 경리팀(경리·경리+인사·경리/회계 부서)만 · 2026-11-03 재무 부서 · 최고관리자 추가(임원·대표는 보기만)
      allow create: if isTotalMasterUser() || (isApproved() && request.resource.data.company == myUser().get('companyName', '') && isBillingFinance());
      allow read, update, delete: if isTotalMasterUser();
    }
    match /siteConfig/{docId} {
      allow get, list: if isTotalMasterUser();
      allow write: if isTotalMasterUser();
    }
    // 💰 2026-11-04 플랫폼 비용·손익 — 비용 기준(단가·무료량·고정비)은 최고관리자만. 고객사에는 절대 보이지 않게.
    match /platformConfig/{docId} {
      allow read, write: if isTotalMasterUser();
    }
    // 🤖 2026-11-06 AI 팀 사용 기록 — 쓰기는 서버(Cloud Functions)만, 읽기는 최고관리자·부관리자만
    match /aiTeamLogs/{docId} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 서버 사용량(Cloud Monitoring 수집 결과) — 쓰기는 서버(Cloud Functions)만, 읽기는 최고관리자만
    match /platformUsage/{docId} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 회사별 사용량 표본(앱이 10분마다 increment) — 승인된 같은 회사 직원·기사는 자기 회사 문서의 숫자 칸만 늘릴 수 있다. 읽기는 최고관리자만
    match /usageCounters/{docId} {
      allow read, delete: if isTotalMasterUser();
      allow create: if isApproved() && !isShipperUser()
        && request.resource.data.get('company', '') == myCo()
        && request.resource.data.get('month', '') is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['company', 'month', 'reads', 'writes', 'sessions', 'updatedAt'])
        && request.resource.data.get('reads', 0) is number && request.resource.data.get('reads', 0) < 5000000
        && request.resource.data.get('writes', 0) is number && request.resource.data.get('writes', 0) < 1000000;
      allow update: if isApproved() && !isShipperUser()
        && resource.data.get('company', '') == myCo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads', 'writes', 'sessions', 'updatedAt'])
        && request.resource.data.get('reads', 0) >= resource.data.get('reads', 0)
        && request.resource.data.get('writes', 0) >= resource.data.get('writes', 0)
        && request.resource.data.get('sessions', 0) >= resource.data.get('sessions', 0)
        && request.resource.data.get('reads', 0) - resource.data.get('reads', 0) < 5000000
        && request.resource.data.get('writes', 0) - resource.data.get('writes', 0) < 1000000;
    }

    // ────────────────────────────────────────────────────────────
    // 가입 진행 중(승인 전) 계정에 필요한 최소 권한 — 승인된 계정은 기존과 동일
    // ────────────────────────────────────────────────────────────
    // ⭐ 2026-11-01 입사일은 인사팀만 바꾼다(인사관리부 › 직원 정보·퇴사). 가입 때 처음 넣는 것은 허용
    function isHrStaff() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "tjddnqkf@naver.com" ||
        myUser().get('role', '') in ['hrManager', 'hrAcct', 'allMgr', 'hrStaff', 'totalMaster'] ||
        myUser().get('team', '').matches('.*인사.*'));
    }
    function hireDateSame() {
      return resource == null ||
        request.resource.data.get('hireDate', '') == resource.data.get('hireDate', '');
    }
    match /users/{userId} {
      allow get: if isApproved() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isApproved();
      allow create, update: if isSignedIn() && (
        (isApproved() && request.auth.uid != userId) ||
        isTotalMasterUser() ||
        selfUserWriteOk(userId)
      ) && (hireDateSame() || isHrStaff()) && roleEscalationOk();
      allow delete: if isApproved();
    }
    match /userProfiles/{userId} {
      allow read, delete: if isApproved() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if (isApproved() || (isSignedIn() && request.auth.uid == userId)) &&
        (hireDateSame() || isHrStaff());
    }
    // 기사 본인 서류(가입 때 사업자등록증 등) — 본인이 올리고 본인이 본다(직원은 아래 공용 규칙)
    match /driver_documents/{id} {
      allow create: if isSignedIn() && request.resource.data.get('driverId', '') == request.auth.uid;
      allow read: if isSignedIn() && resource.data.get('driverId', '') == request.auth.uid;
    }
    match /drivers/{driverId} {
      // 기사앱 가입/로그인 때 차량번호 문서(PC 선등록) 확인용 단건 조회
      allow get: if isSignedIn();
      // 🔒 기사·지입차 목록은 같은 운송사만
      allow list: if coMatch(resource.data);
      allow create: if coCreate() || (isSignedIn() && request.auth.uid == driverId);
      allow update: if (coMatch(resource.data) && coKeep()) || (isSignedIn() && request.auth.uid == driverId);
      // 가입 후 선등록 문서(drivers/{차량번호}) 정리 — 승인 전에는 본인 차량번호 문서만
      // ⭐ 2026-11-02 점검 — 기본 회사가 아닌 운송사의 선등록 문서(회사__차량번호)도 본인이 정리할 수 있게(중복 기사 문서 방지)
      allow delete: if coMatch(resource.data) || (isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myUser().get('carNo', '') is string && myUser().get('carNo', '') != '' &&
        (plateId(myUser().carNo) == driverId ||
         myUser().get('companyName', '').trim() + '__' + plateId(myUser().carNo) == driverId));
    }
    // ⭐ 2026-11-05 기사 가입 승인·거절 처리 기록(거절 사유 등) — 같은 운송사 직원만 보고 남긴다. 고치거나 지울 수 없음
    match /driverSignupLogs/{id} {
      allow read: if isOfficeStaff() && coMatch(resource.data);
      allow create: if isOfficeStaff() && coCreate();
    }
    match /transportApplications/{id} {
      allow create: if isSignedIn();
      allow get, list, delete: if isApproved();
      allow update: if isApproved() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address']));
    }
    match /companyApplications/{id} {
      allow create: if isSignedIn();
      allow get, list: if isApproved() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isApproved();
      allow update: if isApproved() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['address']));
    }
    // ⭐ 로그인 관리 — 기기별 로그인 기록. 본인 기록은 승인 전 계정(화주 승인대기 등)도 읽고 쓸 수 있어야
    // 중복 로그인 확인·연결 끊기가 된다. 관리자는 전체(강제 로그아웃).
    match /loginSessions/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isApproved());
      // ⭐ 최고관리자의 로그인은 본인 또는 최고관리자만 끊을 수 있다(관리자도 불가)
      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isTotalMasterUser() ||
        (isApproved() && resource.data.get('role', '') != 'totalMaster' && resource.data.get('email', '') != 'tjddnqkf@naver.com')
      );
      allow delete: if isTotalMasterUser();
    }
    // 운송사 초기화 비밀번호(해시) — 서버(Cloud Functions)만 읽고 쓴다
    match /adminSecrets/{id} {
      allow read, write: if false;
    }
    // 초기화 보관함(7일) — 서버만 읽고 쓴다(화면은 서버 함수를 통해 목록·복원)
    match /resetBackups/{document=**} {
      allow read, write: if false;
    }
    // 초기화·복원 진행률 — 최고관리자 화면이 실시간으로 읽는다(쓰기는 서버만)
    match /resetJobs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    match /resetLogs/{id} {
      allow read: if isTotalMasterUser();
      allow write: if false;
    }
    // 📧 사내메일함 — 보낸 사람·받는 사람만 읽고, 받은 사람은 읽음/삭제 표시만 고칠 수 있다.
    match /internalMails/{id} {
      // ⭐ 2026-10-28 메일함 고도화 — status: sent(기본) | draft(임시보관) | scheduled(예약, 서버가 보낼 때 to를 채운다)
      //  임시보관·예약 메일은 to가 비어 있어야 해서 받는 사람이 미리 볼 수 없다.
      allow read: if isApproved() && (request.auth.uid in resource.data.get('to', []) || resource.data.get('fromUid', '') == request.auth.uid);
      allow create: if isApproved() && request.resource.data.get('fromUid', '') == request.auth.uid
        && request.resource.data.get('to', []) is list && request.resource.data.get('to', []).size() <= 500
        && (!(request.resource.data.get('status', 'sent') in ['draft', 'scheduled']) || request.resource.data.get('to', []).size() == 0);
      allow update: if isApproved() && (
        (request.auth.uid in resource.data.get('to', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy', 'starredBy', 'purgedBy']))
        || (resource.data.get('fromUid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy', 'starredBy', 'purgedBy', 'recalledFor']))
        || (resource.data.get('fromUid', '') == request.auth.uid && resource.data.get('status', 'sent') in ['draft', 'scheduled']
          && request.resource.data.get('fromUid', '') == request.auth.uid && request.resource.data.get('status', 'sent') in ['draft', 'scheduled']
          && request.resource.data.get('to', []).size() == 0));
      allow delete: if isApproved() && resource.data.get('fromUid', '') == request.auth.uid && resource.data.get('status', 'sent') in ['draft', 'scheduled'];
    }
    // 📝 전자결재(2026-10-28) — 기안자·결재자·참조자(participants)만 보고, 관리자는 자기 회사 문서를 모두 본다.
    function isSuperEmail() {
      return request.auth.token.get('email', '') == "tjddnqkf@naver.com"
        // ⭐ 2026-11-05 부관리자 — 최고관리자와 같은 권한(최고관리자 본 계정이 지정: role totalMaster + subAdmin)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && myUser().get('role', '') == 'totalMaster' && myUser().get('subAdmin', false) == true);
    }
    // ⭐ 2026-11-05 다른 사람 계정에 최고관리자·부관리자 권한을 넣는 것은 최고관리자만(직원이 직원에게 올려 주던 구멍 막음)
    function roleEscalationOk() {
      return isTotalMasterUser() || (
        (request.resource.data.get('role', '') != 'totalMaster'
          || (resource != null && resource.data.get('role', '') == 'totalMaster'))
        && request.resource.data.get('subAdmin', false) == (resource == null ? false : resource.data.get('subAdmin', false)));
    }
    function isCompanyAdmin(company) {
      return isSuperEmail() || myUser().get('role', '') == 'totalMaster' ||
        ((myUser().get('role', '') in ['admin', 'allMgr', 'hrManager', 'hrAcct'] || isExecRoleUser()) && myUser().get('companyName', '') == company);
    }
    // 👔 2026-10-31 권한 관리에서 "임원 화면"으로 정한 역할(직접 만든 역할) — 이름에 '임원'이 들어가고 화면 설정이 없으면 임원으로 본다
    // ⭐ 2026-11-02 점검 — 운송사별 권한(companyRoleOverrides/{회사}.roles)에서 만든 역할·"임원 화면" 지정도 임원으로 본다
    //  (화면의 mergeCompanyRoles + roleScreen과 같은 순서: 회사 설정 값이 공통 역할 값을 덮어쓴다)
    function isExecRoleUser() {
      let r = myUser().get('role', '');
      let p = /databases/$(database)/documents/customRoles/$(r);
      let ov = /databases/$(database)/documents/companyRoleOverrides/$(myUser().get('companyName', ''));
      let g = exists(p) ? get(p).data : {};
      let o = exists(ov) ? get(ov).data.get('roles', {}).get(r, {}) : {};
      let scr = ('screen' in o) ? o.get('screen', null) : g.get('screen', null);
      let lbl = o.get('label', '') != '' ? o.get('label', '') : (g.get('label', '') != '' ? g.get('label', '') : r);
      // ⭐ 2026-11-04 새 기본 역할(통합관리자·사무원·법무·개발)은 임원 역할이 아니다
      return r != '' && !(r in ['admin', 'allMgr', 'hrManager', 'hrAcct', 'hrStaff', 'user', 'test', 'acctStaff', 'legalMgr', 'legalStaff', 'devMgr', 'devStaff', 'viewer', 'totalMaster', 'driver', 'shipper'])
        && (exists(p) || o.size() > 0)
        && (scr is string ? scr == 'exec' : string(lbl).matches('.*임원.*'));
    }
    // 💼 2026-11-01 경리(test)는 회사 결재 중 지출결의·근태(연차)·보고(사직서)만 읽는다 — 장부 가져오기·퇴직 정산·연차 계산
    function isAcctApprovalReader(d) {
      return myUser().get('role', '') in ['test', 'acctStaff'] && myUser().get('companyName', '') == d.get('company', '')
        && d.get('cat', '') in ['expense', 'leave', 'report'];
    }
    function isExecUser() {
      return myUser().get('position', '') in ['이사', '상무', '전무', '부사장', '사장', '대표', '대표이사', '본부장', '임원'];
    }
    // ⭐ 2026-11-02 점검 — 결재 문서 수정 규칙 보조 함수(바뀐 필드 / 기안자의 결재 취소 요청 형식 확인)
    function apAff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // 결재 취소 요청 — 승인된 문서에만, 처음 결재자부터 같은 인원으로 시작해야 한다(기안자가 자기 혼자 취소 결재선을 만드는 것 방지)
    function apCancelReqOk() {
      return resource.data.get('status', '') == 'approved'
        && resource.data.get('cancel', {}).get('status', '') != 'pending'
        && request.resource.data.cancel.get('status', '') == 'pending'
        && request.resource.data.cancel.get('step', -1) == 0
        && request.resource.data.cancel.line.size() == resource.data.line.size()
        && request.resource.data.cancel.line[0].uid == resource.data.line[0].uid;
    }
    // ⭐ 2026-11-02 점검 — 결재 설정(approvalSettings/{회사}) 전용 규칙: 관리자·임원만 설정을 바꾸고,
    //  일반 직원은 본인 자동 승인 항목만(임원 표시 exec:true·임원 직책은 못 넣음). 일일업무일지 자동 승인은 임원·관리자만
    function isExecProfileUser() {
      return isExecUser() || myUser().get('team', '') == '임원' || isExecRoleUser();
    }
    function approvalSettingsWriteOk(co) {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      let entry = after.get('autoApprovers', {}).get(request.auth.uid, {});
      return isCompanyAdmin(co) || (co == myCo()
        && after.get('autoApprovers', {}).diff(before.get('autoApprovers', {})).affectedKeys().hasOnly([request.auth.uid])
        && ((isExecProfileUser()
              && after.diff(before).affectedKeys().hasOnly(['autoApprovers', 'companyName', 'autoApproveDaily', 'updatedBy', 'updatedAt']))
          || (after.diff(before).affectedKeys().hasOnly(['autoApprovers', 'companyName'])
              && entry.get('exec', false) != true
              && !(entry.get('position', '') is string && entry.get('position', '').trim() in ['이사', '상무', '전무', '부사장', '사장', '대표', '대표이사', '본부장', '임원']))));
    }
    match /approvalSettings/{co} {
      allow read: if coMatch(resource.data);
      allow create: if coCreate() && approvalSettingsWriteOk(co);
      allow update: if coMatch(resource.data) && coKeep() && approvalSettingsWriteOk(co);
      allow delete: if coMatch(resource.data) && isCompanyAdmin(co);
    }
    match /approvals/{id} {
      allow read: if isApproved() && (isTotalMasterUser() || !locked() || resource.data.companyName == myCo())
        && (request.auth.uid in resource.data.get('participants', []) || isCompanyAdmin(resource.data.get('company', '')) || isAcctApprovalReader(resource.data));
      // ⭐ 2026-11-02 점검 — HOME › 직원 일정(ExecSuite TeamSchedule)은 회사의 연차(cat=="leave") 결재만 조회 → 같은 회사 직원(기사·화주 제외)은 읽기 허용
      //  (조회는 company == 우리 회사 + cat == "leave" 조건으로 보내야 한다)
      allow read: if isOfficeStaff() && resource.data.get('cat', '') == 'leave' && resource.data.get('company', '') == myCo();
      allow create: if coCreate() && request.resource.data.get('drafterUid', '') == request.auth.uid
        && (request.resource.data.get('status', '') == 'pending'
          // 일일 업무일지 자동 승인 — 회사 결재 설정(approvalSettings/{회사}.autoApproveDaily)이 켜져 있을 때만
          || (request.resource.data.get('status', '') == 'approved' && request.resource.data.get('form', '') == 'daily'
              && request.resource.data.get('autoApproved', false) == true
              && exists(/databases/$(database)/documents/approvalSettings/$(request.resource.data.get('company', '')))
              && get(/databases/$(database)/documents/approvalSettings/$(request.resource.data.get('company', ''))).data.get('autoApproveDaily', false) == true))
        && request.auth.uid in request.resource.data.get('participants', []);
      // 기안자·참여자 수정 — 기안자·참여자 목록과 회사는 못 바꾼다(결재 진행·회수·의견·읽음)
      // ⭐ 2026-11-02 점검 — 참조자·기안자가 status/line을 직접 바꿔 스스로 최종 승인하던 문제:
      //  읽음·의견·보관함 표시는 참여자 누구나, 결재선(line/step)·승인은 "지금 내 차례"인 결재자만,
      //  결재 취소 진행은 취소 결재선의 내 차례만, 기안자는 대기 중 수정·회수·결재 취소 요청만
      allow update: if isApproved() && request.auth.uid in resource.data.get('participants', [])
        && request.resource.data.get('drafterUid', '') == resource.data.get('drafterUid', '')
        && request.resource.data.get('participants', []) == resource.data.get('participants', [])
        && request.resource.data.get('company', '') == resource.data.get('company', '')
        && (apAff().hasOnly(['ccReadBy', 'seenBy', 'drafterUnread', 'history', 'updatedAt', 'hiddenBy'])
          || (resource.data.get('status', '') == 'pending' && resource.data.line[resource.data.get('step', 0)].uid == request.auth.uid)
          || (resource.data.get('cancel', {}).get('status', '') == 'pending'
              && resource.data.cancel.line[resource.data.cancel.get('step', 0)].uid == request.auth.uid)
          || (resource.data.drafterUid == request.auth.uid
              && !apAff().hasAny(['line', 'step'])
              && (request.resource.data.get('status', '') == resource.data.get('status', '')
                || (resource.data.get('status', '') == 'pending' && request.resource.data.get('status', '') == 'withdrawn'))
              // 승인 뒤에는 내용(금액 등)을 못 고친다 — 읽음·의견·결재 취소 요청만
              && (resource.data.get('status', '') == 'pending'
                || apAff().hasOnly(['ccReadBy', 'seenBy', 'drafterUnread', 'history', 'updatedAt', 'hiddenBy', 'cancel']))
              && (!apAff().hasAny(['cancel']) || apCancelReqOk())));
      // 회사 관리자(결재함 › 회사 전체)는 참여자가 아니어도 "내 보관함에서 삭제/되돌리기"(hiddenBy)만 바꿀 수 있다
      allow update: if isApproved() && isCompanyAdmin(resource.data.get('company', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy']);
      // ⭐ 2026-11-04 전자결재 서명 — 지출결의 지급완료(paid) 처리·취소
      //  최종 승인된 비용·지출 결의(cat expense)만, 바꿀 수 있는 칸은 paid·history·updatedAt·drafterUnread 뿐.
      //  누를 수 있는 사람: 같은 회사의 역할 test(경리)·hrAcct·admin·totalMaster, 부서 이름에 재무·경리·회계가 든 직원, 또는 그 문서의 최종 결재자
      //  (Approval.jsx canPay와 같은 조건 — 결재 취소 진행 중에는 안 됨)
      allow update: if isApproved()
        && resource.data.get('status', '') == 'approved'
        && resource.data.get('cat', '') == 'expense'
        && resource.data.get('cancel', {}).get('status', '') != 'pending'
        && apAff().hasOnly(['paid', 'history', 'updatedAt', 'drafterUnread'])
        && (((myUser().get('role', '') in ['test', 'acctStaff', 'hrAcct', 'allMgr', 'admin', 'totalMaster'] || myUser().get('team', '').matches('.*(재무|경리|회계|총무).*'))
              && (myUser().get('companyName', '') == resource.data.get('company', '') || isTotalMasterUser()))
          || resource.data.line[resource.data.line.size() - 1].uid == request.auth.uid);
      allow delete: if false;
    }

    // 🗂 사내 게시판(자유·관리자·임원) — 볼 수 있는 사람만 읽고 쓴다
    // 임원게시판은 권한(임원 기준)을 정하기 전까지 최고관리자만
    function canSeeBoard(b) {
      return b == 'free' || isSuperEmail() || myUser().get('role', '') == 'totalMaster'
        || (b == 'admin' && (myUser().get('role', '') in ['admin', 'allMgr', 'hrManager', 'hrAcct'] || isExecRoleUser()));
    }
    function isBoardAdmin() {
      return isSuperEmail() || myUser().get('role', '') in ['admin', 'allMgr', 'totalMaster', 'hrManager', 'hrAcct'];
    }
    // ⭐ 2026-11-03 공지 작성 권한 — 회사 마스터가 정함(companySettings/{회사}.noticeWriters: admin | exec | all)
    function noticePolicy() {
      return exists(/databases/$(database)/documents/companySettings/$(myCo()))
        ? get(/databases/$(database)/documents/companySettings/$(myCo())).data.get('noticeWriters', 'admin') : 'admin';
    }
    function canPostNotice() {
      return isBoardAdmin() || (isApproved() && !(myUser().get('role', '') in ['viewer', 'driver', 'shipper', 'cafeUser']) && (
        myUser().get('isMaster', false) == true || noticePolicy() == 'all' || (noticePolicy() == 'exec' && myUser().get('team', '') == '임원')));
    }
    // 💬 2026-11-03 댓글·좋아요(공지·게시판 공용, 문서 안 배열)
    //  likes: 내 uid 하나만 넣거나 뺄 수 있다(남의 좋아요는 못 건드림) · comments: 500개까지
    //  (댓글 하나하나의 "본인만 수정" 은 배열이라 규칙으로 가르기 어려워 화면에서 막는다 — 같은 회사 직원만 쓸 수 있음)
    function likesOnlyMine() {
      let before = resource.data.get('likes', []).toSet();
      let after = request.resource.data.get('likes', []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) && before.difference(after).hasOnly([request.auth.uid]);
    }
    function commentsOk() {
      return request.resource.data.get('comments', []) is list && request.resource.data.get('comments', []).size() <= 500;
    }
    function canTalkUser() {
      return isTotalMasterUser() || !(myUser().get('role', '') in ['viewer', 'driver', 'shipper', 'cafeUser']);
    }
    // 📢 공지사항 — 누구나 읽고, 쓰기·수정·삭제는 관리자(관리자·인사관리자·최고관리자)만
    //  🔒 2026-11-03 지정 공지(teams·targetUids) 비공개는 화면(notifyCore.canSeeTargetedNotice)과 서버 푸시에서 지킨다.
    //   보안규칙은 "조회 결과를 걸러 주지 않는" 구조라, 여기서 막으면 공지 목록 조회 전체가 거부된다(지정 공지가 하나라도 섞이면).
    match /notices/{id} {
      // 🔒 같은 운송사 공지만 · 화주사는 화주 대상 공지만
      allow read: if coMatch(resource.data) || (isApproved() && isShipperUser() && resource.data.get('audience', '') in ['shipper', 'all'])
        // ⭐ 2026-11-03 기사 대상 공지(audiences에 driver) — 같은 회사 기사(승인된 계정)도 읽는다
        || (isApproved() && myUser().get('role', '') == 'driver' && 'driver' in resource.data.get('audiences', []) && resource.data.get('companyName', '') == myCo());
      allow create: if coCreate() && canPostNotice();
      // 수정·삭제는 작성자 본인만(최고관리자 예외). 작성자 기록이 없는 옛 공지는 공지 작성 권한자가 관리
      allow update, delete: if coMatch(resource.data) && canPostNotice()
        && (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('authorUid', '') == ''
            || isSuperEmail() || myUser().get('role', '') == 'totalMaster');
      // ⭐ 2026-11-04 관리자·마스터는 같은 회사 공지(임원이 올린 것 포함)를 삭제할 수 있다(수정은 작성자만)
      allow delete: if coMatch(resource.data) && isApproved()
        && (myUser().get('role', '') in ['admin', 'allMgr'] || myUser().get('isMaster', false) == true);
      // 읽음 표시는 같은 회사 직원 누구나
      allow update: if coMatch(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      // 💬 댓글·좋아요는 같은 회사 직원(조회전용·기사·화주 제외)
      allow update: if coMatch(resource.data) && canTalkUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'likes', 'readBy'])
        && likesOnlyMine() && commentsOk();
    }
    // 📋 인수인계 — 받는 사람의 "확인"(readBy)은 누구나, 내용 수정·삭제는 작성자 본인만(최고관리자 예외)
    match /handovers/{id} {
      allow read: if coMatch(resource.data);
      allow create: if coCreate();
      allow update: if coMatch(resource.data) && (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('authorUid', '') == ''
        || isSuperEmail() || myUser().get('role', '') == 'totalMaster'
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if coMatch(resource.data) && (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('authorUid', '') == ''
        || isSuperEmail() || myUser().get('role', '') == 'totalMaster');
    }
    match /boardPosts/{id} {
      allow read: if coMatch(resource.data) && canSeeBoard(resource.data.board);
      allow create: if coCreate() && request.resource.data.get('authorUid', '') == request.auth.uid && canSeeBoard(request.resource.data.get('board', ''));
      allow update: if coMatch(resource.data) && canSeeBoard(resource.data.board)
        && request.resource.data.get('board', '') == resource.data.board
        && (resource.data.get('authorUid', '') == request.auth.uid || isBoardAdmin()
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'comments', 'likes'])
                && likesOnlyMine() && commentsOk()));
      // 삭제는 작성자 본인만(최고관리자는 운영상 예외)
      allow delete: if coMatch(resource.data) && canSeeBoard(resource.data.board) && (resource.data.get('authorUid', '') == request.auth.uid || isSuperEmail() || myUser().get('role', '') == 'totalMaster');
    }
    match /sessionLogs/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isApproved();
    }

    // ────────────────────────────────────────────────────────────
    // 그 외 모든 컬렉션 — 승인된 계정만 접근 가능
    // (운송사/화주사/기사 전용 화면은 전부 Firebase Auth 로그인 후에만 진입하므로
    // 기존 기능에는 영향이 없고, 로그인 없는 제3자의 접근만 차단한다)
    // ────────────────────────────────────────────────────────────
    // ⭐ 규칙은 "하나라도 허용하면 허용"이라, 서버 전용 컬렉션(초기화 비밀번호·보관함·기록)은
    // 여기서 빼야 위의 "allow … if false"가 실제로 막힌다.
    // ⭐ 개인 설정(자주 쓰는 계좌 등) — 본인만
    // 🏢 2026-11-01 운송사별 권한 설정 — 누구나(승인된 직원) 읽고, 최고관리자만 바꾼다
    match /companyRoleOverrides/{co} {
      allow read: if isApproved();
      allow write: if isTotalMasterUser();
      // ⭐ 2026-11-04 최고관리자가 "마스터 권한 관리"를 켠 회사(companyFeatures/{회사}.masterRolePerms)는 그 회사 마스터도 자기 회사 것만
      allow write: if isApproved() && myCo() == co && myUser().get('isMaster', false) == true
        && exists(/databases/$(database)/documents/companyFeatures/$(co))
        && get(/databases/$(database)/documents/companyFeatures/$(co)).data.get('masterRolePerms', false) == true
        && request.resource.data.get('companyName', co) == co;
    }
    // 공통 권한(역할별 메뉴) — 최고관리자만 바꾼다(예전엔 승인된 누구나 쓸 수 있었음)
    match /customRoles/{key} {
      allow read: if isApproved();
      allow write: if isTotalMasterUser();
    }
    match /userPrefs/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    // ⭐ 2026-11-02 원격지원 — 직원 → 최고관리자 원격 지원 요청 · 화면 공유 세션(WebRTC 신호·채팅)
    //  요청: 승인된 직원이 "내 uid · 내 회사 · 대기" 로만 만든다. 읽기는 요청한 본인과 최고관리자.
    //  본인 수정은 취소 · 원격 번호 · 화면 공유 세션 연결(in_session/done)만. 최고관리자는 모두.
    function supAff() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    match /supportRequests/{id} {
      allow create: if isApproved() && !isShipperUser()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('status', '') == 'pending';
      // ⭐ 2026-11-05 원격 지원 걸기 — 최고관리자만 다른 직원에게 "invited"(직원 응답 대기)로 만든다
      allow create: if isTotalMasterUser()
        && request.resource.data.get('status', '') == 'invited'
        && request.resource.data.get('initiatedBy', '') == 'master'
        && request.resource.data.get('uid', '') is string && request.resource.data.get('uid', '') != '';
      allow read: if isTotalMasterUser() || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid);
      allow update: if isTotalMasterUser();
      //  직원 본인: invited → approved(수락) / declined(거절) 도 할 수 있다(respondedAt 기록)
      allow update: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid
        && supAff().hasOnly(['status', 'anydeskId', 'sessionId', 'updatedAt', 'cancelledAt', 'endedAt', 'respondedAt'])
        && (request.resource.data.get('status', '') == resource.data.get('status', '')
          || (request.resource.data.get('status', '') in ['approved', 'declined'] && resource.data.get('status', '') == 'invited')
          || (request.resource.data.get('status', '') == 'cancelled' && resource.data.get('status', '') in ['pending', 'approved'])
          || (request.resource.data.get('status', '') == 'in_session' && resource.data.get('status', '') == 'approved')
          || (request.resource.data.get('status', '') == 'done' && resource.data.get('status', '') == 'in_session'));
      allow delete: if isTotalMasterUser();
    }
    //  세션: 요청한 직원(requesterUid)과 최고관리자만. 하위 컬렉션(callerCandidates · calleeCandidates · messages)도 같게.
    match /supportSessions/{sid} {
      allow create: if isApproved() && request.resource.data.get('requesterUid', '') == request.auth.uid;
      allow read: if isTotalMasterUser() || (isSignedIn() && resource.data.get('requesterUid', '') == request.auth.uid);
      allow update: if isTotalMasterUser() || (isSignedIn() && resource.data.get('requesterUid', '') == request.auth.uid
        && request.resource.data.get('requesterUid', '') == resource.data.get('requesterUid', ''));
      allow delete: if isTotalMasterUser();
      match /{sub}/{docId} {
        allow read, write: if isTotalMasterUser() || (isSignedIn()
          && get(/databases/$(database)/documents/supportSessions/$(sid)).data.get('requesterUid', '') == request.auth.uid);
      }
    }
    // ════════════════════════════════════════════════════════════
    // 💰 ⭐ 2026-11-06 직원 급여(급여 계산·명세서) · 연차 사용 촉진 — 잠금 스위치와 상관없이 항상 회사 검사
    //  수정: 경리관리자(test)·통합인사관리자(hrAcct)·통합관리자(allMgr)·회사 마스터·최고관리자 + 권한 관리에서 [급여관리] "수정"인 역할
    //  조회: 인사관리자(기본 조회 — 권한 관리에서 숨김/수정 가능)·대표(직책)·임원 화면 역할 + [급여관리] "조회"인 역할
    //  직원 본인: 발행된(published) 본인 명세서만 읽고 "읽음(readAt)"만 표시 · 본인 연차 촉진 문서에 사용 계획만 제출
    //  화면 기준은 src/payrollAccess.js(같은 판단)
    // ════════════════════════════════════════════════════════════
    function payRoleMenus() {
      let r = myUser().get('role', '');
      let p = /databases/$(database)/documents/customRoles/$(r);
      let ov = /databases/$(database)/documents/companyRoleOverrides/$(myUser().get('companyName', ''));
      let g = exists(p) ? get(p).data : {};
      let o = exists(ov) ? get(ov).data.get('roles', {}).get(r, {}) : {};
      return ('menus' in o) ? o.get('menus', {}) : g.get('menus', {});
    }
    function payFixedRole() {
      return myUser().get('role', '') in ['admin', 'user', 'viewer', 'hrManager', 'test', 'hrAcct', 'allMgr', 'totalMaster', 'driver', 'shipper', 'cafeUser'];
    }
    function payrollEditor() {
      return isTotalMasterUser() || (isApproved() && (
        myUser().get('role', '') in ['test', 'hrAcct', 'allMgr'] || myUser().get('isMaster', false) == true
        || (myUser().get('role', '') == 'hrManager' && payRoleMenus().get('급여관리', 'read') == 'write')
        || (!payFixedRole() && payRoleMenus().get('급여관리', 'hidden') == 'write')));
    }
    function payrollViewer() {
      return payrollEditor() || (isApproved() && (
        (myUser().get('role', '') == 'hrManager' && payRoleMenus().get('급여관리', 'read') != 'hidden')
        || myUser().get('position', '') in ['대표', '대표이사'] || isExecRoleUser()
        || (!payFixedRole() && payRoleMenus().get('급여관리', 'hidden') == 'read')));
    }
    // 연차 촉진 관리(발송·날짜 지정) — 인사팀(isHrStaff) + 회사 마스터
    function leaveManager() {
      return isApproved() && (isHrStaff() || myUser().get('isMaster', false) == true);
    }
    function payCo(d) {
      return isTotalMasterUser() || d.get('companyName', '') == myCo();
    }
    // 급여·연차 설정(payrollSettings/{회사}) — 요율은 급여 담당, 연차 촉진 설정(leave)은 인사 담당도
    match /payrollSettings/{co} {
      allow read: if isTotalMasterUser() || (myCo() == co && (payrollViewer() || leaveManager() || (isApproved() && myUser().get('role', '') in ['test', 'acctStaff'])));
      allow create, update: if (isTotalMasterUser() || myCo() == co) && request.resource.data.get('companyName', '') == co && (
        payrollEditor()
        || (leaveManager() && (resource == null
          ? request.resource.data.keys().hasOnly(['companyName', 'leave', 'leaveUpdatedAt', 'leaveUpdatedBy'])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'leave', 'leaveUpdatedAt', 'leaveUpdatedBy']))));
      allow delete: if isTotalMasterUser();
    }
    // 직원별 급여 설정 · 월 급여 처리(확정·발행·지급 기록)
    match /payrollEmployees/{id} {
      allow read: if (resource == null && payrollViewer()) || (payrollViewer() && payCo(resource.data));
      allow create: if payrollEditor() && payCo(request.resource.data);
      allow update: if payrollEditor() && payCo(resource.data) && request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
      allow delete: if payrollEditor() && payCo(resource.data);
    }
    match /payrollRuns/{id} {
      allow read: if (resource == null && payrollViewer()) || (payrollViewer() && payCo(resource.data));
      allow create: if payrollEditor() && payCo(request.resource.data);
      allow update: if payrollEditor() && payCo(resource.data) && request.resource.data.get('companyName', '') == resource.data.get('companyName', '');
      allow delete: if isTotalMasterUser();
    }
    // 급여명세서 — 확정(confirmed)·지급(paid)된 명세서는 금액을 못 바꾸고 상태(확정 해제·발행·지급)만
    match /payslips/{id} {
      allow read: if (resource != null && isSignedIn() && resource.data.get('uid', '') == request.auth.uid && resource.data.get('published', false) == true)
        || (resource == null && payrollViewer())
        || (payrollViewer() && payCo(resource.data));
      allow create: if payrollEditor() && payCo(request.resource.data);
      allow update: if (payrollEditor() && payCo(resource.data)
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
          && request.resource.data.get('uid', '') == resource.data.get('uid', '')
          && (resource.data.get('status', 'draft') == 'draft'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'published', 'publishedAt', 'publishedBy', 'paidAt', 'paidDate', 'updatedAt', 'updatedBy', 'unlockReason'])))
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid && resource.data.get('published', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']));
      allow delete: if payrollEditor() && payCo(resource.data) && resource.data.get('status', 'draft') == 'draft';
    }
    // 인사·급여 알림(명세서 발행 · 연차 촉진) — 받는 사람만 읽고 읽음 표시
    match /hrNotices/{id} {
      allow read: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create: if isTotalMasterUser() || (isApproved() && request.resource.data.get('companyName', '') == myCo()
        && request.resource.data.get('uid', '') is string
        && (request.resource.data.get('kind', '') == 'leavePlan' || payrollEditor() || leaveManager()));
      allow delete: if isTotalMasterUser();
    }
    // 연차 사용 촉진 기록 — log는 덧붙이기만(지우거나 고치지 못함: 법적 증빙)
    match /leavePromotions/{id} {
      allow read: if (resource != null && isSignedIn() && resource.data.get('uid', '') == request.auth.uid)
        || (resource == null && isApproved())
        || ((leaveManager() || isTotalMasterUser() || (isApproved() && myUser().get('role', '') in ['test', 'acctStaff'])) && payCo(resource.data));
      allow create: if (leaveManager() || isTotalMasterUser()) && payCo(request.resource.data);
      allow update: if ((leaveManager() || isTotalMasterUser()) && payCo(resource.data)
          && request.resource.data.get('companyName', '') == resource.data.get('companyName', '')
          && request.resource.data.get('log', []).hasAll(resource.data.get('log', [])))
        || (isSignedIn() && resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'log', 'updatedAt'])
          && request.resource.data.get('log', []).size() == resource.data.get('log', []).size() + 1
          && request.resource.data.get('log', []).hasAll(resource.data.get('log', []))
          && request.resource.data.log[request.resource.data.log.size() - 1].get('type', '') == 'plan');
      allow delete: if isTotalMasterUser();
    }
    match /{col}/{rest=**} {
      allow read, write: if isApproved() && !(col in ['adminSecrets', 'resetBackups', 'resetLogs', 'resetJobs', 'loginSessions', 'orderTrash', 'recurringRuns', 'internalMails', 'approvals', 'boardPosts', 'notices', 'handovers', 'salesQuotes', 'contracts', 'platformNotices', 'platformInvoices', 'companyPlans', 'publicPricing', 'planRequests', 'userPrefs', 'companyRoleOverrides', 'customRoles', 'supportRequests', 'supportSessions', 'driverStatements', 'fleetPenalties', 'fixedRoutes', 'routeBoards', 'personalSchedules', 'publicCompanies', 'companyContracts',
        // 🔒 회사별로 잠근 컬렉션(위에서 따로 정함)
        'orders', 'dispatch', 'dispatch_test', 'fixedClients', 'drivers', 'clients', 'places', 'recurringOrders', 'deletedOrders',
        'driver_completed_archive', 'notifications', 'schedules', 'scheduledEmails', 'emailLogs', 'hrResumes', 'attendanceRequests',
        'attendanceChangeRequests', 'acctPayments', 'approvalLines', 'acctLedger', 'acctRecurring', 'officeAssets', 'execSchedules', 'companyRules', 'hrSettings', 'retireCases', 'approvalSettings', 'acctFunds',
        // ⭐ 2026-11-02 운임규칙 · 회사별 맞춤 기능(위에서 따로 정함)
        'fareRules', 'companyFeatures', 'companySettings', 'vehicleLedger', 'vehicleLedgerFiles', 'vehicleTypes',
        // 💰 2026-11-04 플랫폼 운영 문서 — 위에서 따로 정함(예전엔 siteConfig가 이 목록에 없어 승인된 고객사 직원도 요금·관제 집계를 읽을 수 있었다)
        'siteConfig', 'platformConfig', 'platformUsage', 'usageCounters',
        // ⭐ 2026-11-05 기사 가입 처리 기록 — 위에서 따로 정함
        'driverSignupLogs',
        // ⭐ 2026-11-06 문구 편집 모드 — 위에서 따로 정함(쓰기는 최고관리자만)
        'textOverrides', 'textOverridesPublic',
        // ⭐ 2026-11-06 오더마켓 — 위에서 따로 정함(예전엔 이 목록에 없어 승인된 직원이면 누구나 게시글을 고칠 수 있었다)
        'cafeOrders', 'marketNotices',
        // 💰 2026-11-06 직원 급여 · 연차 촉진 — 위에서 따로 정함
        'payrollSettings', 'payrollEmployees', 'payrollRuns', 'payslips', 'hrNotices', 'leavePromotions',
        // 🤖 2026-11-06 AI 팀 사용 기록 — 위에서 따로 정함
        'aiTeamLogs']);
    }
  }
}
