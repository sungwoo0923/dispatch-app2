        'sheetProfiles',
        // 🧾 2026-11-07 거래명세서 단계 · 미수금 메모(arDesk) — 위 회사 데이터 규칙(companyName)에서 따로 정함
        'arDesk',
        // 🔒 2026-11-07 보안 점검 — 위에서 따로 정함(예전엔 이 목록에 없어 승인된 누구나 다른 회사 것을 읽고 썼다)
        'users', 'userProfiles', 'chat_rooms', 'chat_messages', 'chat_profiles', 'transportApplications', 'companyApplications',
        'companyEditRequests', 'inquiries', 'landingInquiries', 'shipper_orders', 'userSeenNotifs', 'userSettings', 'arPayments', 'multiRateSheets',
        'plManual', 'systemConfig', 'sessionLogs', 'shortLinks', 'driver_documents', 'driver_uploads', 'liveLocations', 'hubDevices',
        'routeCarrierSettings', 'colStyles', 'colLayouts', 'colLayoutsCompany', 'transportApplications', 'driverSignupLogs',
        'driver_logs', 'gps_tracks', 'driver_photo_logs', 'driver_notifications', 'location_change_requests', 'emergency_alerts',
        'collision_alerts', 'cargo_temp', 'cargo_camera', 'deliverySignatureHistory', 'attendance', 'holidays', 'fleet_settings', 'importBatches',
        //  서버(Cloud Functions)만 쓰는 기록 · sheetRegistry(구글시트 주인 회사 — functions/sheetGuard.js, 화면이 쓰면 남의 시트를 가로챌 수 있다)
        'closeReports', 'contractNoticeLogs', 'fleet_late_alerts', 'geo_cache', 'dailyReportLogs', 'sheetRegistry',
        // 🏛 2026-11-07 국세청 · 기상청 · 팝빌 연동 — 위에서 따로 정함(서버만 쓴다)
        'bizStatusCache', 'bizStatusUsage', 'weatherUsage', 'weatherCache', 'companyPopbill', 'integrationConfig',
        // 💬🏦 2026-11-08 팝빌 자동화(알림톡 · 계좌조회) — 위에서 따로 정함(빠지면 승인된 직원 누구나 다른 회사 입금 · 발송 기록을 읽는다)
        'popbillSettings', 'bankSyncState', 'bankAliases', 'bankTxns', 'alimtalkLogs', 'smsLogs', 'messageUsage',
