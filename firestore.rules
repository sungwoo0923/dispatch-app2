rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ⭐ 프로그램 전역 설정(랜딩페이지 편집, 알림 문구 설정 등)은 최고관리자만
    // 읽고 쓸 수 있어야 한다 — AdminMenu.jsx의 isTotalMaster 판정 로직과 동일하게
    // (1) 고정된 총마스터 이메일이거나 (2) 본인 users 문서의 role이 "totalMaster"인
    // 경우만 인정한다. 클라이언트 쪽 isTotalMaster는 신뢰할 수 없으니(누구나 조작
    // 가능) 서버(규칙)에서 독립적으로 다시 검증한다.
    function isTotalMasterUser() {
      return isSignedIn() && (
        request.auth.token.email == "tjddnqkf@naver.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "totalMaster"
      );
    }

    // 비로그인 상태(기사)가 업로드 페이지에서 건드릴 수 있는 필드는 이 3개뿐이다.
    // 업로드토큰은 절대 포함하지 않는다 — 그건 로그인한 운송사 앱만 발급할 수 있어야
    // 링크 잠금/재발급 로직이 실제로 의미가 있다.
    function isPublicOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['attachCount', '위치공유중', '업로드잠금']);
    }

    // ────────────────────────────────────────────────────────────
    // 로그인 없이 접근하는 공개 배차/기사 관련 문서
    // (기사에게 문자/카톡으로 전달되는 인수증 업로드 링크, 통합 업로드 검색 링크)
    // ────────────────────────────────────────────────────────────
    match /orders/{id} {
      allow get: if true;
      // ⚠️ /driver-upload(DriverSearchPage)가 로그인 없이 상차일로 목록 조회를 하기 때문에
      // list는 열려 있어야 한다. 이 경로를 서버(Vercel 함수)로 옮기기 전까지는
      // "그 날짜의 전체 오더 목록이 링크 소지자에게 노출될 수 있다"는 제한된 리스크가 남는다.
      allow list: if true;
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }
    match /dispatch/{id} {
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }
    match /dispatch_test/{id} {
      allow get: if true;
      allow list, create, update, delete: if isSignedIn();
    }
    match /fixedClients/{id} {
      allow get: if true;
      allow list: if true; // /driver-upload?source=fixed 검색용
      allow update: if isSignedIn() || isPublicOrderUpdate();
      allow create, delete: if isSignedIn();
    }

    // 기사전달용 업로드 링크 단축 — /u/{code}가 로그인 없이 code로 원본
    // (오더id+토큰)을 조회해 /upload로 넘겨줘야 한다. list는 막아서 전체
    // 코드 목록이 노출되지 않게 하고, 발급(create/update)은 로그인한
    // 운송사 앱에서만 가능하게 한다.
    match /shortLinks/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 인수증/서류 첨부 — 오더 문서 id만 알면 사진을 올리고 확인·삭제(되돌리기)할 수 있어야 한다.
    // 첨부 문서 id는 추측 불가능한 Firestore 자동 id라 list를 막아도 기능에 지장이 없다.
    match /{col}/{orderId}/attachments/{attId} {
      allow get, create, delete: if true;
      allow list, update: if isSignedIn();
    }

    // 수동 업로드(오더 id 없이 들어온 기사) — 새 메타 문서 생성만 허용, 조회는 로그인 사용자만.
    match /driver_uploads/{id} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }

    // 홈페이지(랜딩페이지) 도입 문의 — 로그인 없는 방문자가 폼으로 제출만 할 수 있고,
    // 목록 조회/상태 변경은 관리자메뉴(로그인 사용자)만 가능하다.
    match /landingInquiries/{id} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }

    // 실시간 위치공유 — 업로드 페이지에서 오더 id로만 쓰고 읽는다. 전체 목록 열람은 로그인 사용자만.
    match /liveLocations/{id} {
      allow get, create, update: if true;
      allow list, delete: if isSignedIn();
    }

    // ────────────────────────────────────────────────────────────
    // 배차마당(카페형 오더 공유 사이트) — 게시글 본문은 로그인 사용자 전체 공개,
    // 연락처(전화번호)는 별도 서브문서에 두고 "배차완료" 상태에서 당사자(등록자/신청자)만
    // 읽을 수 있게 제한한다.
    // ────────────────────────────────────────────────────────────
    match /cafeOrders/{orderId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      match /contact/{docId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.status == "confirmed" &&
          (request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.posterUid ||
           request.auth.uid == get(/databases/$(database)/documents/cafeOrders/$(orderId)).data.applicantUid);
        allow write: if isSignedIn();
      }
    }

    // ────────────────────────────────────────────────────────────
    // GOM_Hour 주문페이지(gom-hour-site) — 링크로 들어온 비로그인 고객이
    // 바로 주문을 넣을 수 있어야 하므로 gomOrders는 create만 공개, 조회/수정은
    // 관리자(로그인)만. 옵션/가격/공지/픽업수량은 주문페이지가 실시간으로
    // 읽어야 하니 조회는 공개, 변경은 관리자(로그인)만 가능하다.
    // ────────────────────────────────────────────────────────────
    match /gomOrders/{orderId} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }
    match /gomOptions/{optionId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /gomSettings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /gomPickupCapacity/{date} {
      allow get, list: if true;
      // 주문 제출 시 트랜잭션으로 currentCount를 늘려야 하므로 비로그인도 써야
      // 한다. 단, 정원(maxCount)은 관리자만 정할 수 있어야 하므로:
      // - 문서가 아직 없을 때(create)는 maxCount를 반드시 null로만 만들 수 있게 하고
      // - 이미 있을 때(update)는 currentCount 외 필드는 값이 바뀌지 못하게 막는다
      //   (diff().affectedKeys()는 실제로 값이 변한 필드만 담기니, maxCount를
      //   그대로 다시 써도 걸리지 않는다).
      allow create: if isSignedIn() ||
        (request.resource.data.keys().hasOnly(['maxCount', 'currentCount']) &&
          request.resource.data.maxCount == null &&
          request.resource.data.currentCount is int);
      allow update: if isSignedIn() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentCount']);
      allow delete: if isSignedIn();
    }

    // 재료 재고 — 고객이 주문을 넣을 때 gomRecipes를 참고해 트랜잭션으로 stock을
    // 차감한다(inventoryUtil.js). 그 트랜잭션의 tx.get이 read 권한을 요구하므로
    // get은 공개하되, 전체 목록(재고 현황판)은 관리자만 볼 수 있게 list는 막는다.
    // write도 gomPickupCapacity와 같은 방식으로 stock 필드만 공개 허용한다.
    match /gomMaterials/{materialId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn() ||
        (request.resource.data.keys().hasOnly(['stock']) && request.resource.data.stock is number);
      allow update: if isSignedIn() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
      allow delete: if isSignedIn();
    }
    // 종류/옵션 → 재료 사용량 매핑. 주문 접수 시 고객 기기에서 읽어 차감량을
    // 계산해야 하므로 조회는 공개, 등록/수정은 관리자만.
    match /gomRecipes/{recipeId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    // 지출 장부 — 관리자 전용 기능이라 로그인 사용자만 접근.
    match /gomExpenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    // GOM_Hour 관리자 명단 — "가장 먼저 회원가입하는 사람이 최고관리자가 된다"
    // (AdminSignup.jsx). gomSettings/adminBootstrap 문서(claimed)가 아직 없거나
    // false일 때만 자기 자신의 gomAdmins/{uid} 문서를 만들 수 있고, 그 다음부터는
    // 이미 등록된 관리자만 새 관리자를 추가/삭제할 수 있다.
    // ⚠️ 다만 이 프로젝트는 맨 아래 기본 규칙이 "로그인만 하면 전부 읽기/쓰기
    // 허용"이라, 지금은 이 조건들이 추가로 더 막아주는 게 아니라 참고용 문서에
    // 가깝다 — 정말로 gomAdmins가 아닌 로그인 사용자를 막으려면 그 기본 규칙 자체를
    // 손봐야 한다(다른 화면들이 전부 그 규칙에 기대고 있어서 별도로 검토 필요).
    match /gomAdmins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isSignedIn();
      allow create: if request.auth != null && request.auth.uid == uid &&
        (!exists(/databases/$(database)/documents/gomSettings/adminBootstrap) ||
          get(/databases/$(database)/documents/gomSettings/adminBootstrap).data.claimed != true);
      allow update, delete: if isSignedIn() &&
        exists(/databases/$(database)/documents/gomAdmins/$(request.auth.uid));
    }
    match /gomSettings/adminBootstrap {
      allow get: if true;
      allow create, update: if request.auth != null &&
        (resource == null || resource.data.claimed != true) &&
        request.resource.data.claimed == true &&
        request.resource.data.uid == request.auth.uid;
    }

    // ────────────────────────────────────────────────────────────
    // 프로그램 전역 설정 — 최고관리자만 설정/열람 가능(요청사항).
    // 단 siteConfig/landing(로그인 전 랜딩페이지 커스터마이징)은 그 페이지 자체가
    // 로그인 없이 열리므로 읽기만은 누구나 가능해야 한다 — 그래야 방문자 화면에
    // 실제로 반영된다. 쓰기는 여기도 최고관리자만.
    // ────────────────────────────────────────────────────────────
    match /siteConfig/landing {
      allow get: if true;
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    // siteConfig/labels(프로그램 전체 편집모드의 글자 오버라이드)는 전체 사용자
    // 화면에 반영돼야 하니 읽기는 로그인한 사용자 전체 허용, 쓰기(=편집)만
    // 최고관리자로 제한한다 — landing과 같은 이유의 예외.
    match /siteConfig/labels {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isTotalMasterUser();
    }
    match /siteConfig/{docId} {
      allow get, list: if isTotalMasterUser();
      allow write: if isTotalMasterUser();
    }

    // ────────────────────────────────────────────────────────────
    // 그 외 모든 컬렉션 — 로그인한 사용자만 접근 가능
    // (운송사/화주사/기사 전용 화면은 전부 Firebase Auth 로그인 후에만 진입하므로
    // 기존 기능에는 영향이 없고, 로그인 없는 제3자의 접근만 차단한다)
    // ────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
