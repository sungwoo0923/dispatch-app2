ame":"copy_img"},{"b":[1190,261,71,36],"t0":256.36183673469384,"t1":263.15183673469386,"seg":"s11b","name":"multi_btn"},{"b":[616,331,368,238],"t0":263.35183673469385,"t1":274.8053968253968,"seg":"s11b","name":"deliv_pop"}],"caps":[{"text":"안녕하세요.","tip":false,"t0":4.28,"t1":5.42},{"text":"이번 시간엔 실시간배차현황을 같이 볼 거예요.","tip":false,"t0":5.42,"t1":9.480000000000002},{"text":"오늘 배차를 한 화면에서 쭉 보고, 기사님이 앱에서 수락했는지 거절했는지도 바로 확인하는 방법, 차근차근 알려 드릴게요.","tip":false,"t0":9.480000000000002,"t1":19.021},{"text":"F2를 누르면 실시간배차현황이 열려요.","tip":false,"t0":22.50097505668934,"t1":30.34097505668934,"seg":"s1","n":0},{"text":"[어제 · 당일 · 내일]로 날짜를 바꿔 봐요.","tip":false,"t0":30.34097505668934,"t1":33.23597505668934,"seg":"s1","n":1},{"text":"표에는 오더가 실시간으로 올라와요.","tip":false,"t0":33.815759637188215,"t1":38.15575963718822,"seg":"s2","n":0},{"text":"다른 직원이 등록 · 수정한 것도 새로고침 없이 바로 보여요.","tip":false,"t0":38.15575963718822,"t1":43.94575963718821,"seg":"s2","n":1},{"text":"기사님이 앱에서 수락하면 오른쪽 아래에 알림이 떠요.","tip":false,"t0":47.32625850340136,"t1":57.066258503401365,"seg":"s3","n":0},{"text":"[보기]를 누르면 그 오더 줄로 바로 가요.","tip":false,"t0":57.066258503401365,"t1":61.46525850340136,"seg":"s3","n":1},{"text":"거절하면 사유까지 함께 와요.","tip":false,"t0":62.045306122448984,"t1":67.30530612244898,"seg":"s4","n":0},{"text":"차량 정보는 자동으로 비워지고 배차중으로 돌아가요. 바로 다른 차를 넣으면 돼요.","tip":false,"t0":67.30530612244898,"t1":74.13130612244898,"seg":"s4","n":1},{"text":"알림은 내가 등록 · 배차한 오더만 와요. 관리자는 전체 알림을 켤 수 있어요.","tip":false,"t0":74.7117006802721,"t1":79.03170068027211,"seg":"s5","n":0},{"text":"[상차 2시간 이내 미배차] → 표 위에 따로 모이고, 누르면 펼쳐져요.","tip":false,"t0":79.03170068027211,"t1":92.31170068027211,"seg":"s5","n":1},{"text":"상차 30분 전까지 미배차면 소리로 알려 줘요.","tip":false,"t0":92.31170068027211,"t1":99.00170068027211,"seg":"s5","n":2},{"text":"알림을 닫고 하나 더","tip":false,"t0":100.18133786848072,"t1":102.90133786848072,"seg":"s5b","n":0},{"text":"표를 오른쪽으로 밀면 [첨부] 칸","tip":false,"t0":102.90133786848072,"t1":106.48133786848072,"seg":"s5b","n":1},{"text":"기사님이 앱으로 올리면 불이 들어오고 개수 표시","tip":false,"t0":106.48133786848072,"t1":112.48133786848072,"seg":"s5b","n":2},{"text":"누르면 바로 열어 봐요","tip":false,"t0":112.48133786848072,"t1":114.62133786848072,"seg":"s5b","n":3},{"text":"다시 표 앞쪽으로","tip":false,"t0":114.62133786848072,"t1":117.50133786848073,"seg":"s5b","n":4},{"text":"오더를 열지 않고 표에서 바로 배차할 수 있어요.","tip":false,"t0":120.88092970521541,"t1":128.8209297052154,"seg":"s6","n":0},{"text":"차량번호 칸에 넣고 Enter → 배차, 지우고 Enter → 취소예요.","tip":false,"t0":128.8209297052154,"t1":134.89592970521542,"seg":"s6","n":1},{"text":"처음 보는 차량번호면 확인 창이 떠요.","tip":false,"t0":135.47616780045348,"t1":139.63616780045348,"seg":"s7","n":0},{"text":"[빠른 기사 등록]을 누르면 기사관리에 바로 저장돼요.","tip":false,"t0":139.63616780045348,"t1":144.04616780045347,"seg":"s7","n":1},{"text":"앱 쓰는 지입 기사님께 배정하면 '승인대기' + 앱 알림이 가요.","tip":false,"t0":144.6262131519274,"t1":152.3462131519274,"seg":"s8","n":0},{"text":"수락 → 배차완료, 거절 → 배차중","tip":false,"t0":152.3462131519274,"t1":158.1062131519274,"seg":"s8","n":1},{"text":"차량번호를 지우면 취소 알림도 가요.","tip":false,"t0":158.1062131519274,"t1":163.0512131519274,"seg":"s8","n":2},{"text":"모든 기사님이 앱을 쓰진 않아요","tip":false,"t0":164.23090702947843,"t1":168.35090702947844,"seg":"s8b","n":0},{"text":"지입 · 직영 · 임대는 기사앱, 용차는 외부 화물 콜","tip":false,"t0":168.35090702947844,"t1":176.53090702947844,"seg":"s8b","n":1},{"text":"콜 잡은 차량번호만 표에 넣고 Enter","tip":false,"t0":176.53090702947844,"t1":181.11090702947843,"seg":"s8b","n":2},{"text":"처음 보는 차는 빠른 기사 등록 한 번 → 다음부턴 번호만","tip":false,"t0":181.11090702947843,"t1":190.62590702947844,"seg":"s8b","n":3},{"text":"오더 줄에서 마우스 오른쪽 버튼","tip":false,"t0":194.60566893424036,"t1":199.48566893424035,"seg":"s9","n":0},{"text":"메뉴가 떠요","tip":false,"t0":199.48566893424035,"t1":201.50566893424036,"seg":"s9","n":1},{"text":"맨 위 [기사복사] → 거래처에 보낼 문구로 복사","tip":false,"t0":201.50566893424036,"t1":208.68566893424037,"seg":"s9","n":2},{"text":"수정 · 운임조회 · 문자까지 · 열린 채 Delete = 삭제","tip":false,"t0":208.68566893424037,"t1":217.31566893424036,"seg":"s9","n":3},{"text":"[일괄수정·복사] → 여러 오더의 같은 칸을 한 번에 고쳐요.","tip":false,"t0":217.8959410430839,"t1":225.09594104308388,"seg":"s10","n":0},{"text":"[일괄복사] 탭 → 날짜만 바꿔 같은 오더를 한꺼번에 만들어요.","tip":false,"t0":225.09594104308388,"t1":234.3099410430839,"seg":"s10","n":1},{"text":"기사 정보를 보낼 땐 [기사복사] → 문구 형식을 골라요.","tip":false,"t0":234.8897505668934,"t1":242.06975056689342,"seg":"s11","n":0},{"text":"[계좌 이미지] · [사업자등록증]은 그림으로 복사돼 카톡에 바로 붙어요.","tip":false,"t0":242.06975056689342,"t1":251.52175056689342,"seg":"s11","n":1},{"text":"여러 건 체크 → [기사복사] → 간단 목록으로 복사","tip":false,"t0":252.10183673469388,"t1":268.64183673469387,"seg":"s11b","n":0},{"text":"'전달완료로 변경할까요?' → [변경]이면 미전달 건이 한 번에 전달완료","tip":false,"t0":268.64183673469387,"t1":274.55583673469386,"seg":"s11b","n":1},{"text":"기사앱과 실시간으로 연결돼 있어요. 새 차량은 기사관리에 바로 등록돼요.","tip":false,"t0":275.1353968253968,"t1":286.9553968253968,"seg":"s12","n":0},{"text":"지난 오더 · 월 마감은 F3 배차현황에서 이어서 봐요.","tip":false,"t0":286.9553968253968,"t1":292.6203968253968,"seg":"s12","n":1}],"cards":[{"kind":"brand","t0":0,"t1":3.4},{"kind":"intro","t0":3.4,"t1":19.370975056689343},{"kind":"chapter","n":1,"title":"화면 보기","sub":"F2 · 어제 · 당일 · 내일","t0":19.370975056689343,"t1":22.170975056689343},{"kind":"chapter","n":2,"title":"수락 · 거절 알림","sub":"기사앱에서 누르면 바로 와요","t0":44.19625850340136,"t1":46.99625850340136},{"kind":"chapter","n":3,"title":"표에서 바로 배차","sub":"차량번호 넣고 Enter","t0":117.75092970521541,"t1":120.55092970521541},{"kind":"chapter","n":4,"title":"여러 건 한 번에","sub":"오른쪽 클릭 · 일괄수정 · 기사복사","t0":191.47566893424036,"t1":194.27566893424037},{"kind":"outro","t0":293.47,"t1":313.1716099773243},{"kind":"brand","end":true,"t0":313.1716099773243,"t1":316.9716099773243}],"clicks":[{"t":125.80792970521541,"at":[800,380],"seg":"s6","kf":"cell_focus"},{"t":197.42566893424038,"at":[577.5,381],"seg":"s9","kf":"ctx"},{"t":218.83594104308392,"at":[674,840.5],"seg":"s10","kf":"bulk"},{"t":226.0359410430839,"at":[383,57],"seg":"s10","kf":"bulk_copy"},{"t":240.18975056689342,"at":