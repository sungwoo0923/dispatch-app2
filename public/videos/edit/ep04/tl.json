_one"},{"b":[336,351,168,545],"t0":131.15208616780043,"t1":140.34879818594104,"seg":"s6","name":"rec_col"},{"b":[280,230,1270,100],"t0":142.08879818594104,"t1":155.3402947845805,"seg":"s7","name":"fixed_head"},{"b":[1095,235,240,35],"t0":166.9602947845805,"t1":172.47664399092972,"seg":"s8","name":"rc_chips"},{"b":[1423,225,121,48],"t0":174.22664399092972,"t1":184.97204081632654,"seg":"s9","name":"rc_zip"},{"b":[286,215,250,679],"t0":196.00204081632654,"t1":208.52321995464854,"seg":"s10","name":"close_list"},{"b":[556,336,895,98],"t0":197.99763038548753,"t1":208.52321995464854,"seg":"s10","name":"close_steps"},{"b":[1434,223,106,52],"t0":210.31321995464853,"t1":220.8945351473923,"seg":"s11","name":"close_btn"},{"b":[1396,521,144,48],"t0":215.1174433106576,"t1":220.8945351473923,"seg":"s11","name":"cmp_btn"}],"caps":[{"text":"안녕하세요.","tip":false,"t0":4.28,"t1":5.28},{"text":"이번엔 배차현황이에요.","tip":false,"t0":5.28,"t1":7.72},{"text":"지난 오더 찾아서 고치는 법부터, 미배차, 인수증, 그리고 월 마감까지, 순서대로 같이 볼게요.","tip":false,"t0":7.72,"t1":16.198999999999998},{"text":"F3을 누르면 배차현황이 열려요. 기간 · 거래처 · 기사로 지난 오더를 찾아요.","tip":false,"t0":19.679183673469385,"t1":24.899183673469384,"seg":"s1","n":0},{"text":"기간은 최대 3개월까지 한 번에 볼 수 있어요.","tip":false,"t0":24.899183673469384,"t1":32.87418367346939,"seg":"s1","n":1},{"text":"칸 이름을 누르면 ▲오름 → ▼내림 → 해제 순서로 정렬돼요.","tip":false,"t0":33.454512471655335,"t1":43.07451247165533,"seg":"s2","n":0},{"text":"쪽을 넘길 땐 Shift + ← → 를 쓰면 빨라요.","tip":false,"t0":43.07451247165533,"t1":47.951512471655334,"seg":"s2","n":1},{"text":"오더 줄을 두 번 누르면 오른쪽에 수정 창이 열려요.","tip":false,"t0":48.531383219954655,"t1":55.31138321995466,"seg":"s3","n":0},{"text":"고치고 저장하면 끝이에요.","tip":false,"t0":55.31138321995466,"t1":57.99338321995465,"seg":"s3","n":1},{"text":"[담당자·차량 조회] → 기간 · 담당자 · 차량번호 · 기사명으로 한 번에 찾아요.","tip":false,"t0":58.57308390022676,"t1":69.11308390022675,"seg":"s4","n":0},{"text":"담당자별 건수와 운임도 함께 보여요.","tip":false,"t0":69.11308390022675,"t1":72.72208390022676,"seg":"s4","n":1},{"text":"날짜를 바꾸면 체크가 자동으로 풀려요.","tip":false,"t0":73.30238095238094,"t1":78.54238095238094,"seg":"s5","n":0},{"text":"[업로드링크] → 인수증 링크를 문자로 한 번에 보내요.","tip":false,"t0":78.54238095238094,"t1":88.84238095238095,"seg":"s5","n":1},{"text":"대용량 업로드에 차량번호까지 적으면 배차완료로 들어가요.","tip":false,"t0":88.84238095238095,"t1":98.75938095238095,"seg":"s5","n":2},{"text":"표를 오른쪽으로 밀면 [첨부] 칸","tip":false,"t0":99.93900226757368,"t1":105.23900226757368,"seg":"s5b","n":0},{"text":"기사님이 앱으로 올리면 불이 들어오고 개수 표시","tip":false,"t0":105.23900226757368,"t1":113.11900226757368,"seg":"s5b","n":1},{"text":"눌러서 바로 열어 봐요","tip":false,"t0":113.11900226757368,"t1":115.71900226757369,"seg":"s5b","n":2},{"text":"실시간배차현황도 똑같아요","tip":false,"t0":115.71900226757369,"t1":119.19200226757368,"seg":"s5b","n":3},{"text":"미배차현황에는 차가 안 잡힌 오더만 모여요.","tip":false,"t0":122.57208616780044,"t1":133.53208616780043,"seg":"s6","n":0},{"text":"[추천 기사] 칸에 같은 구간을 뛰어 본 기사님이 떠요. 고르면 바로 배차완료돼요.","tip":false,"t0":133.53208616780043,"t1":140.09908616780044,"seg":"s6","n":1},{"text":"[고정노선현황]은 구글시트 배차표와 이어져 있어요.","tip":false,"t0":140.67879818594102,"t1":147.83879818594102,"seg":"s7","n":0},{"text":"열어 두면 30초마다 양쪽이 맞춰지고, 칸을 두 번 누르면 바로 고쳐요.","tip":false,"t0":147.83879818594102,"t1":155.08979818594102,"seg":"s7","n":1},{"text":"[인수증관리]에서 기사님이 앱으로 올린 인수증 · 전표를 모아 봐요.","tip":false,"t0":158.4702947845805,"t1":166.3702947845805,"seg":"s8","n":0},{"text":"[미제출]을 누르면 인수증이 없는 오더만 남아요.","tip":false,"t0":166.3702947845805,"t1":172.2262947845805,"seg":"s8","n":1},{"text":"여러 오더를 골라 [ZIP](압축 파일)으로 받으면 오더별 폴더로 묶여 한 번에 받아져요.","tip":false,"t0":172.8066439909297,"t1":179.4466439909297,"seg":"s9","n":0},{"text":"사진 · PDF를 끌어다 놓으면 사무실에서 직접 올릴 수도 있어요.","tip":false,"t0":179.4466439909297,"t1":184.7216439909297,"seg":"s9","n":1},{"text":"월말에는 [월 마감]에서 내 거래처를 하나씩 확인해요.","tip":false,"t0":188.10204081632654,"t1":195.98204081632653,"seg":"s10","n":0},{"text":"청구운임이 비었거나 배차가 안 끝난 오더는 빨갛게 표시돼요.","tip":false,"t0":195.98204081632653,"t1":208.27304081632653,"seg":"s10","n":1},{"text":"다 확인했으면 [검증 완료] → [1차 마감]을 눌러요.","tip":false,"t0":208.85321995464852,"t1":214.97321995464853,"seg":"s11","n":0},{"text":"거래처 명세서가 있으면 [업체 명세서 비교]로 맞춰 봐요.","tip":false,"t0":214.97321995464853,"t1":220.64421995464852,"seg":"s11","n":1},{"text":"1차 마감하면 경리 정산관리에 '배차마감'으로 넘어가요.","tip":false,"t0":221.2245351473923,"t1":233.04453514739228,"seg":"s12","n":0},{"text":"최종마감된 달은 잠겨요. 고칠 땐 경리팀에 일시해제를 요청해요.","tip":false,"t0":233.04453514739228,"t1":237.3685351473923,"seg":"s12","n":1}],"cards":[{"kind":"brand","t0":0,"t1":3.4},{"kind":"intro","t0":3.4,"t1":16.549183673469386},{"kind":"chapter","n":1,"title":"찾고 고치기","sub":"F3 · 기간 조회 · 정렬 · 수정","t0":16.549183673469386,"t1":19.349183673469387},{"kind":"chapter","n":2,"title":"미배차 · 고정노선","sub":"추천 기사 · 구글시트 배차표","t0":119.44208616780044,"t1":122.24208616780044},{"kind":"chapter","n":3,"title":"인수증관리","sub":"미제출 확인 · ZIP으로 한 번에","t0":155.3402947845805,"t1":158.1402947845805},{"kind":"chapter","n":4,"title":"월 마감","sub":"검증 완료 → 1차 마감 → 정산","t0":184.97204081632654,"t1":187.77204081632655},{"kind":"outro","t0":238.2187755102041,"t1":259.11927437641725},{"kind":"brand","end":true,"t0":259.11927437641725,"t1":262.91927437641726}],"clicks":[{"t":35.75451247165533,"at":[994,416],"seg":"s2","kf":"sort1"},{"t":38.374512471655336,"at":[994,416],"seg":"s2","kf":"sort2"},{"t":40.914512471655335,"at":[994,416],"seg":"s2","kf":"sort3"},{"t":51.15138321995465,"at":[994,521],"seg":"s3","kf":"edit"},{"t":61.43308390022676,"at":[1190.5,329],"seg":"s4","kf":"lookup"},{"t":123.71208616780044,"at":[141.5,361.5],"seg":"s6","kf":"unassigned"},{"t":141.77879818594104,"at":[145,421.5],"seg":"s7","kf":"fixed"},{"t":161.1702947845805,"at":[161,480.5],"seg":"s8","kf":"receipt"},{"t":166.6502947845805,"at":[1284.5,249],"seg":"s8","kf":"rc_miss"},{"t":191.04204081632656,"at":[161,539.5],"seg":"s10","kf":"close"}],"types":[{"t":101.43900226757368},{"t":101.53900226757368},{"t":101.63900226757367},{"t":101.73900226757367},{"t":101.83900226757366},{"t":1