eg":"e2","kf":"plus1"},{"t":183.31904761904764,"c":[0,0,1600,900],"d":0.9,"seg":"e3","kf":"top2"}],"hls":[{"b":[41,206,1169,46],"t0":24.308253968253965,"t1":33.798639455782315,"seg":"a1","name":"quick"},{"b":[43,463,1165,400],"t0":47.17863945578232,"t1":52.47630385487528,"seg":"a2","name":"form"},{"b":[63,736,135,77],"t0":73.19009070294786,"t1":80.96678004535147,"seg":"b1","name":"smart"},{"b":[196,701,425,80],"t0":83.74078004535149,"t1":89.43607709750566,"seg":"b2","name":"drv_fields"},{"b":[338,534,847,80],"t0":121.46630385487528,"t1":126.76047619047618,"seg":"d1","name":"places"},{"b":[68,833,700,160],"t0":132.9404761904763,"t1":140.68691609977324,"seg":"d2","name":"memo"},{"b":[1019,691,480,763],"t0":164.9157823129252,"t1":170.21505668934242,"seg":"e1","name":"req_body"},{"b":[1326,705,155,52],"t0":174.0450566893424,"t1":183.31904761904764,"seg":"e2","name":"qty"},{"b":[1030,1322,450,40],"t0":172.63505668934243,"t1":183.31904761904764,"seg":"e2","name":"date_toggle"},{"b":[212,50,1176,812],"t0":187.69904761904763,"t1":200.01054421768708,"seg":"e3","name":"scan_dlg"},{"b":[470,450,700,90],"t0":206.95054421768708,"t1":215.6590022675737,"seg":"e4","name":"reg_days"}],"caps":[{"text":"안녕하세요.","tip":false,"t0":4.28,"t1":5.72},{"text":"이번에는 오더등록을 제대로 파 볼 거예요.","tip":false,"t0":5.72,"t1":9.520000000000001},{"text":"오더 입력하는 시간, 확 줄여 주는 숨은 기능들이 꽤 있거든요.","tip":false,"t0":9.520000000000001,"t1":14.240000000000002},{"text":"하나씩 같이 눌러 보면서 알려 드릴게요.","tip":false,"t0":14.240000000000002,"t1":17.408},{"text":"오더등록 맨 위에 [빠른 등록] 칸이 있어요.","tip":false,"t0":20.888253968253967,"t1":26.488253968253968,"seg":"a1","n":0},{"text":"Alt + Q를 누르면 바로 이 칸으로 커서가 와요.","tip":false,"t0":26.488253968253968,"t1":33.54825396825397,"seg":"a1","n":1},{"text":"날짜 · 상하차지 · 차종 · 톤수 · 화물 · 운임을 한 줄로 쓰고 Enter","tip":false,"t0":34.12863945578232,"t1":45.00863945578232,"seg":"a2","n":0},{"text":"아래 칸이 한 번에 채워져요.","tip":false,"t0":45.00863945578232,"t1":52.22663945578232,"seg":"a2","n":1},{"text":"이제 빠진 칸만 채우면 돼요.","tip":false,"t0":52.80630385487529,"t1":55.80630385487529,"seg":"a3","n":0},{"text":"거래처 칸 누르고, 몇 글자 치면 목록이 떠요.","tip":false,"t0":55.80630385487529,"t1":59.88630385487529,"seg":"a3","n":1},{"text":"골라 주면 끝이에요.","tip":false,"t0":59.88630385487529,"t1":61.88030385487529,"seg":"a3","n":2},{"text":"기사님 정보는 [스마트검색] 칸에 붙여넣으면 돼요.","tip":false,"t0":65.26009070294785,"t1":74.88009070294785,"seg":"b1","n":0},{"text":"카톡 · 문자에서 복사한 그대로, 형식은 상관없어요.","tip":false,"t0":74.88009070294785,"t1":80.71709070294786,"seg":"b1","n":1},{"text":"Enter를 누르면 차량번호 · 이름 · 전화번호가 알아서 나뉘어 들어가요.","tip":false,"t0":81.29678004535147,"t1":89.18578004535148,"seg":"b2","n":0},{"text":"처음 보는 기사님도 저장하면 기사관리에 자동 등록돼요.","tip":false,"t0":89.76607709750566,"t1":93.28607709750565,"seg":"b3","n":0},{"text":"다음부터는 검색에 바로 떠요.","tip":false,"t0":93.28607709750565,"t1":100.52607709750566,"seg":"b3","n":1},{"text":"정보가 다르면 물어보고, 시간이 겹치면 중복 배차를 막아 줘요.","tip":false,"t0":100.52607709750566,"t1":109.75607709750567,"seg":"b3","n":2},{"text":"상차지 · 하차지를 반대로 넣었다면 [상·하차 교체] 한 번이면 돼요.","tip":false,"t0":113.73630385487527,"t1":118.59630385487527,"seg":"d1","n":0},{"text":"주소 · 담당자 · 시간까지 통째로 바뀌어요.","tip":false,"t0":118.59630385487527,"t1":126.51030385487527,"seg":"d1","n":1},{"text":"메모를 ! 로 시작하면 '중요', !! 로 시작하면 '긴급'으로 저장돼요.","tip":false,"t0":127.09047619047618,"t1":131.1704761904762,"seg":"d2","n":0},{"text":"다른 직원 눈에 바로 띄어요.","tip":false,"t0":131.1704761904762,"t1":140.43647619047618,"seg":"d2","n":1},{"text":"처음 가는 상하차지 · 경유지도 저장할 때 자동 등록돼요.","tip":false,"t0":141.01691609977323,"t1":149.09691609977324,"seg":"d3","n":0},{"text":"블랙 등급 기사 경고 · 기사 메모 알림도 띄워 줘요.","tip":false,"t0":149.09691609977324,"t1":155.36591609977324,"seg":"d3","n":1},{"text":"같은 오더를 여러 대 보낼 때는","tip":false,"t0":159.34578231292517,"t1":167.36578231292518,"seg":"e1","n":0},{"text":"저장한 뒤 [배차요청장]에서 수량을 올리면 돼요.","tip":false,"t0":167.36578231292518,"t1":169.96478231292517,"seg":"e1","n":1},{"text":"최대 10건까지 한 번에 등록돼요.","tip":false,"t0":170.5450566893424,"t1":177.4450566893424,"seg":"e2","n":0},{"text":"[날짜 개별 설정]을 켜면 건마다 날짜를 다르게 줄 수 있어요.","tip":false,"t0":177.4450566893424,"t1":183.0690566893424,"seg":"e2","n":1},{"text":"카톡으로 받은 오더는 [오더스캔]에 붙여넣으세요.","tip":false,"t0":183.64904761904762,"t1":186.10904761904763,"seg":"e3","n":0},{"text":"글 · 캡처 이미지를 읽어서 칸을 채워 줘요.","tip":false,"t0":186.10904761904763,"t1":195.30904761904762,"seg":"e3","n":1},{"text":"화면 빈 곳에서 Ctrl + V만 눌러도 바로 열려요.","tip":false,"t0":195.30904761904762,"t1":199.7600476190476,"seg":"e3","n":2},{"text":"매주 반복되는 오더는 [정기오더]에 등록해 두세요.","tip":false,"t0":200.34054421768707,"t1":206.34054421768707,"seg":"e4","n":0},{"text":"요일 · 시간을 정하면 오더가 자동으로 만들어지고, 고정 기사도 같이 넣을 수 있어요.","tip":false,"t0":206.34054421768707,"t1":215.40854421768708,"seg":"e4","n":1},{"text":"기사 · 상하차지는 자동 등록되고, 앱을 쓰는 기사님께는 배차 알림이 가요.","tip":false,"t0":215.98900226757368,"t1":227.30900226757367,"seg":"e5","n":0},{"text":"수락 여부는 실시간배차현황에서, 월말 정산은 정산관리에서 이어져요.","tip":false,"t0":227.30900226757367,"t1":235.3300022675737,"seg":"e5","n":1}],"cards":[{"kind":"brand","t0":0,"t1":3.4},{"kind":"intro","t0":3.4,"t1":17.758253968253968},{"kind":"chapter","n":1,"title":"빠르게 입력하기","sub":"빠른 등록 한 줄 입력","t0":17.758253968253968,"t1":20.55825396825397},{"kind":"chapter","n":2,"title":"기사 넣기","sub":"스마트검색에 붙여넣기","t0":62.13009070294785,"t1":64.93009070294785},{"kind":"chapter","n":3,"title":"편리한 기능","sub":"상·하차 교체 · 메모 중요도 · 자동 등록","t0":110.60630385487528,"t1":113.40630385487528},{"kind":"chapter","n":4,"title":"여러 건 · 반복 오더","sub":"수량 · 오더스캔 · 정기오더","t0":156.21578231292517,"t1":159.01578231292518},{"kind":"outro","t0":236.18047619047618,"t1":257.02045351473924},{"kind":"brand","end":true,"t0":257.02045351473924,"t1":260.82045351473926}],"clicks":[{"t":36.42863945578232,"at":[650.5,229],"seg":"a2","kf":"quick_focus"},{"t":56.02630385487529,"at":[148.5,592.5],"seg":"a3","kf":"client_focus"},{"t":60.106303854875286,"at":[148.5,635],"seg":"a3","kf":"client_pick"},{"t":70.72009070294786,"at":[130.5,774.5],"seg":"b1","k