9092970523,"seg":"d1","name":"places"},{"b":[68,833,700,160],"t0":169.96399092970532,"t1":177.71043083900227,"seg":"d2","name":"memo"},{"b":[1019,691,480,763],"t0":201.1392970521542,"t1":207.3326530612245,"seg":"e1","name":"req_body"},{"b":[1326,705,155,52],"t0":211.1626530612245,"t1":220.43664399092972,"seg":"e2","name":"qty"},{"b":[1030,1322,450,40],"t0":209.75265306122452,"t1":220.43664399092972,"seg":"e2","name":"date_toggle"},{"b":[212,50,1176,812],"t0":224.81664399092972,"t1":237.12814058956917,"seg":"e3","name":"scan_dlg"},{"b":[470,450,700,90],"t0":244.06814058956917,"t1":252.77659863945578,"seg":"e4","name":"reg_days"}],"caps":[{"text":"안녕하세요.","tip":false,"t0":4.28,"t1":5.72},{"text":"이번에는 오더등록을 제대로 파 볼 거예요.","tip":false,"t0":5.72,"t1":9.520000000000001},{"text":"오더 입력하는 시간, 확 줄여 주는 숨은 기능들이 꽤 있거든요.","tip":false,"t0":9.520000000000001,"t1":14.240000000000002},{"text":"하나씩 같이 눌러 보면서 알려 드릴게요.","tip":false,"t0":14.240000000000002,"t1":17.408},{"text":"오더등록 맨 위에 [빠른 등록] 칸이 있어요.","tip":false,"t0":20.888253968253967,"t1":26.488253968253968,"seg":"a1","n":0},{"text":"Alt + Q를 누르면 바로 이 칸으로 커서가 와요.","tip":false,"t0":26.488253968253968,"t1":33.54825396825397,"seg":"a1","n":1},{"text":"날짜 · 상하차지 · 차종 · 톤수 · 화물 · 운임을 한 줄로 쓰고 Enter","tip":false,"t0":34.12863945578232,"t1":45.00863945578232,"seg":"a2","n":0},{"text":"아래 칸이 한 번에 채워져요.","tip":false,"t0":45.00863945578232,"t1":52.22663945578232,"seg":"a2","n":1},{"text":"이제 빠진 칸만 채우면 돼요.","tip":false,"t0":52.80630385487529,"t1":55.80630385487529,"seg":"a3","n":0},{"text":"거래처 칸 누르고, 몇 글자 치면 목록이 떠요.","tip":false,"t0":55.80630385487529,"t1":59.88630385487529,"seg":"a3","n":1},{"text":"골라 주면 끝이에요.","tip":false,"t0":59.88630385487529,"t1":61.88030385487529,"seg":"a3","n":2},{"text":"기사님 넣는 방법은 세 가지","tip":false,"t0":65.26009070294785,"t1":69.50009070294784,"seg":"b0","n":0},{"text":"① 차량번호 칸에 바로 입력","tip":false,"t0":69.50009070294784,"t1":72.50009070294784,"seg":"b0","n":1},{"text":"등록된 차량이면 기사명 · 전화번호가 자동으로","tip":false,"t0":72.50009070294784,"t1":78.18009070294785,"seg":"b0","n":2},{"text":"한 차에 기사님이 여럿이면 목록에서 골라요","tip":false,"t0":78.18009070294785,"t1":82.61609070294786,"seg":"b0","n":3},{"text":"② 처음 보는 차량번호 + Enter → 신규 기사 등록 창","tip":false,"t0":83.19623582766441,"t1":90.5762358276644,"seg":"b0n","n":0},{"text":"기사명 · 전화번호 넣고 저장 → 기사관리에 저장 · 오더에 바로","tip":false,"t0":90.5762358276644,"t1":99.49823582766442,"seg":"b0n","n":1},{"text":"③ 스마트검색 칸을 누르고","tip":false,"t0":100.07873015873017,"t1":103.29873015873017,"seg":"b1","n":0},{"text":"기사 정보를 그대로 붙여넣기","tip":false,"t0":103.29873015873017,"t1":107.87873015873016,"seg":"b1","n":1},{"text":"카톡 · 문자에서 복사한 그대로","tip":false,"t0":107.87873015873016,"t1":111.47873015873017,"seg":"b1","n":2},{"text":"형식은 신경 안 써도 돼요","tip":false,"t0":111.47873015873017,"t1":114.15973015873017,"seg":"b1","n":3},{"text":"Enter를 누르면 차량번호 · 이름 · 전화번호가 알아서 나뉘어 들어가요.","tip":false,"t0":114.73986394557824,"t1":122.62886394557825,"seg":"b2","n":0},{"text":"처음 보는 기사님은 저장할 때 기사관리에 자동 등록","tip":false,"t0":123.20916099773243,"t1":131.52916099773242,"seg":"b3","n":0},{"text":"다음부터는 검색하면 바로 떠요","tip":false,"t0":131.52916099773242,"t1":134.96916099773242,"seg":"b3","n":1},{"text":"정보가 다르면 물어보고 · 시간 겹치면 중복 배차 막기","tip":false,"t0":134.96916099773242,"t1":144.90016099773243,"seg":"b3","n":2},{"text":"이런 실수, 가끔 하시죠?","tip":false,"t0":148.87972789115645,"t1":151.17972789115646,"seg":"d1","n":0},{"text":"상차지 · 하차지를 거꾸로 넣은 것","tip":false,"t0":151.17972789115646,"t1":154.09972789115645,"seg":"d1","n":1},{"text":"날짜 아래 [상·하차 교체] 버튼","tip":false,"t0":154.09972789115645,"t1":158.47972789115644,"seg":"d1","n":2},{"text":"한 번 누르면 주소 · 담당자 · 시간까지 통째로 바뀌어요","tip":false,"t0":158.47972789115644,"t1":163.53372789115645,"seg":"d1","n":3},{"text":"메모를 ! 로 시작하면 '중요', !! 로 시작하면 '긴급'으로 저장돼요.","tip":false,"t0":164.1139909297052,"t1":168.19399092970522,"seg":"d2","n":0},{"text":"다른 직원 눈에 바로 띄어요.","tip":false,"t0":168.19399092970522,"t1":177.4599909297052,"seg":"d2","n":1},{"text":"처음 가는 상하차지 · 경유지도 저장할 때 자동 등록돼요.","tip":false,"t0":178.04043083900225,"t1":186.12043083900227,"seg":"d3","n":0},{"text":"블랙 등급 기사 경고 · 기사 메모 알림도 띄워 줘요.","tip":false,"t0":186.12043083900227,"t1":192.38943083900227,"seg":"d3","n":1},{"text":"같은 오더를 여러 대 보낼 땐","tip":false,"t0":196.3692970521542,"t1":203.6092970521542,"seg":"e1","n":0},{"text":"오더를 다 넣고 저장 → 배차요청장 오른쪽 위에서 건수 조절","tip":false,"t0":203.6092970521542,"t1":207.0822970521542,"seg":"e1","n":1},{"text":"최대 10건까지 한 번에 등록돼요.","tip":false,"t0":207.6626530612245,"t1":214.5626530612245,"seg":"e2","n":0},{"text":"[날짜 개별 설정]을 켜면 건마다 날짜를 다르게 줄 수 있어요.","tip":false,"t0":214.5626530612245,"t1":220.1866530612245,"seg":"e2","n":1},{"text":"카톡으로 받은 오더는 [오더스캔]에 붙여넣으세요.","tip":false,"t0":220.7666439909297,"t1":223.22664399092972,"seg":"e3","n":0},{"text":"글 · 캡처 이미지를 읽어서 칸을 채워 줘요.","tip":false,"t0":223.22664399092972,"t1":232.4266439909297,"seg":"e3","n":1},{"text":"화면 빈 곳에서 Ctrl + V만 눌러도 바로 열려요.","tip":false,"t0":232.4266439909297,"t1":236.8776439909297,"seg":"e3","n":2},{"text":"매주 반복되는 오더는 [정기오더]에 등록해 두세요.","tip":false,"t0":237.45814058956915,"t1":243.45814058956915,"seg":"e4","n":0},{"text":"요일 · 시간을 정하면 오더가 자동으로 만들어지고, 고정 기사도 같이 넣을 수 있어요.","tip":false,"t0":243.45814058956915,"t1":252.52614058956917,"seg":"e4","n":1},{"text":"기사 · 상하차지는 자동 등록되고, 앱을 쓰는 기사님께는 배차 알림이 가요.","tip":false,"t0":253.10659863945577,"t1":264.4265986394558,"seg":"e5","n":0},{"text":"수락 여부는 실시간배차현황에서, 월말 정산은 정산관리에서 이어져요.","tip":false,"t0":264.4265986394558,"t1":272.44759863945575,"seg":"e5","n":1}],"cards":[{"kind":"brand","t0":0,"t1":3.4},{"kind":"intro","t0":3.4,"t1":17.758253968253968},{"kind":"chapter","n":1,"title":"빠르게 입력하기","sub":"빠른 등록 한 줄 입력","t0":17.758253968253968,"t1":20.55825396825397},{"kind":"chapter","n":2,"title":"기사 넣기","sub":"기사 넣는 세 가지 방법","t0":62.13009070294785,"t1":64.93009070294785},{"kind":"chapter","n":3,"title":"편리한 기능","sub":"상·하차 교체 · 메모 중요도 · 자동 등록","t0":145.74972789115645,"t1":148.54972789115646},{"kind":"chapter","n":4,"title":"여러 건 · 반복 오더",